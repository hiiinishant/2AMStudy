  <!-- Toast Container -->
  <div id="toastContainer" class="toast-container"></div>

  <script>
    let allProducts = [];
    let allBlogs = [];
    let currentCategoryFilter = 'all';
    let currentBlogFilter = 'all';

    // Initialize Dashboard
    document.addEventListener('DOMContentLoaded', () => {
      loadAdminProducts();
      loadAdminBlogs();
      loadAdminStats();
      loadAdminOrders();
    });

    // Tab Switching
    function switchTab(tabId) {
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

      const targetTab = document.getElementById('tab-' + tabId);
      if (targetTab) targetTab.classList.add('active');

      const activeBtn = Array.from(document.querySelectorAll('.tab-btn')).find(b => b.getAttribute('onclick')?.includes(tabId));
      if (activeBtn) activeBtn.classList.add('active');

      if (tabId === 'hiiinishant') {
        populateHubSelect();
      }
    }

    // Show Toast
    function showToast(msg, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = `toast ${type}`;
      const icon = type === 'success' ? 'fa-circle-check' : (type === 'error' ? 'fa-circle-exclamation' : 'fa-bell');
      toast.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${msg}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(100%)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // --- PRODUCTS LOGIC ---
    async function loadAdminProducts() {
      try {
        const res = await fetch('/api/store/admin/products');
        if (res.status === 401) {
          window.location.href = '/store/admin/login';
          return;
        }
        const data = await res.json();
        if (data.success) {
          allProducts = data.products || [];
          document.getElementById('tabProductCount').textContent = allProducts.length;
          renderProductsTable();
          populateHubSelect();
        }
      } catch (err) {
        console.error(err);
      }
    }

    function setCategoryFilter(cat, btn) {
      currentCategoryFilter = cat;
      btn.parentElement.querySelectorAll('.pill-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderProductsTable();
    }

    function renderProductsTable() {
      const tbody = document.getElementById('productsTableBody');
      const search = document.getElementById('productSearchInput').value.toLowerCase().trim();

      let filtered = allProducts.filter(p => {
        const matchSearch = !search || p.name.toLowerCase().includes(search) || String(p.id).includes(search);
        const matchCat = currentCategoryFilter === 'all' || p.cat === currentCategoryFilter;
        return matchSearch && matchCat;
      });

      if (!filtered.length) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--text-muted); padding:40px;">No products found.</td></tr>`;
        return;
      }

      tbody.innerHTML = filtered.map(p => {
        const img = p.images?.[0] || '/assets/images/store/placeholder.jpg';
        let stockClass = p.stock > 5 ? 'stock-in' : (p.stock > 0 ? 'stock-low' : 'stock-out');
        let stockText = p.stock > 5 ? `${p.stock} in stock` : (p.stock > 0 ? `Low (${p.stock} left)` : 'Out of stock');

        return `
          <tr>
            <td>
              <div class="cell-info-group">
                <img src="${img}" class="product-thumb" alt="${p.name}" onerror="this.src='/assets/images/store/placeholder.jpg'">
                <div>
                  <div class="cell-title">${p.name}</div>
                  <div class="cell-sub"><span>ID: <strong>${p.id}</strong></span> • <span>${p.rating || 4.5} ⭐</span></div>
                </div>
              </div>
            </td>
            <td><span style="text-transform: capitalize; color: var(--text-muted); font-weight: 600;">${p.cat || 'General'}</span></td>
            <td><span class="price-sale">₹${p.price}</span> ${p.orig > p.price ? `<span class="price-regular">₹${p.orig}</span>` : ''}</td>
            <td>
              <div class="stock-stepper">
                <button class="stock-btn" onclick="adjustStock(${p.id}, -1)">-</button>
                <span class="stock-num" id="stock-val-${p.id}">${p.stock}</span>
                <button class="stock-btn" onclick="adjustStock(${p.id}, 1)">+</button>
              </div>
            </td>
            <td><span class="stock-badge ${stockClass}">${stockText}</span></td>
            <td style="text-align: right;">
              <div class="action-group" style="justify-content: flex-end;">
                <button class="btn btn-secondary btn-icon btn-sm" title="Copy URL for Hiii Nishant" onclick="copyProductUrl(${p.id})"><i class="fa-regular fa-copy"></i></button>
                <button class="btn btn-secondary btn-icon btn-sm" title="Edit Product" onclick="openEditProductModal(${p.id})"><i class="fa-regular fa-pen-to-square"></i></button>
                <a href="/store/product/${p.id}" target="_blank" class="btn btn-secondary btn-icon btn-sm" title="View"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                <button class="btn btn-danger btn-icon btn-sm" title="Delete" onclick="deleteProduct(${p.id})"><i class="fa-regular fa-trash-can"></i></button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    async function adjustStock(productId, delta) {
      const p = allProducts.find(prod => prod.id === productId);
      if (!p) return;
      const newStock = Math.max(0, p.stock + delta);
      p.stock = newStock;
      const el = document.getElementById(`stock-val-${productId}`);
      if (el) el.textContent = newStock;

      try {
        await fetch(`/api/store/admin/products/${productId}/stock`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ stock: newStock })
        });
        showToast(`Stock updated to ${newStock} for #${productId}`, 'success');
        loadAdminStats();
      } catch (err) {
        showToast('Error updating stock', 'error');
      }
    }

    function copyProductUrl(id) {
      const url = `https://2amstudy.com/store/product/${id}`;
      navigator.clipboard.writeText(url).then(() => showToast(`Copied: ${url}`, 'success'));
    }

    function openAddProductModal() {
      document.getElementById('modalTitle').textContent = 'Add New Product';
      document.getElementById('formProductId').value = '';
      const maxId = allProducts.reduce((max, p) => Math.max(max, p.id || 0), 100);
      document.getElementById('formId').value = maxId + 1;
      document.getElementById('formId').disabled = false;
      document.getElementById('formName').value = '';
      document.getElementById('formDesc').value = '';
      document.getElementById('formOrig').value = '';
      document.getElementById('formPrice').value = '';
      document.getElementById('formStock').value = '20';
      document.getElementById('formBadgeLabel').value = '';
      document.getElementById('formImages').value = '';
      document.getElementById('productModal').classList.add('show');
    }

    function openEditProductModal(productId) {
      const p = allProducts.find(prod => prod.id === productId);
      if (!p) return;
      document.getElementById('modalTitle').textContent = `Edit Product #${p.id}`;
      document.getElementById('formProductId').value = p.id;
      document.getElementById('formId').value = p.id;
      document.getElementById('formId').disabled = true;
      document.getElementById('formCat').value = p.cat || 'notebooks';
      document.getElementById('formName').value = p.name || '';
      document.getElementById('formDesc').value = p.desc || '';
      document.getElementById('formOrig').value = p.orig || p.price || '';
      document.getElementById('formPrice').value = p.price || '';
      document.getElementById('formStock').value = p.stock ?? 0;
      document.getElementById('formBadgeLabel').value = p.badgeLabel || '';
      document.getElementById('formImages').value = (p.images || []).join('\n');
      document.getElementById('productModal').classList.add('show');
    }

    function closeProductModal() {
      document.getElementById('productModal').classList.remove('show');
    }

    async function handleProductFormSubmit(e) {
      e.preventDefault();
      const existingId = document.getElementById('formProductId').value;
      const isEdit = !!existingId;
      const id = Number(document.getElementById('formId').value);
      const images = document.getElementById('formImages').value.split('\n').map(s => s.trim()).filter(Boolean);

      const payload = {
        id,
        name: document.getElementById('formName').value.trim(),
        cat: document.getElementById('formCat').value,
        desc: document.getElementById('formDesc').value.trim(),
        orig: Number(document.getElementById('formOrig').value) || Number(document.getElementById('formPrice').value),
        price: Number(document.getElementById('formPrice').value),
        stock: Number(document.getElementById('formStock').value) || 0,
        badgeLabel: document.getElementById('formBadgeLabel').value.trim(),
        images: images.length ? images : ['/assets/images/store/placeholder.jpg']
      };

      try {
        const res = await fetch(isEdit ? `/api/store/admin/products/${existingId}` : '/api/store/admin/products', {
          method: isEdit ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          showToast(`Product ${isEdit ? 'updated' : 'created'} successfully!`, 'success');
          closeProductModal();
          await loadAdminProducts();
          await loadAdminStats();
        }
      } catch (err) {
        showToast('Failed to save product.', 'error');
      }
    }

    async function deleteProduct(id) {
      if (!confirm(`Delete product #${id}?`)) return;
      try {
        await fetch(`/api/store/admin/products/${id}`, { method: 'DELETE' });
        showToast('Product deleted.', 'success');
        await loadAdminProducts();
        await loadAdminStats();
      } catch (e) {
        showToast('Delete failed.', 'error');
      }
    }

    // --- BLOG STUDIO LOGIC ---
    async function loadAdminBlogs() {
      try {
        const res = await fetch('/api/store/admin/blogs');
        const data = await res.json();
        if (data.success) {
          allBlogs = data.blogs || [];
          document.getElementById('tabBlogCount').textContent = allBlogs.length;
          document.getElementById('statTotalBlogs').textContent = allBlogs.filter(b => b.status === 'published').length;
          renderBlogsTable();
        }
      } catch (err) {
        console.error('Error loading blogs:', err);
      }
    }

    function setBlogFilter(filter, btn) {
      currentBlogFilter = filter;
      btn.parentElement.querySelectorAll('.pill-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderBlogsTable();
    }

    function renderBlogsTable() {
      const tbody = document.getElementById('blogsTableBody');
      const search = document.getElementById('blogSearchInput').value.toLowerCase().trim();

      let filtered = allBlogs.filter(b => {
        const matchSearch = !search || b.title.toLowerCase().includes(search) || b.slug.toLowerCase().includes(search);
        const matchStatus = currentBlogFilter === 'all' || b.status === currentBlogFilter;
        return matchSearch && matchStatus;
      });

      if (!filtered.length) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--text-muted); padding:40px;">No blog articles found.</td></tr>`;
        return;
      }

      tbody.innerHTML = filtered.map(b => {
        const img = b.image || '/assets/images/smart_study_banner.png';
        const isPub = b.status === 'published';
        return `
          <tr>
            <td>
              <div class="cell-info-group">
                <img src="${img}" class="blog-thumb" alt="${b.title}" onerror="this.src='/assets/images/smart_study_banner.png'">
                <div>
                  <div class="cell-title">${b.title}</div>
                  <div class="cell-sub"><span>/blog/<strong>${b.slug}</strong></span></div>
                </div>
              </div>
            </td>
            <td><span class="badge-tag" style="background:rgba(139,92,246,0.15); color:#c084fc;">${b.category || 'Study Tips'}</span></td>
            <td><span style="font-weight:600; color:#fff;">${b.author || 'Nishant Kumar'}</span></td>
            <td>
              <div style="font-size:12px; color:#fff;">${b.date || 'Recent'}</div>
              <div style="font-size:11px; color:var(--text-dim);">${b.views || 0} reads • ${b.readTime || '5 min'}</div>
            </td>
            <td>
              <span class="status-badge ${isPub ? 'status-published' : 'status-draft'}">
                ${isPub ? 'Published' : 'Draft'}
              </span>
            </td>
            <td style="text-align: right;">
              <div class="action-group" style="justify-content: flex-end;">
                <button class="btn btn-secondary btn-icon btn-sm" title="Copy Blog URL" onclick="copyBlogUrl('${b.slug}')"><i class="fa-regular fa-copy"></i></button>
                <button class="btn btn-secondary btn-icon btn-sm" title="Edit Article" onclick="openEditBlogModal('${b.id}')"><i class="fa-regular fa-pen-to-square"></i></button>
                <a href="/blog/${b.slug}" target="_blank" class="btn btn-secondary btn-icon btn-sm" title="View Live"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                <button class="btn btn-danger btn-icon btn-sm" title="Delete Article" onclick="deleteBlog('${b.id}')"><i class="fa-regular fa-trash-can"></i></button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    function autoGenerateSlug() {
      const existingId = document.getElementById('blogFormId').value;
      if (existingId) return; // don't overwrite on edit
      const title = document.getElementById('blogFormTitle').value;
      const slug = title.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      document.getElementById('blogFormSlug').value = slug;
    }

    function openWriteBlogModal() {
      document.getElementById('blogModalTitle').textContent = 'Write New Blog Article';
      document.getElementById('blogFormId').value = '';
      document.getElementById('blogFormTitle').value = '';
      document.getElementById('blogFormSlug').value = '';
      document.getElementById('blogFormCat').value = 'Exam Prep';
      document.getElementById('blogFormAuthor').value = 'Nishant Kumar';
      document.getElementById('blogFormReadTime').value = '5 min read';
      document.getElementById('blogFormStatus').value = 'published';
      document.getElementById('blogFormTags').value = '';
      document.getElementById('blogFormImage').value = '';
      document.getElementById('blogFormExcerpt').value = '';
      document.getElementById('blogFormContent').value = '';
      document.getElementById('blogLivePreviewBox').style.display = 'none';
      document.getElementById('previewToggleText').textContent = 'Preview Render';
      document.getElementById('blogModal').classList.add('show');
    }

    function openEditBlogModal(blogId) {
      const b = allBlogs.find(post => post.id === blogId || post.slug === blogId);
      if (!b) return;

      document.getElementById('blogModalTitle').textContent = 'Edit Blog Article';
      document.getElementById('blogFormId').value = b.id;
      document.getElementById('blogFormTitle').value = b.title || '';
      document.getElementById('blogFormSlug').value = b.slug || '';
      document.getElementById('blogFormCat').value = b.category || 'Exam Prep';
      document.getElementById('blogFormAuthor').value = b.author || 'Nishant Kumar';
      document.getElementById('blogFormReadTime').value = b.readTime || '5 min read';
      document.getElementById('blogFormStatus').value = b.status || 'published';
      document.getElementById('blogFormTags').value = Array.isArray(b.tags) ? b.tags.join(', ') : (b.tags || '');
      document.getElementById('blogFormImage').value = b.image || '';
      document.getElementById('blogFormExcerpt').value = b.excerpt || '';
      document.getElementById('blogFormContent').value = b.content || '';
      document.getElementById('blogLivePreviewBox').style.display = 'none';
      document.getElementById('previewToggleText').textContent = 'Preview Render';
      document.getElementById('blogModal').classList.add('show');
    }

    function closeBlogModal() {
      document.getElementById('blogModal').classList.remove('show');
    }

    function insertBlogTag(openTag, closeTag) {
      const txt = document.getElementById('blogFormContent');
      const start = txt.selectionStart;
      const end = txt.selectionEnd;
      const selected = txt.value.substring(start, end);
      const replacement = openTag + (selected || 'Sample Text') + closeTag;
      txt.value = txt.value.substring(0, start) + replacement + txt.value.substring(end);
      txt.focus();
      txt.setSelectionRange(start + openTag.length, start + openTag.length + (selected ? selected.length : 11));
      updateBlogLivePreview();
    }

    function toggleBlogLivePreview() {
      const box = document.getElementById('blogLivePreviewBox');
      const btn = document.getElementById('previewToggleText');
      if (box.style.display === 'block') {
        box.style.display = 'none';
        btn.textContent = 'Preview Render';
      } else {
        updateBlogLivePreview();
        box.style.display = 'block';
        btn.textContent = 'Hide Preview';
      }
    }

    function updateBlogLivePreview() {
      const content = document.getElementById('blogFormContent').value;
      const box = document.getElementById('blogLivePreviewBox');
      if (box.style.display === 'block') {
        box.innerHTML = content || '<em>Type content above to see live preview...</em>';
      }
    }

    async function handleBlogFormSubmit(e) {
      e.preventDefault();
      const existingId = document.getElementById('blogFormId').value;
      const isEdit = !!existingId;
      const saveBtn = document.getElementById('saveBlogBtn');

      saveBtn.disabled = true;
      saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';

      const payload = {
        title: document.getElementById('blogFormTitle').value.trim(),
        slug: document.getElementById('blogFormSlug').value.trim(),
        category: document.getElementById('blogFormCat').value,
        author: document.getElementById('blogFormAuthor').value.trim(),
        readTime: document.getElementById('blogFormReadTime').value.trim(),
        status: document.getElementById('blogFormStatus').value,
        tags: document.getElementById('blogFormTags').value.split(',').map(t => t.trim()).filter(Boolean),
        image: document.getElementById('blogFormImage').value.trim() || 'https://images.unsplash.com/photo-1434030216411-0b793f4b4173?w=1200&q=80',
        excerpt: document.getElementById('blogFormExcerpt').value.trim(),
        content: document.getElementById('blogFormContent').value.trim()
      };

      try {
        const res = await fetch(isEdit ? `/api/store/admin/blogs/${existingId}` : '/api/store/admin/blogs', {
          method: isEdit ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          showToast(`Article ${isEdit ? 'updated' : 'published'} successfully!`, 'success');
          closeBlogModal();
          await loadAdminBlogs();
        } else {
          showToast(data.error || 'Failed to save blog.', 'error');
        }
      } catch (err) {
        showToast('Network error while saving article.', 'error');
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Publish Article';
      }
    }

    async function deleteBlog(id) {
      if (!confirm('Are you sure you want to delete this article?')) return;
      try {
        await fetch(`/api/store/admin/blogs/${id}`, { method: 'DELETE' });
        showToast('Article deleted.', 'success');
        await loadAdminBlogs();
      } catch (e) {
        showToast('Failed to delete.', 'error');
      }
    }

    function copyBlogUrl(slug) {
      const url = `https://2amstudy.com/blog/${slug}`;
      navigator.clipboard.writeText(url).then(() => showToast(`Copied article URL: ${url}`, 'success'));
    }

    // --- STATS & ORDERS ---
    async function loadAdminStats() {
      try {
        const res = await fetch('/api/store/admin/stats');
        const data = await res.json();
        if (data.success) {
          const s = data.stats;
          document.getElementById('statTotalProducts').textContent = s.totalProducts || 0;
          document.getElementById('statInStock').textContent = s.inStockProducts || 0;
          document.getElementById('statLowStock').textContent = s.lowStockProducts || 0;
          document.getElementById('statOutOfStock').textContent = s.outOfStockProducts || 0;
        }
      } catch (err) {
        console.error(err);
      }
    }

    async function loadAdminOrders() {
      const tbody = document.getElementById('ordersTableBody');
      try {
        const res = await fetch('/api/store/admin/orders');
        const data = await res.json();
        if (data.success && data.orders && data.orders.length) {
          tbody.innerHTML = data.orders.map(o => `
            <tr>
              <td>
                <span style="font-family:'JetBrains Mono'; font-weight:700; color:#fff;">${o.invoiceNo || o.orderId}</span>
                <div style="font-size:11px; color:var(--text-dim);">${o.createdAt ? new Date(o.createdAt).toLocaleString('en-IN') : 'Recent'}</div>
              </td>
              <td>
                <div style="font-weight:700; color:#fff;">${o.customer?.name || o.customerName || 'Student'}</div>
                <div style="font-size:12px; color:var(--text-muted);">${o.customer?.email || o.customerEmail || ''}</div>
              </td>
              <td>${o.items?.length || 1} item(s)</td>
              <td><strong style="color:#10b981;">₹${o.amount || o.grandTotal || 0}</strong></td>
              <td><span style="font-family:'JetBrains Mono'; font-size:11px; color:var(--text-dim);">${o.paymentId || 'N/A'}</span></td>
              <td style="text-align: right;">
                <a href="/store/invoice/${o.orderId}" target="_blank" class="btn btn-secondary btn-sm">
                  <i class="fa-solid fa-arrow-up-right-from-square"></i> Invoice
                </a>
              </td>
            </tr>
          `).join('');
        } else {
          tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--text-muted); padding:40px;">No orders recorded yet.</td></tr>`;
        }
      } catch (err) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--danger); padding:40px;">Could not load orders.</td></tr>`;
      }
    }

    function populateHubSelect() {
      const select = document.getElementById('hubProductSelect');
      if (!select) return;
      select.innerHTML = '<option value="">-- Choose a Product --</option>' + 
        allProducts.map(p => `<option value="${p.id}">#${p.id} - ${p.name} (₹${p.price})</option>`).join('');
    }

    function updateHubPreview() {
      const select = document.getElementById('hubProductSelect');
      const container = document.getElementById('hubPreviewContainer');
      const productId = select.value;
      if (!productId) { container.style.display = 'none'; return; }
      const p = allProducts.find(prod => String(prod.id) === String(productId));
      if (!p) return;

      const url = `https://2amstudy.com/store/product/${p.id}`;
      document.getElementById('hubProductUrl').value = url;
      document.getElementById('hubApiEndpoint').textContent = `GET https://2amstudy.com/api/public/products/preview?url=${encodeURIComponent(url)}`;
      document.getElementById('hubPreviewImg').src = p.images?.[0] || '/assets/images/store/placeholder.jpg';
      document.getElementById('hubPreviewCategory').textContent = (p.cat || 'General').toUpperCase();
      document.getElementById('hubPreviewName').textContent = p.name;
      document.getElementById('hubPreviewDesc').textContent = p.desc || '';
      document.getElementById('hubPreviewSalePrice').textContent = `₹${p.price}`;
      document.getElementById('hubPreviewRegularPrice').textContent = p.orig > p.price ? `₹${p.orig}` : '';
      const disc = p.orig > p.price ? Math.round(((p.orig - p.price) / p.orig) * 100) : 0;
      document.getElementById('hubPreviewDiscount').textContent = disc > 0 ? `${disc}% OFF` : '';
      container.style.display = 'block';
    }

    function copyHubUrl() {
      const urlInput = document.getElementById('hubProductUrl');
      navigator.clipboard.writeText(urlInput.value).then(() => showToast('Link copied to clipboard!', 'success'));
    }

    async function handleLogout() {
      try {
        await fetch('/api/store/admin/logout', { method: 'POST' });
        window.location.href = '/store/admin/login';
      } catch (e) {
        window.location.href = '/store/admin/login';
      }
    }
  </script>
</body>
</html>

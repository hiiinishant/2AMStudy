<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | 2AM Study Store</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    :root {
      --bg: #0b0f19;
      --card: #111827;
      --card-border: rgba(255, 255, 255, 0.08);
      --primary: #2874f0;
      --primary-glow: rgba(40, 116, 240, 0.35);
      --accent: #ff9f00;
      --text: #f3f4f6;
      --text-muted: #9ca3af;
      --error: #ef4444;
      --success: #10b981;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      position: relative;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      top: -20%;
      left: 20%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(40, 116, 240, 0.15) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    body::after {
      content: '';
      position: fixed;
      bottom: -20%;
      right: 20%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(255, 159, 0, 0.1) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .login-container {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 440px;
    }

    .login-card {
      background: rgba(17, 24, 39, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 40px 32px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);
      text-align: center;
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      background: rgba(40, 116, 240, 0.12);
      border: 1px solid rgba(40, 116, 240, 0.3);
      border-radius: 100px;
      color: #60a5fa;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .brand-badge i { font-size: 13px; }

    .login-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 20px;
      border-radius: 16px;
      background: linear-gradient(135deg, #2874f0, #1d4ed8);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      color: #fff;
      box-shadow: 0 10px 25px var(--primary-glow);
    }

    h1 {
      font-size: 24px;
      font-weight: 800;
      color: #fff;
      margin-bottom: 8px;
      letter-spacing: -0.5px;
    }

    p.subtitle {
      color: var(--text-muted);
      font-size: 14px;
      line-height: 1.5;
      margin-bottom: 28px;
    }

    .form-group {
      text-align: left;
      margin-bottom: 20px;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #d1d5db;
      margin-bottom: 8px;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-icon {
      position: absolute;
      left: 14px;
      color: #6b7280;
      font-size: 15px;
      pointer-events: none;
      transition: color 0.2s;
    }

    input[type="password"], input[type="text"] {
      width: 100%;
      padding: 13px 44px 13px 42px;
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      font-family: inherit;
      font-size: 15px;
      color: #fff;
      outline: none;
      transition: all 0.2s;
    }

    input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(40, 116, 240, 0.2);
      background: rgba(0, 0, 0, 0.6);
    }

    input:focus + .input-icon {
      color: var(--primary);
    }

    .toggle-pwd {
      position: absolute;
      right: 14px;
      background: none;
      border: none;
      color: #6b7280;
      font-size: 15px;
      cursor: pointer;
      padding: 4px;
      transition: color 0.2s;
    }

    .toggle-pwd:hover { color: #d1d5db; }

    .btn-submit {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #2874f0, #1d4ed8);
      border: none;
      border-radius: 12px;
      color: #fff;
      font-family: inherit;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 10px 20px var(--primary-glow);
      transition: all 0.2s;
    }

    .btn-submit:hover {
      transform: translateY(-1px);
      box-shadow: 0 14px 28px var(--primary-glow);
    }

    .btn-submit:active {
      transform: translateY(0);
    }

    .btn-submit:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .alert-box {
      display: none;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 13px;
      margin-bottom: 20px;
      text-align: left;
      align-items: center;
      gap: 10px;
    }

    .alert-box.error {
      display: flex;
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
    }

    .alert-box.success {
      display: flex;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #6ee7b7;
    }

    .footer-links {
      margin-top: 24px;
      font-size: 13px;
      color: var(--text-muted);
    }

    .footer-links a {
      color: #60a5fa;
      text-decoration: none;
      transition: color 0.2s;
    }

    .footer-links a:hover { text-decoration: underline; color: #93c5fd; }
  </style>
</head>
<body>

  <div class="login-container">
    <div class="login-card">
      <div class="brand-badge">
        <i class="fa-solid fa-shield-halved"></i> 2 AM Study Store Admin
      </div>

      <div class="login-icon">
        <i class="fa-solid fa-lock"></i>
      </div>

      <h1>Admin Portal Access</h1>
      <p class="subtitle">Enter your master admin passcode to manage store products, stock inventory, and orders.</p>

      <div id="alertBox" class="alert-box">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span id="alertMsg">Invalid password</span>
      </div>

      <form id="adminLoginForm" onsubmit="handleAdminLogin(event)">
        <div class="form-group">
          <label for="adminPassword">Master Admin Password</label>
          <div class="input-wrapper">
            <i class="fa-solid fa-key input-icon"></i>
            <input type="password" id="adminPassword" placeholder="Enter admin password..." required autofocus autocomplete="current-password">
            <button type="button" class="toggle-pwd" onclick="togglePasswordVisibility()" aria-label="Toggle password visibility">
              <i class="fa-regular fa-eye" id="eyeIcon"></i>
            </button>
          </div>
        </div>

        <button type="submit" id="submitBtn" class="btn-submit">
          <span>Sign In to Dashboard</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <div class="footer-links">
        <a href="/store"><i class="fa-solid fa-arrow-left"></i> Return to Public Store</a>
      </div>
    </div>
  </div>

  <script>
    function togglePasswordVisibility() {
      const pwdInput = document.getElementById('adminPassword');
      const eyeIcon = document.getElementById('eyeIcon');
      if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
        eyeIcon.classList.remove('fa-eye');
        eyeIcon.classList.add('fa-eye-slash');
      } else {
        pwdInput.type = 'password';
        eyeIcon.classList.remove('fa-eye-slash');
        eyeIcon.classList.add('fa-eye');
      }
    }

    async function handleAdminLogin(e) {
      e.preventDefault();
      const password = document.getElementById('adminPassword').value.trim();
      const submitBtn = document.getElementById('submitBtn');
      const alertBox = document.getElementById('alertBox');
      const alertMsg = document.getElementById('alertMsg');

      if (!password) return;

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Authenticating...';
      alertBox.className = 'alert-box';

      try {
        const res = await fetch('/api/store/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password })
        });

        const data = await res.json();

        if (data.success) {
          alertBox.className = 'alert-box success';
          alertMsg.textContent = 'Authenticated successfully! Redirecting...';
          const redirectUrl = new URLSearchParams(window.location.search).get('redirect') || '/store/admin';
          setTimeout(() => {
            window.location.href = redirectUrl;
          }, 400);
        } else {
          alertBox.className = 'alert-box error';
          alertMsg.textContent = data.error || 'Invalid password. Please check and try again.';
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Sign In to Dashboard</span> <i class="fa-solid fa-arrow-right"></i>';
          document.getElementById('adminPassword').focus();
        }
      } catch (err) {
        alertBox.className = 'alert-box error';
        alertMsg.textContent = 'Network error. Please try again.';
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Sign In to Dashboard</span> <i class="fa-solid fa-arrow-right"></i>';
      }
    }
  </script>
</body>
</html>

<%- include('../partials/header') %>

<!-- Top Hero Banner (Compact & Animated with 2 AM Study) -->
<section class="hero-blog-section">
  <div class="container text-center">
    <div class="hero-blog-badge">
      <span class="pulse-dot"></span>
      <span>2 AM Study Knowledge Hub</span>
      <i class="fa-solid fa-sparkles text-primary ms-1" style="font-size: 0.8rem;"></i>
    </div>
    
    <h1 class="animated-2am-title">
      <span class="gradient-2am-text">2 AM Study</span> Blog &amp; Study Guides
    </h1>
    
    <p class="hero-blog-subtitle">
      Proven late-night routines, exam tactics, concentration techniques &amp; smart productivity guides.
    </p>
  </div>
</section>

<style>
/* Hero Section & Animations (Matches Music Page Hero) */
@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes pulseGlow {
  0%, 100% { transform: scale(1); opacity: 0.8; }
  50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 10px rgba(37, 99, 235, 0.7); }
}

.hero-blog-section {
  padding: 85px 16px 24px !important;
  background: radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.08) 0%, transparent 65%), #f8fafc;
  border-bottom: 1px solid rgba(15, 23, 42, 0.06);
}

.hero-blog-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #ffffff;
  border: 1px solid rgba(37, 99, 235, 0.2);
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.08);
  border-radius: 50px;
  padding: 5px 14px;
  font-size: 0.82rem;
  font-weight: 700;
  color: #1e40af;
  margin-bottom: 10px;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #2563eb;
  animation: pulseGlow 1.8s infinite ease-in-out;
}

.animated-2am-title {
  font-size: 2.2rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f172a;
  margin-bottom: 6px;
}

.gradient-2am-text {
  background: linear-gradient(135deg, #2563eb 0%, #7c3aed 45%, #ec4899 75%, #2563eb 100%);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: gradientShift 5s ease infinite;
}

.hero-blog-subtitle {
  font-size: 0.92rem;
  color: #64748b;
  max-width: 620px;
  margin: 0 auto;
  line-height: 1.5;
}

@media (max-width: 768px) {
  .animated-2am-title {
    font-size: 1.65rem;
  }
}

  .blog-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    align-items: center;
    padding: 1rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
    margin-bottom: 1.5rem;
  }

  .blog-search-wrap {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex: 1;
    min-width: 220px;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 12px;
    padding: 0.55rem 0.9rem;
    background: #f8fafc;
  }

  .blog-search-wrap input {
    border: none;
    background: transparent;
    outline: none;
    width: 100%;
    font-size: 0.92rem;
    color: #0f172a;
  }

  .blog-sort-select {
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 12px;
    background: #f8fafc;
    color: #334155;
    font-weight: 600;
    padding: 0.58rem 0.85rem;
    min-width: 180px;
  }

  .blog-results-count {
    font-size: 0.84rem;
    color: #64748b;
    white-space: nowrap;
    margin-left: auto;
  }

  #blogNoResults {
    display: none;
  }
</style>



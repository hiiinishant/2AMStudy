<%- include('../partials/header') %>

<!-- Top Hero Banner (Compact & Animated with 2 AM Study - Matches Music, Blog, & About) -->
<section class="hero-tools-section">
  <div class="container text-center">
    <div class="hero-tools-badge">
      <span class="pulse-dot"></span>
      <span>Productivity &amp; Academic Toolkit</span>
      <i class="fa-solid fa-graduation-cap text-primary ms-1" style="font-size: 0.85rem;"></i>
    </div>
    
    <h1 class="animated-2am-title">
      Study Tools Hub — <span class="gradient-2am-text">2 AM Study</span>
    </h1>
    
    <p class="hero-tools-subtitle">
      A complete ecosystem of student-engineered productivity engines, focus timers, memory decks &amp; habit tracking systems.
    </p>
  </div>
</section>

<style>
/* Hero Section & Animations (Matches Music & Blog Page Hero) */
@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes pulseGlow {
  0%, 100% { transform: scale(1); opacity: 0.8; }
  50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 10px rgba(37, 99, 235, 0.7); }
}

.hero-tools-section {
  padding: 85px 16px 24px !important;
  background: radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.08) 0%, transparent 65%), #f8fafc;
  border-bottom: 1px solid rgba(15, 23, 42, 0.06);
}

.hero-tools-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #ffffff;
  border: 1px solid rgba(37, 99, 235, 0.2);
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.08);
  border-radius: 50px;
  padding: 5px 14px;
  font-size: 0.82rem;
  font-weight: 700;
  color: #1e40af;
  margin-bottom: 10px;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #2563eb;
  animation: pulseGlow 1.8s infinite ease-in-out;
}

.animated-2am-title {
  font-size: 2.2rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f172a;
  margin-bottom: 6px;
}

.gradient-2am-text {
  background: linear-gradient(135deg, #2563eb 0%, #7c3aed 45%, #ec4899 75%, #2563eb 100%);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: gradientShift 5s ease infinite;
}

.hero-tools-subtitle {
  font-size: 0.92rem;
  color: #64748b;
  max-width: 660px;
  margin: 0 auto;
  line-height: 1.5;
}

@media (max-width: 768px) {
  .animated-2am-title {
    font-size: 1.65rem;
  }
}

/* Category Filter Bar */
.tool-filter-bar {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 2.5rem;
}

.tool-filter-btn {
  padding: 8px 18px;
  border-radius: 100px;
  font-size: 0.86rem;
  font-weight: 700;
  border: 1px solid #e2e8f0;
  background: #ffffff;
  color: #64748b;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.tool-filter-btn:hover {
  background: #f8fafc;
  color: #0f172a;
  border-color: #cbd5e1;
}

.tool-filter-btn.active {
  background: #2563eb;
  color: #ffffff;
  border-color: #2563eb;
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25);
}

/* Tool Cards */
.tool-card {
  background: #ffffff;
  border: 1px solid rgba(15, 23, 42, 0.08);
  border-radius: 20px;
  padding: 1.75rem;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.tool-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
  border-color: rgba(37, 99, 235, 0.3);
}

.tool-icon-box {
  width: 54px;
  height: 54px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin-bottom: 1.25rem;
  transition: transform 0.25s ease;
}

.tool-card:hover .tool-icon-box {
  transform: scale(1.08);
}
</style>

<main class="container py-5 my-0">


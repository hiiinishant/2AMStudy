    <!-- 5. Digital Clock & Focus Hub -->
    <div class="col-md-6 col-lg-4 tool-item" data-cat="focus">
      <div class="tool-card">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div class="tool-icon-box bg-info bg-opacity-10 text-info">
            <i class="fa-solid fa-clock"></i>
          </div>
          <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-2.5 py-1 fw-bold small">

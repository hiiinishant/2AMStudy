<script>
  // Category filtering
  document.querySelectorAll('.tool-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tool-filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const selected = btn.dataset.cat;
      const items = document.querySelectorAll('.tool-item');

      items.forEach(item => {
        if (selected === 'all' || item.dataset.cat === selected) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>


          </span>
        </div>
        <h5 class="fw-bold text-dark mb-1">Academic Study Notes</h5>
        <p class="text-muted small mb-4 flex-grow-1">
          Access curated lecture summaries, exam revision notes, mind maps, formula cheatsheets &amp; past question sets.
        </p>
        <a href="/notes" class="btn btn-outline-warning rounded-pill w-100 fw-bold">
          <i class="fa-solid fa-book-open me-1.5"></i> Browse Notes
        </a>
      </div>
    </div>

    <!-- 9. Student Safety Platform -->
    <div class="col-md-6 col-lg-4 tool-item" data-cat="organization">
      <div class="tool-card">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div class="tool-icon-box bg-danger bg-opacity-10 text-danger">

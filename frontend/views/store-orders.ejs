<%- include('partials/header') %>

<style>
/* 2AM Study — My Orders Page (Flipkart / Amazon Inspired) */
:root {
  --mo-bg: #f1f3f6;
  --mo-card: #ffffff;
  --mo-border: #e2e8f0;
  --mo-accent: #2874f0;
  --mo-accent-hover: #1a5dc8;
  --mo-text-dark: #0f172a;
  --mo-text-muted: #64748b;
  --mo-green: #16a34a;
  --mo-orange: #fb641b;
}

body {
  background-color: var(--mo-bg);
  color: var(--mo-text-dark);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}

.mo-main {
  padding-top: 100px;
  padding-bottom: 70px;
  min-height: calc(100vh - 120px);
}

.mo-breadcrumb {
  font-size: 0.85rem;
  color: var(--mo-text-muted);
  margin-bottom: 1.25rem;
}
.mo-breadcrumb a {
  color: var(--mo-accent);
  text-decoration: none;
}

.mo-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 24px;
}

.mo-title {
  font-size: 1.85rem;
  font-weight: 800;
  color: var(--mo-text-dark);
  letter-spacing: -0.02em;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 10px;
}

.mo-search-box {
  position: relative;
  max-width: 380px;
  width: 100%;
}
.mo-search-input {
  width: 100%;
  padding: 10px 16px 10px 40px;
  border-radius: 999px;
  border: 1.5px solid var(--mo-border);
  background: #ffffff;
  font-size: 0.9rem;
  outline: none;
  transition: all 0.2s ease;
}
.mo-search-input:focus {
  border-color: var(--mo-accent);
  box-shadow: 0 0 0 3px rgba(40, 116, 240, 0.12);
}
.mo-search-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: #94a3b8;
  font-size: 0.9rem;
}

/* Order Card */
.mo-card {
  background: var(--mo-card);
  border: 1px solid var(--mo-border);
  border-radius: 16px;
  margin-bottom: 20px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  transition: transform 0.2s, box-shadow 0.2s;
}
.mo-card:hover {
  box-shadow: 0 6px 20px rgba(0,0,0,0.06);
}

.mo-card-header {
  background: #f8fafc;
  border-bottom: 1px solid var(--mo-border);
  padding: 14px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}

.mo-card-header-left {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
}

.mo-header-meta {
  font-size: 0.82rem;
  color: var(--mo-text-muted);
}
.mo-header-meta strong {
  color: var(--mo-text-dark);
  font-weight: 700;
}

.mo-status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}
.mo-status-paid {
  background: #dcfce7;
  color: #15803d;
}
.mo-status-processing {
  background: #fef3c7;
  color: #b45309;
}

.mo-card-body {
  padding: 20px;
}

.mo-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px solid #f1f5f9;
}
.mo-item-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.mo-item-row:first-child {
  padding-top: 0;
}

.mo-item-left {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1;
  min-width: 0;
}

.mo-item-thumb {
  width: 64px;
  height: 64px;
  border-radius: 10px;
  object-fit: cover;
  background: #f8fafc;
  border: 1px solid var(--mo-border);
  flex-shrink: 0;
}

.mo-item-info {
  min-width: 0;
}
.mo-item-name {
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--mo-text-dark);
  margin-bottom: 4px;
  text-decoration: none;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.mo-item-name:hover {
  color: var(--mo-accent);
}
.mo-item-meta {
  font-size: 0.82rem;
  color: var(--mo-text-muted);
}

.mo-item-price {
  font-weight: 800;
  font-size: 1.05rem;
  color: var(--mo-text-dark);
  white-space: nowrap;
}

.mo-card-footer {
  background: #ffffff;
  border-top: 1px solid var(--mo-border);
  padding: 14px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}

.mo-delivery-info {
  font-size: 0.82rem;
  color: var(--mo-text-muted);
  display: flex;
  align-items: center;
  gap: 6px;
}

.mo-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.btn-mo-invoice {
  background: transparent;
  color: var(--mo-accent);
  border: 1.5px solid var(--mo-accent);
  border-radius: 999px;
  padding: 6px 16px;
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.btn-mo-invoice:hover {
  background: var(--mo-accent);
  color: #ffffff;
}

.btn-mo-buy {
  background: var(--mo-orange);
  color: #ffffff;
  border: none;
  border-radius: 999px;
  padding: 7px 18px;
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.btn-mo-buy:hover {
  background: #e65100;
  color: #ffffff;
}

/* Empty State */
.mo-empty-card {
  background: var(--mo-card);
  border: 1px solid var(--mo-border);
  border-radius: 20px;
  padding: 60px 24px;
  text-align: center;
}
.mo-empty-icon {
  font-size: 3.5rem;
  color: #cbd5e1;
  margin-bottom: 16px;
}
.mo-empty-title {
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--mo-text-dark);
  margin-bottom: 8px;
}
.mo-empty-desc {
  font-size: 0.95rem;
  color: var(--mo-text-muted);
  max-width: 420px;
  margin: 0 auto 24px;
  line-height: 1.55;
}

/* Loading skeleton */
.mo-skeleton {
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: moShimmer 1.5s infinite;
  border-radius: 8px;
}
@keyframes moShimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

@media (max-width: 768px) {
  .mo-main { padding-top: 80px; }
  .mo-header { flex-direction: column; align-items: stretch; }
  .mo-search-box { max-width: 100%; }
  .mo-card-header { flex-direction: column; align-items: flex-start; }
  .mo-card-footer { flex-direction: column; align-items: stretch; }
  .mo-actions { width: 100%; justify-content: space-between; }
  .mo-actions a, .mo-actions button { flex: 1; text-align: center; justify-content: center; }
}
</style>

<main class="container mo-main">
  <!-- Breadcrumb -->
  <div class="mo-breadcrumb">
    <a href="/"><i class="fa-solid fa-house me-1"></i> Home</a>
    <span class="mx-2">/</span>
    <a href="/store">Student Store</a>
    <span class="mx-2">/</span>
    <span>My Orders</span>
  </div>

  <!-- Header with search -->
  <div class="mo-header">
    <div>
      <h1 class="mo-title">
        <i class="fa-solid fa-bag-shopping text-primary"></i> My Orders
      </h1>
      <p class="text-muted small mb-0 mt-1">Track, manage and download invoices for all your past purchases.</p>
    </div>
    
    <div class="mo-search-box">
      <i class="fa-solid fa-magnifying-glass mo-search-icon"></i>
      <input type="text" id="orderSearchInput" class="mo-search-input" placeholder="Search orders by item or ID...">
    </div>
  </div>

  <!-- Orders Container -->
  <div id="ordersContainer">
    <!-- Skeleton loader shown on startup -->
    <div id="ordersSkeleton">
      <div class="mo-card p-4 mb-3">
        <div class="mo-skeleton mb-3" style="height: 24px; width: 40%;"></div>
        <div class="mo-skeleton mb-2" style="height: 60px; width: 100%;"></div>
        <div class="mo-skeleton" style="height: 20px; width: 30%;"></div>
      </div>
      <div class="mo-card p-4 mb-3">
        <div class="mo-skeleton mb-3" style="height: 24px; width: 40%;"></div>
        <div class="mo-skeleton mb-2" style="height: 60px; width: 100%;"></div>
        <div class="mo-skeleton" style="height: 20px; width: 30%;"></div>
      </div>
    </div>

    <!-- Real dynamic order cards injected here -->
    <div id="ordersList" class="d-none"></div>

    <!-- Empty State -->
    <div id="ordersEmpty" class="mo-empty-card d-none">
      <div class="mo-empty-icon">
        <i class="fa-solid fa-box-open"></i>
      </div>
      <h3 class="mo-empty-title">No Orders Placed Yet</h3>
      <p class="mo-empty-desc">You haven't ordered any study tools or accessories yet. Explore our student store to boost your daily productivity!</p>
      <a href="/store" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm">
        🛍️ Explore Student Store
      </a>
    </div>
  </div>
</main>

<!-- Firebase Auth & Orders Hydration -->
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-app.js";
  import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-auth.js";
  import { getFirestore, collection, query, where, getDocs, orderBy } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyCvJRS3UusvUrVCd2JSicBGL-uRD82GpNM",
    authDomain: "am-study-7ea87.firebaseapp.com",
    projectId: "am-study-7ea87",
    storageBucket: "am-study-7ea87.firebasestorage.app",
    messagingSenderId: "270924691236",
    appId: "1:270924691236:web:7ada12dcf50c290d0925b1"
  };

  let allOrders = [];

  function formatDate(isoStr) {
    if (!isoStr) return 'Recent Order';
    try {
      const d = new Date(isoStr);
      return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
    } catch(e) { return isoStr; }
  }

  function renderOrders(ordersToRender) {
    const skeleton = document.getElementById('ordersSkeleton');
    const list = document.getElementById('ordersList');
    const empty = document.getElementById('ordersEmpty');

    if (skeleton) skeleton.classList.add('d-none');

    if (!ordersToRender || ordersToRender.length === 0) {
      if (list) list.classList.add('d-none');
      if (empty) empty.classList.remove('d-none');
      return;
    }

    if (empty) empty.classList.add('d-none');
    if (list) {
      list.classList.remove('d-none');
      list.innerHTML = ordersToRender.map(order => {
        const orderId = order.orderId || order.id || 'N/A';
        const invoiceNo = order.invoiceNo || order.orderId || 'INV-2026';
        const dateStr = formatDate(order.createdAt);
        const customer = order.customer || {};
        const items = Array.isArray(order.items) && order.items.length > 0 ? order.items : [
          { productId: 101, name: '2AM Student Study Pack', price: order.finalTotal || 299, qty: 1, image: '/assets/images/store/placeholder.jpg' }
        ];

        const totalAmount = items.reduce((sum, i) => sum + ((Number(i.price) || 0) * (Number(i.qty) || 1)), 0);

        const itemsHtml = items.map(item => `
          <div class="mo-item-row">
            <div class="mo-item-left">
              <img src="${item.image || item.images?.[0] || '/assets/images/store/placeholder.jpg'}" alt="${item.name || 'Product'}" class="mo-item-thumb" onerror="this.src='/assets/images/store/placeholder.jpg'">
              <div class="mo-item-info">
                <a href="${item.productId ? '/store/product/' + item.productId : '/store'}" class="mo-item-name">${item.name || 'Study Essential'}</a>
                <div class="mo-item-meta">
                  Qty: <strong>${item.qty || 1}</strong> &bull; Unit Price: ₹${Number(item.price || 0).toLocaleString()}
                  ${item.variant ? ` &bull; <span class="text-muted">${item.variant}</span>` : ''}
                </div>
              </div>
            </div>
            <div class="mo-item-price">₹${(Number(item.price || 0) * Number(item.qty || 1)).toLocaleString()}</div>
          </div>
        `).join('');

        const destination = customer.city ? `${customer.city}${customer.pincode ? ' - ' + customer.pincode : ''}` : 'Delivered to your address';

        return `
          <div class="mo-card" data-order-id="${orderId.toLowerCase()}" data-search="${(orderId + ' ' + items.map(i => i.name).join(' ') + ' ' + destination).toLowerCase()}">
            <div class="mo-card-header">
              <div class="mo-card-header-left">
                <div class="mo-header-meta">
                  <span>ORDER PLACED:</span><br>
                  <strong>${dateStr}</strong>
                </div>
                <div class="mo-header-meta">
                  <span>TOTAL:</span><br>
                  <strong>₹${Number(order.finalTotal || totalAmount).toLocaleString()}</strong>
                </div>
                <div class="mo-header-meta">
                  <span>SHIP TO:</span><br>
                  <strong>${customer.name || 'Student Customer'}</strong>
                </div>
                <div class="mo-header-meta">
                  <span>INVOICE NO:</span><br>
                  <strong class="text-primary">${invoiceNo}</strong>
                </div>
              </div>
              <div>
                <span class="mo-status-badge mo-status-paid">
                  <i class="fa-solid fa-circle-check"></i> Paid & Verified
                </span>
              </div>
            </div>

            <div class="mo-card-body">
              ${itemsHtml}
            </div>

            <div class="mo-card-footer">
              <div class="mo-delivery-info">
                <i class="fa-solid fa-location-dot text-danger"></i>
                <span>Destination: <strong>${destination}</strong></span>
              </div>
              <div class="mo-actions">
                <a href="/store/invoice/${encodeURIComponent(orderId)}" class="btn-mo-invoice" target="_blank">
                  <i class="fa-solid fa-file-invoice"></i> View Invoice
                </a>
                <a href="/store" class="btn-mo-buy">
                  <i class="fa-solid fa-rotate-right"></i> Buy Again
                </a>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }
  }

  // Filter input handler
  const searchInput = document.getElementById('orderSearchInput');
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      if (!q) {
        renderOrders(allOrders);
        return;
      }
      const filtered = allOrders.filter(o => {
        const orderId = (o.orderId || o.id || '').toLowerCase();
        const itemsText = (o.items || []).map(i => i.name || '').join(' ').toLowerCase();
        const customerName = (o.customer?.name || '').toLowerCase();
        return orderId.includes(q) || itemsText.includes(q) || customerName.includes(q);
      });
      renderOrders(filtered);
    });
  }

  // Fetch orders from server + Firestore
  async function loadUserOrders(user) {
    const userEmail = user?.email || localStorage.getItem('studentEmail') || '';
    const userId = user?.uid || localStorage.getItem('user_id') || '';

    try {
      // 1. Fetch from server endpoint
      const res = await fetch(`/api/store/my-orders?email=${encodeURIComponent(userEmail)}&uid=${encodeURIComponent(userId)}`, { credentials: 'include' });
      const data = await res.json();

      if (data.success && Array.isArray(data.orders) && data.orders.length > 0) {
        allOrders = data.orders;
        renderOrders(allOrders);
        return;
      }
    } catch (err) {
      console.warn('[Orders] Server fetch fallback:', err);
    }

    // 2. Client-side Firestore query fallback if available
    try {
      if (userEmail) {
        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const q = query(collection(db, 'storeOrders'), where('customer.email', '==', userEmail));
        const snap = await getDocs(q);
        if (!snap.empty) {
          allOrders = snap.docs.map(doc => ({ id: doc.id, ...doc.data() }));
          renderOrders(allOrders);
          return;
        }
      }
    } catch(e) {
      console.warn('[Orders] Firestore fallback notice:', e);
    }

    // 3. Render empty state if no orders found
    renderOrders([]);
  }

  try {
    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    onAuthStateChanged(auth, (user) => {
      loadUserOrders(user);
    });
  } catch(e) {
    loadUserOrders(null);
  }
</script>

<%- include('partials/footer') %>

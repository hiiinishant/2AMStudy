          // Safety Case Moderate
          async function moderateCase(caseId, action) {
            const actionLabels = {
              approve: 'verify and approve',
              verify: 'verify and approve',
              resolve: 'mark as resolved',
              reject: 'reject',
              delete: 'permanently delete',
              reopen: 'reopen for review'
            };
            const label = actionLabels[action] || action;
            if (!confirm(`Are you sure you want to ${label} case #${caseId}?`)) return;

            let note = '';
            if (action === 'reject') {
              const input = prompt('Please provide a reason for rejecting this report:', 'Violates guidelines / false report');
              if (input === null) return; // user cancelled prompt
              note = input.trim() || 'Report reviewed and rejected by admin.';
            } else if (action === 'delete') {
              note = 'Case permanently deleted by admin';
            } else if (action === 'approve' || action === 'verify') {
              note = 'Verified and approved by Master Admin';
            } else if (action === 'resolve') {
              note = 'Marked as resolved by Master Admin';
            }

            try {
              const res = await fetch('/api/student-safety/admin/moderate', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json',
                  ...(getAdminHeaders())
                },
                credentials: 'include',
                body: JSON.stringify({
                  caseId,
                  action,
                  note,
                  moderatorUid: 'MASTER-ADMIN',
                  moderatorName: 'Master Admin',
                  adminPasscode: getAdminPasscode()
                })
              });
              const data = await res.json().catch(() => ({}));
              if (res.ok && data.success) {
                const actionPast = (action === 'approve' || action === 'verify') ? 'verified' : (action === 'delete' ? 'deleted' : (action === 'resolve' ? 'resolved' : 'rejected'));
                showToast(`Case #${caseId} ${actionPast} successfully!`);
                if (action === 'delete') {
                  const row = document.getElementById('safety-row-' + caseId);
                  if (row) row.remove();
                }
                setTimeout(() => {
                  window.location.hash = 'safety';
                  window.location.reload();
                }, 800);
              } else {
                showToast(data.message || data.error || 'Failed to moderate case.', true);
              }
            } catch (err) {
              showToast('Error connecting to server. Please try again.', true);
            }
          }


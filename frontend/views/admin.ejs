            if (!confirm('Are you sure you want to delete this college life video?')) return;
            try {
              const adminPass = getAdminPasscode();
              const deleteUrl = '/api/college-life/videos/' + encodeURIComponent(id) + (adminPass ? '?adminPasscode=' + encodeURIComponent(adminPass) : '');
              const res = await fetch(deleteUrl, {
                method: 'DELETE',
                headers: {
                  'Accept': 'application/json',
                  ...(getAdminHeaders())
                },
                credentials: 'include'
              });
              const data = await res.json().catch(() => ({}));
              if (res.ok && data.success) {
                const row = document.getElementById('cv-row-' + id);
                if (row) row.remove();
                showToast('Video deleted successfully.');
                setTimeout(() => {
                  window.location.hash = 'college';
                  window.location.reload();
                }, 600);
              } else {
                showToast(data.error || data.message || 'Failed to delete video.', true);
              }
            } catch (err) {
              showToast('Error deleting video.', true);
            }
          }

          async function setCollegeFeatured(id) {
            try {
              const adminPass = getAdminPasscode();
              const featureUrl = '/api/college-life/videos/' + encodeURIComponent(id) + '/feature' + (adminPass ? '?adminPasscode=' + encodeURIComponent(adminPass) : '');
              const res = await fetch(featureUrl, {
                method: 'PATCH',

          function insertCustomTable(textareaId) {
            const rowsInput = prompt('Enter number of rows (e.g. 3):', '3');
            if (!rowsInput) return;
            const colsInput = prompt('Enter number of columns (e.g. 3):', '3');
            if (!colsInput) return;

            const rows = Math.min(15, Math.max(1, parseInt(rowsInput, 10) || 3));
            const cols = Math.min(8, Math.max(1, parseInt(colsInput, 10) || 3));

            let html = `\n<div class="table-responsive my-4">\n  <table class="table table-bordered blog-custom-table">\n    <thead>\n      <tr>`;
            for (let c = 1; c <= cols; c++) {
              html += `\n        <th>Column ${c}</th>`;
            }
            html += `\n      </tr>\n    </thead>\n    <tbody>`;

            for (let r = 1; r <= rows; r++) {
              html += `\n      <tr>`;
              for (let c = 1; c <= cols; c++) {
                html += `\n        <td>Row ${r}, Col ${c}</td>`;
              }
              html += `\n      </tr>`;
            }
            html += `\n    </tbody>\n  </table>\n</div>\n`;

            insertAtCursor(textareaId, html);
            showToast(`${rows}×${cols} table inserted!`);
          }


          // Direct Clipboard Paste to Cloudinary
          function setupClipboardImagePaste(textareaId) {
            const textarea = document.getElementById(textareaId);
            if (!textarea || textarea._pasteListening) return;
            textarea._pasteListening = true;
            textarea.addEventListener('paste', async (e) => {
              const items = (e.clipboardData || window.clipboardData)?.items;
              if (!items) return;
              for (const item of items) {
                if (item.type && item.type.startsWith('image/')) {
                  e.preventDefault();
                  const file = item.getAsFile();
                  if (!file) continue;
                  const formData = new FormData();
                  formData.append('image', file);
                  showToast('Uploading pasted image to Cloudinary...');
                  try {
                    const res = await fetch('/api/store/admin/blogs/upload-image', {
                      method: 'POST',
                      credentials: 'include',
                      body: formData
                    });
                    const data = await res.json();
                    if (data.success && data.url) {
                      const figHtml = `\n\n<figure class="blog-img-box my-4 text-center">\n  <img src="${data.url}" alt="Pasted illustration" class="img-fluid rounded-4 shadow-sm" style="max-height: 520px; object-fit: cover; width: 100%;">\n</figure>\n\n`;
                      insertAtCursor(textareaId, figHtml);
                      showToast('Pasted image uploaded to Cloudinary & inserted!');
                    } else {
                      showToast(data.error || 'Failed to upload pasted image.', true);
                    }
                  } catch (err) {
                    showToast('Error uploading pasted image.', true);
                  }
                  break;
                }
              }
            });
          }


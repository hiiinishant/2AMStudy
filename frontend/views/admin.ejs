          function onBlogContentChange(contentId, statsId, previewId, readTimeId) {
            const contentEl = document.getElementById(contentId);
            if (!contentEl) return;
            const text = contentEl.value || '';

            // 1. Live Render in Preview Pane
            const previewEl = document.getElementById(previewId);
            if (previewEl) {
              previewEl.innerHTML = text.trim() ? text : '<p class="text-muted fst-italic">Start writing your article content to preview live...</p>';
            }

            // 2. Count Words & Calculate Read Time
            const plainText = text.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
            const words = plainText ? plainText.split(' ').length : 0;
            const chars = text.length;
            const readMins = Math.max(1, Math.ceil(words / 200));

            const statsEl = document.getElementById(statsId);
            if (statsEl) {
              statsEl.innerHTML = `<i class="fa-solid fa-chart-simple me-1 text-info"></i> <strong>${words}</strong> words · ~<strong>${readMins}</strong> min read · ${chars} characters`;
            }

            const readTimeEl = document.getElementById(readTimeId);
            if (readTimeEl && !readTimeEl.dataset.customized) {
              readTimeEl.value = `${readMins} min read`;
            }
          }

          function setBlogEditorView(mode, modalType) {
            const isAdd = modalType === 'add';
            const colWrite = document.getElementById(isAdd ? 'addBlogColWrite' : 'editBlogColWrite');
            const colPreview = document.getElementById(isAdd ? 'addBlogColPreview' : 'editBlogColPreview');
            const toolbar = document.getElementById(isAdd ? 'addBlogToolbar' : 'editBlogToolbar');
            const btnWrite = document.getElementById(isAdd ? 'btnAddModeWrite' : 'btnEditModeWrite');
            const btnPreview = document.getElementById(isAdd ? 'btnAddModePreview' : 'btnEditModePreview');
            const btnSplit = document.getElementById(isAdd ? 'btnAddModeSplit' : 'btnEditModeSplit');

            const contentId = isAdd ? 'blogContent' : 'editBlogContent';
            const statsId = isAdd ? 'addBlogStats' : 'editBlogStats';
            const previewId = isAdd ? 'addBlogLivePreview' : 'editBlogLivePreview';
            const readTimeId = isAdd ? 'blogReadTime' : 'editBlogReadTime';

            [btnWrite, btnPreview, btnSplit].forEach(b => { if (b) b.classList.remove('active', 'btn-primary'); });

            if (mode === 'write') {
              if (btnWrite) btnWrite.classList.add('active');
              if (toolbar) toolbar.classList.remove('d-none');
              colWrite.className = 'col-12';
              colPreview.className = 'col-12 d-none';
            } else if (mode === 'preview') {
              if (btnPreview) btnPreview.classList.add('active');
              if (toolbar) toolbar.classList.add('d-none');
              colWrite.className = 'col-12 d-none';
              colPreview.className = 'col-12';
              onBlogContentChange(contentId, statsId, previewId, readTimeId);
            } else if (mode === 'split') {
              if (btnSplit) btnSplit.classList.add('active');
              if (toolbar) toolbar.classList.remove('d-none');
              colWrite.className = 'col-lg-6';
              colPreview.className = 'col-lg-6';
              onBlogContentChange(contentId, statsId, previewId, readTimeId);
            }
          }

          function wrapText(textareaId, before, after) {
            const el = document.getElementById(textareaId);
            if (!el) return;
            const start = el.selectionStart || 0;
            const end = el.selectionEnd || 0;
            const selected = el.value.substring(start, end) || 'Sample text';
            const replacement = before + selected + after;
            el.value = el.value.substring(0, start) + replacement + el.value.substring(end);
            el.focus();
            el.selectionStart = start + before.length;
            el.selectionEnd = start + before.length + selected.length;
            triggerContentInput(textareaId);
          }

          function insertAtCursor(textareaId, text) {
            const el = document.getElementById(textareaId);
            if (!el) return;
            const start = el.selectionStart || el.value.length;
            const end = el.selectionEnd || el.value.length;
            el.value = el.value.substring(0, start) + text + el.value.substring(end);
            el.focus();
            el.selectionStart = el.selectionEnd = start + text.length;
            triggerContentInput(textareaId);
          }

          function triggerContentInput(textareaId) {
            const isAdd = textareaId === 'blogContent';
            onBlogContentChange(

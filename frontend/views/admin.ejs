        <!-- Global Toast -->
        <div class="toast-container">
          <div id="adminToast" class="toast align-items-center text-white bg-primary border-0 rounded-3 shadow-lg"
            role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
              <div class="toast-body py-2.5 px-3 fw-semibold small" id="toastMessage">Action performed successfully!
              </div>
              <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
          </div>
        </div>

        <script id="adminStoreProductsData" type="application/json"><%- JSON.stringify((typeof products !== 'undefined' && products ? products : []).reduce(function(acc, p) { acc[p.id] = p; return acc; }, {})) %></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
          function showToast(msg, isError = false) {
            const toastEl = document.getElementById('adminToast');
            const msgEl = document.getElementById('toastMessage');
            if (toastEl && msgEl) {
              msgEl.textContent = msg;
              toastEl.className = 'toast align-items-center text-white border-0 rounded-3 shadow-lg ' + (isError ? 'bg-danger' : 'bg-success');
              const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
              toast.show();
            }
          }

          function togglePassVisibility() {
            const input = document.getElementById('masterPassInput');
            const icon = document.getElementById('togglePassIcon');
            if (input.type === 'password') {
              input.type = 'text';
              icon.className = 'fa-solid fa-eye-slash';
            } else {
              input.type = 'password';
              icon.className = 'fa-solid fa-eye';
            }
          }

          function toggleMobileSidebar() {
            const sb = document.getElementById('adminSidebar');
            if (sb) sb.classList.toggle('show-mobile');
          }

          // Section Switching
          const sectionTitles = {
            live: '🔴 Live Study Manager',
            products: '🛒 Store Products & Inventory',
            orders: '📦 Customer Orders & Sales',
            blogs: '📝 Blog & Content Guides',
            safety: '🛡️ Student Safety Moderation',
            reviews: '⭐ Shopper Reviews & Feedback',
            college: '🎉 College Life Videos',
            resources: '📚 Exam Resources'
          };

          function switchSection(secKey) {
            document.querySelectorAll('.sidebar-btn').forEach(b => b.classList.remove('active'));
            const activeBtn = document.querySelector(`.sidebar-btn[data-section="${secKey}"]`);
            if (activeBtn) activeBtn.classList.add('active');

            document.querySelectorAll('.admin-section').forEach(s => s.classList.add('d-none'));
            const activeSec = document.getElementById(`sec-${secKey}`);
            if (activeSec) activeSec.classList.remove('d-none');

            const titleEl = document.getElementById('currentSectionTitle');
            if (titleEl && sectionTitles[secKey]) titleEl.textContent = sectionTitles[secKey];

            window.location.hash = secKey;
            const sb = document.getElementById('adminSidebar');
            if (sb) sb.classList.remove('show-mobile');
          }

          document.querySelectorAll('.sidebar-btn').forEach(btn => {
            btn.addEventListener('click', () => switchSection(btn.dataset.section));
          });

          // Handle Hash on Load & Setup Clipboard Paste
          document.addEventListener('DOMContentLoaded', () => {
            const hash = window.location.hash.replace('#', '').replace('tab-', '').replace('sec-', '');
            if (hash && sectionTitles[hash]) {
              switchSection(hash);
            }
            if (typeof setupClipboardImagePaste === 'function') {
              setupClipboardImagePaste('blogContent');
              setupClipboardImagePaste('editBlogContent');
            }
          });

          // Helper to pass admin authorization headers with fetch calls
          function getAdminHeaders() {
            const pass = sessionStorage.getItem('admin_passcode') || localStorage.getItem('admin_passcode') || '';
            return pass ? { 'x-admin-passcode': pass } : {};
          }

          // Helper to get admin passcode for body/query fallback
          function getAdminPasscode() {
            return sessionStorage.getItem('admin_passcode') || localStorage.getItem('admin_passcode') || '';
          }

          // Login Form
          const loginForm = document.getElementById('adminLoginForm');
          if (loginForm) {
            loginForm.addEventListener('submit', async function (e) {
              e.preventDefault();
              const pass = (document.getElementById('masterPassInput').value || '').trim();
              const errAlert = document.getElementById('loginErrorAlert');
              const btn = document.getElementById('loginSubmitBtn');

              btn.disabled = true;
              btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Verifying...';

              try {
                const res = await fetch('/api/admin/login', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  credentials: 'include',
                  body: JSON.stringify({ password: pass })
                });
                const data = await res.json().catch(() => ({}));
                if (res.ok && data.success) {
                  try {
                    sessionStorage.setItem('admin_passcode', pass);
                    localStorage.setItem('admin_passcode', pass);
                  } catch (_) {}

                  const urlParams = new URLSearchParams(window.location.search);
                  const redirectParam = urlParams.get('redirect');
                  if (redirectParam && redirectParam.startsWith('/') && !redirectParam.startsWith('//')) {
                    window.location.href = redirectParam;
                  } else {
                    window.location.reload();
                  }
                } else {
                  errAlert.textContent = data.error || data.message || 'Incorrect passcode. Please try again.';
                  errAlert.classList.remove('d-none');
                  btn.disabled = false;
                  btn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Unlock Dashboard';
                }
              } catch (err) {
                errAlert.textContent = err.message || 'Server connection error. Please try again.';
                errAlert.classList.remove('d-none');
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Unlock Dashboard';
              }
            });
          }

          // Logout
          async function logoutAdmin() {
            if (!confirm('Sign out of Admin?')) return;
            try {
              sessionStorage.removeItem('admin_passcode');
              localStorage.removeItem('admin_passcode');
              await fetch('/api/admin/logout', { method: 'POST', credentials: 'include' });
              window.location.href = '/admin';
            } catch (e) {
              window.location.reload();
            }
          }

          // Live Stream Actions
          async function activateLive(e) {
            e.preventDefault();
            const form = document.getElementById('activateLiveForm');
            const submitBtn = form ? form.querySelector('button[type="submit"]') : null;
            const youtubeUrl = document.getElementById('liveYtUrl').value.trim();
            const title = document.getElementById('liveTitle').value.trim();

            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Starting...';
            }

            try {
              const res = await fetch('/api/live-study/activate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ youtubeUrl, title })
              });
              const data = await res.json();
              if (data.success) {
                showToast('🔴 Live Stream is ACTIVE!');
                setTimeout(() => {
                  window.location.hash = 'live';
                  window.location.reload();
                }, 800);
              } else {
                showToast(data.message || 'Failed to activate live stream.', true);
                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = '<i class="fa-solid fa-tower-broadcast me-1"></i> Start Live Now';
                }
              }
            } catch (err) {
              showToast('Error connecting to server.', true);
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fa-solid fa-tower-broadcast me-1"></i> Start Live Now';
              }
            }
          }

          async function endLiveStream() {
            if (!confirm('End the current live stream?')) return;
            try {
              const res = await fetch('/api/live-study/end', { method: 'POST' });
              const data = await res.json();
              if (data.success) {
                showToast('Live stream ended.');
                setTimeout(() => {
                  window.location.hash = 'live';
                  window.location.reload();
                }, 800);
              } else {
                showToast(data.message || 'Failed to end stream.', true);
              }
            } catch (err) {
              showToast('Error connecting to server.', true);
            }
          }

          async function addPastSession(e) {
            e.preventDefault();
            const form = document.getElementById('addPastSessionForm');
            const submitBtn = form ? form.querySelector('button[type="submit"]') : null;
            const youtubeUrl = document.getElementById('pastYtUrl').value.trim();
            const title = document.getElementById('pastTitle').value.trim();
            const duration = document.getElementById('pastDuration').value.trim();
            const thumbnail = document.getElementById('pastThumbnail').value.trim();

            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';
            }

            try {
              const res = await fetch('/api/live-study/add-past', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ youtubeUrl, title, duration, thumbnail })
              });
              const data = await res.json();
              if (data.success) {
                showToast('Recorded study session saved!');
                setTimeout(() => {
                  window.location.hash = 'live';
                  window.location.reload();
                }, 800);
              } else {
                showToast(data.message || 'Failed to add session.', true);
                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = 'Save Session';

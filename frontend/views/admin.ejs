          function onBlogTitleInput(titleInputId, slugInputId) {
            const title = document.getElementById(titleInputId).value.trim();
            const slugInput = document.getElementById(slugInputId);
            if (!slugInput) return;
            // Only auto-generate if slug hasn't been manually typed yet or matches old slug
            const autoSlug = title.toLowerCase()
              .replace(/[^a-z0-9\s-]/g, '')
              .replace(/\s+/g, '-')
              .replace(/-+/g, '-')
              .slice(0, 60);
            slugInput.value = autoSlug;

              const data = await res.json().catch(() => ({}));
              if (res.ok && data.success) {
                showToast('Featured video updated!');
                setTimeout(() => {
                  window.location.hash = 'college';
                  window.location.reload();
                }, 800);
              } else {
                showToast(data.error || data.message || 'Failed to update.', true);
              }
            } catch (err) {
              showToast('Error connecting to server.', true);
            }
          }

          // Exam Resources Actions
          async function addResourceCard(e) {
            e.preventDefault();
            const title = document.getElementById('resTitle').value.trim();
            const exam = document.getElementById('resExam').value.trim();
            const category = document.getElementById('resCategory').value;
            const latestYear = document.getElementById('resYear').value;
            const officialUrl = document.getElementById('resUrl').value.trim();
            const description = document.getElementById('resDesc').value.trim();

            try {
              const res = await fetch('/api/resources', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json',
                  ...(getAdminHeaders())
                },
                credentials: 'include',
                body: JSON.stringify({ title, exam, category, latestYear, officialUrl, description })
              });
              const data = await res.json().catch(() => ({}));
              if (res.ok && data.success) {
                showToast('Resource Card added!');
                setTimeout(() => {
                  window.location.hash = 'resources';
                  window.location.reload();
                }, 1000);
              } else {
                showToast(data.error || data.message || 'Failed to add card.', true);
              }
            } catch (err) {
              showToast('Error connecting to server.', true);
            }
          }

          async function deleteResourceCard(id) {
            if (!confirm('Delete this resource card?')) return;
            try {
              const res = await fetch('/api/resources/' + encodeURIComponent(id), {
                method: 'DELETE',
                headers: {
                  'Accept': 'application/json',
                  ...(getAdminHeaders())
                },
                credentials: 'include'
              });
              const data = await res.json().catch(() => ({}));
              if (res.ok && data.success) {
                const row = document.getElementById('res-row-' + id);
                if (row) row.remove();
                showToast('Resource card deleted.');
              } else {
                showToast(data.error || data.message || 'Failed to delete card.', true);
              }
            } catch (err) {
              showToast('Error deleting card.', true);
            }
          }
        </script>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Master Admin Dashboard | 2AM Study</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root {
      --bg: #090d16;
      --sidebar-bg: #0d121f;
      --card-bg: #131b2e;
      --card-bg-subtle: #1a233a;
      --card-border: rgba(255, 255, 255, 0.08);
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --primary-glow: rgba(99, 102, 241, 0.25);
      --accent: #f59e0b;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --text: #f9fafb;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* Layout Wrapper */
    .admin-layout {
      display: flex;
      min-height: 100vh;
    }

    /* Sidebar Navigation */
    .admin-sidebar {
      width: 260px;
      background: var(--sidebar-bg);
      border-right: 1px solid var(--card-border);
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
      z-index: 1000;
      flex-shrink: 0;
    }

    .brand-logo-badge {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: linear-gradient(135deg, #dc2626, #6366f1);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 800;
      font-size: 1rem;
      box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
    }

    .sidebar-nav {
      padding: 1rem 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
      overflow-y: auto;
    }

    .sidebar-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 10px 14px;
      border-radius: 10px;
      border: 1px solid transparent;
      background: transparent;
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.88rem;
      text-decoration: none;
      transition: all 0.15s ease;
      cursor: pointer;
      text-align: left;
    }

    .sidebar-btn:hover {
      background: rgba(255, 255, 255, 0.04);
      color: #fff;
    }

    .sidebar-btn.active {
      background: rgba(99, 102, 241, 0.12);
      border-color: rgba(99, 102, 241, 0.3);
      color: #fff;
    }

    .sidebar-btn.active i {
      color: #818cf8 !important;
    }

    /* Main Area */
    .admin-main {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    .admin-topbar {
      height: 64px;
      background: rgba(13, 18, 31, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--card-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.75rem;
      position: sticky;
      top: 0;
      z-index: 990;
    }

    /* Content Cards */
    .admin-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 1rem;
      padding: 1.25rem 1.5rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .stat-pill-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 1rem;
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .stat-pill-icon {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
      flex-shrink: 0;
    }

    /* Tables */
    .table-custom {
      color: var(--text);
      vertical-align: middle;
      border-color: rgba(255, 255, 255, 0.06);
    }

    .table-custom thead th {
      background: var(--card-bg-subtle);
      color: var(--text-muted);
      font-size: 0.76rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--card-border);
      padding: 10px 14px;
    }

    .table-custom tbody td {
      padding: 12px 14px;
      background: transparent;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      font-size: 0.88rem;
    }

    .table-custom tbody tr:hover td {
      background: rgba(255, 255, 255, 0.02);
    }

    /* Live Badge */
    .badge-live-pulse {
      background: rgba(220, 38, 38, 0.18);
      border: 1px solid rgba(220, 38, 38, 0.4);
      color: #f87171;
      padding: 4px 10px;
      border-radius: 100px;
      font-size: 0.72rem;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      letter-spacing: 0.05em;
    }

    .live-dot-pulse {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #ef4444;
      animation: pulse 1.4s ease-in-out infinite;
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.4;
        transform: scale(0.7);
      }
    }

    /* Form Controls */
    .form-control-dark,
    .form-select-dark {
      background: #090d16 !important;
      border: 1px solid rgba(255, 255, 255, 0.12) !important;
      color: #fff !important;
      border-radius: 8px;
      padding: 9px 13px;
      font-size: 0.88rem;
    }

    .form-control-dark:focus,
    .form-select-dark:focus {
      border-color: var(--primary) !important;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25) !important;
    }

    .form-control-dark::placeholder {
      color: var(--text-dim);
    }

    /* Buttons */
    .btn-gradient-primary {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      border: none;
      color: #fff;
      font-weight: 700;
      border-radius: 8px;
      padding: 8px 18px;
      box-shadow: 0 4px 12px var(--primary-glow);
      transition: all 0.15s ease;
      font-size: 0.88rem;
    }

    .btn-gradient-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px var(--primary-glow);
      color: #fff;
    }

    .btn-gradient-danger {
      background: linear-gradient(135deg, #dc2626, #b91c1c);
      border: none;
      color: #fff;
      font-weight: 700;
      border-radius: 8px;
      padding: 8px 18px;
      box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
      transition: all 0.15s ease;
      font-size: 0.88rem;
    }

    .btn-gradient-danger:hover {
      transform: translateY(-1px);
      color: #fff;
    }

    /* Modal styling */
    .modal-content-dark {
      background: #111827;
      border: 1px solid var(--card-border);
      border-radius: 1rem;
      color: #fff;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
    }

    .modal-header-dark {
      border-bottom: 1px solid var(--card-border);
      padding: 1rem 1.25rem;
    }

    .modal-footer-dark {
      border-top: 1px solid var(--card-border);
      padding: 1rem 1.25rem;
    }

    /* Toast */
    .toast-container {
      position: fixed;
      bottom: 20px;
      right: 20px;
      z-index: 1090;
    }

    /* Mobile Responsive */
    @media (max-width: 991px) {
      .admin-sidebar {
        display: none;
      }

      .admin-sidebar.show-mobile {
        display: flex;
        position: fixed;
        inset: 0 auto 0 0;
        box-shadow: 0 0 50px rgba(0, 0, 0, 0.8);
      }
    }

    /* Advanced Blog Editor Styles */
    .blog-editor-toolbar {
      background: #0f1629;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px 10px 0 0;
      padding: 8px 12px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
    }
    .blog-toolbar-btn {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #e2e8f0;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      line-height: 1.4;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .blog-toolbar-btn:hover {
      background: rgba(99, 102, 241, 0.2);
      border-color: rgba(99, 102, 241, 0.5);
      color: #fff;
    }
    .blog-toolbar-divider {
      width: 1px;
      height: 22px;
      background: rgba(255, 255, 255, 0.15);
      margin: 0 4px;
    }
    .blog-textarea {
      border-radius: 0 0 10px 10px !important;
      border-top: none !important;
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      line-height: 1.6;
      resize: vertical;
      min-height: 380px;
    }
    .blog-preview-card {
      background: #ffffff;
      color: #1e293b;
      border-radius: 10px;
      padding: 24px;
      min-height: 380px;
      max-height: 540px;
      overflow-y: auto;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }
    /* Preview body styles inside editor */
    .article-preview-body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1rem;
      line-height: 1.8;
      color: #334155;
    }
    .article-preview-body h2 {
      font-size: 1.5rem;
      font-weight: 800;
      color: #0f172a;
      margin-top: 28px;
      margin-bottom: 12px;
    }
    .article-preview-body h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
      margin-top: 24px;
      margin-bottom: 10px;
    }
    .article-preview-body p { margin-bottom: 16px; }
    .article-preview-body table, .article-preview-body .blog-custom-table {
      width: 100%;
      margin: 20px 0;
      border-collapse: separate;
      border-spacing: 0;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #e2e8f0;
      font-size: 0.9rem;
    }
    .article-preview-body th {
      background: #0f172a;
      color: #fff;
      padding: 10px 14px;
      font-weight: 700;
      border-bottom: 2px solid #334155;
    }
    .article-preview-body td {
      padding: 10px 14px;
      border-bottom: 1px solid #f1f5f9;
      background: #fff;
    }
    .article-preview-body tr:nth-child(even) td { background: #f8fafc; }
    .article-preview-body .pro-tip {
      background: #f0fdf4;
      border-left: 4px solid #22c55e;
      padding: 14px 18px;
      border-radius: 8px;
      margin: 20px 0;
      color: #166534;
    }
    .article-preview-body .callout-warning {
      background: #fffbeb;
      border-left: 4px solid #f59e0b;
      padding: 14px 18px;
      border-radius: 8px;
      margin: 20px 0;
      color: #92400e;
    }
    .article-preview-body .callout-info {
      background: #eff6ff;
      border-left: 4px solid #3b82f6;
      padding: 14px 18px;
      border-radius: 8px;
      margin: 20px 0;
      color: #1e40af;
    }
    .article-preview-body .callout-takeaway {
      background: #faf5ff;
      border-left: 4px solid #a855f7;
      padding: 14px 18px;
      border-radius: 8px;
      margin: 20px 0;
      color: #6b21a8;
    }
    .article-preview-body blockquote {
      border-left: 4px solid #6366f1;
      padding: 12px 18px;
      background: #f8fafc;
      border-radius: 0 8px 8px 0;
      font-style: italic;
      color: #475569;
      margin: 20px 0;
    }
    .article-preview-body .blog-checklist {
      list-style: none;
      padding-left: 0;
    }
    .article-preview-body .blog-checklist li {
      position: relative;
      padding-left: 28px;
      margin-bottom: 8px;
    }
    .article-preview-body .blog-checklist li::before {
      content: "✓";
      position: absolute;
      left: 0;
      top: 2px;
      width: 18px;
      height: 18px;
      background: #22c55e;
      color: #fff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: bold;
    }
    .article-preview-body .blog-img-box {
      margin: 20px 0;
      text-align: center;
    }
    .article-preview-body .blog-img-box img {
      max-height: 400px;
      object-fit: cover;
      border-radius: 10px;
      width: 100%;
    }
  </style>
</head>

<body>

  <!-- ========================================== -->
  <!-- 1. AUTH GATE (IF NOT LOGGED IN) -->
  <!-- ========================================== -->
  <% if (!isAuthed) { %>
    <div class="d-flex align-items-center justify-content-center min-vh-100 px-3"
      style="background: radial-gradient(ellipse at 50% 0%, #1e1b4b 0%, #0c0a18 60%, #03020a 100%);">
      <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 text-center position-relative overflow-hidden"
        style="max-width: 420px; width: 100%; background: rgba(17, 24, 39, 0.9); backdrop-filter: blur(20px); border: 1px solid rgba(99, 102, 241, 0.3) !important;">

        <div class="mb-3">
          <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle"
            style="background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.35);">
            <i class="fa-solid fa-shield-halved fs-2 text-primary"></i>
          </div>
        </div>

        <h2 class="fw-bold text-white mb-1 fs-4">2 AM Study Admin</h2>
        <p class="text-muted small mb-4">Enter master passcode to manage all features.</p>

        <div id="loginErrorAlert" class="alert alert-danger py-2 small d-none" role="alert"></div>

        <form id="adminLoginForm">
          <div class="mb-3 text-start">
            <label class="form-label text-white-50 small fw-semibold">Master Admin Passcode</label>
            <div class="input-group">
              <span class="input-group-text bg-dark border-secondary text-white-50"><i
                  class="fa-solid fa-lock"></i></span>
              <input type="password" class="form-control form-control-dark" id="masterPassInput"
                placeholder="Enter password" required autofocus>
              <button class="btn btn-outline-secondary border-secondary text-white-50" type="button"
                onclick="togglePassVisibility()">
                <i class="fa-solid fa-eye" id="togglePassIcon"></i>
              </button>
            </div>
          </div>
          <button type="submit" class="btn btn-gradient-primary w-100 py-2" id="loginSubmitBtn">
            <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Unlock Dashboard
          </button>
        </form>

        <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-center">
          <a href="/" class="text-decoration-none text-white-50 small hover-white">← Return to Website</a>
        </div>
      </div>
    </div>
    <% } else { %>

      <!-- ========================================== -->
      <!-- 2. SIMPLIFIED MASTER ADMIN DASHBOARD -->
      <!-- ========================================== -->
      <div class="admin-layout">

        <!-- Left Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
          <!-- Brand -->
          <div
            class="p-3 border-bottom border-white border-opacity-10 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2.5">
              <span class="brand-logo-badge">2A</span>
              <div>
                <div class="fw-bold text-white fs-6 lh-1">2 AM Study</div>
                <span class="text-muted" style="font-size: 11px;">Admin Control</span>
              </div>
            </div>
            <button class="btn btn-sm text-white-50 d-lg-none" onclick="toggleMobileSidebar()"><i
                class="fa-solid fa-xmark"></i></button>
          </div>

          <!-- Navigation Items -->
          <nav class="sidebar-nav">
            <button class="sidebar-btn active" data-section="live">
              <div class="d-flex align-items-center gap-2.5">
                <i class="fa-solid fa-video text-danger"></i>
                <span>Live Study</span>
              </div>
              <% if (liveSession) { %>
                <span class="badge rounded-pill bg-danger" style="font-size: 9px;">LIVE</span>
                <% } else { %>
                  <span class="badge rounded-pill bg-secondary bg-opacity-25 text-white-50" style="font-size: 10px;">
                    <%= allStudySessions.length %>
                  </span>
                  <% } %>
            </button>

            <button class="sidebar-btn" data-section="products">
              <div class="d-flex align-items-center gap-2.5">
                <i class="fa-solid fa-bag-shopping text-primary"></i>
                <span>Store Products</span>
              </div>
              <span class="badge rounded-pill bg-secondary bg-opacity-25 text-white-50" style="font-size: 10px;">
                <%= products.length %>
              </span>
            </button>

            <button class="sidebar-btn" data-section="orders">
              <div class="d-flex align-items-center gap-2.5">
                <i class="fa-solid fa-receipt text-success"></i>
                <span>Customer Orders</span>
              </div>
              <span class="badge rounded-pill bg-secondary bg-opacity-25 text-white-50" style="font-size: 10px;">
                <%= orders.length %>
              </span>
            </button>

            <button class="sidebar-btn" data-section="blogs">
              <div class="d-flex align-items-center gap-2.5">
                <i class="fa-solid fa-newspaper text-info"></i>
                <span>Blog Articles</span>
              </div>
              <span class="badge rounded-pill bg-secondary bg-opacity-25 text-white-50" style="font-size: 10px;">
                <%= blogs.length %>
              </span>
            </button>

            <button class="sidebar-btn" data-section="safety">
              <div class="d-flex align-items-center gap-2.5">
                <i class="fa-solid fa-shield-halved text-warning"></i>
                <span>Student Safety</span>
              </div>
              <% const pendingCount=safetyCases.filter(c=> c.status === 'Pending').length; %>
                <% if (pendingCount> 0) { %>
                  <span class="badge rounded-pill bg-warning text-dark" style="font-size: 10px;">
                    <%= pendingCount %> new
                  </span>
                  <% } else { %>
                    <span class="badge rounded-pill bg-secondary bg-opacity-25 text-white-50" style="font-size: 10px;">
                      <%= safetyCases.length %>
                    </span>
                    <% } %>
            </button>

            <button class="sidebar-btn" data-section="reviews">
              <div class="d-flex align-items-center gap-2.5">
                <i class="fa-solid fa-star text-warning"></i>
                <span>Shopper Reviews</span>
              </div>
              <span class="badge rounded-pill bg-secondary bg-opacity-25 text-white-50" style="font-size: 10px;">
                <%= feedbacks.length %>
              </span>
            </button>

            <button class="sidebar-btn" data-section="college">
              <div class="d-flex align-items-center gap-2.5">
                <i class="fa-solid fa-graduation-cap" style="color: #fb923c;"></i>
                <span>College Life</span>
              </div>
              <span class="badge rounded-pill bg-secondary bg-opacity-25 text-white-50" style="font-size: 10px;">
                <%= typeof collegeVideos !=='undefined' ? collegeVideos.length : 0 %>
              </span>
            </button>

            <button class="sidebar-btn" data-section="resources">
              <div class="d-flex align-items-center gap-2.5">
                <i class="fa-solid fa-book-open text-info"></i>
                <span>Exam Resources</span>
              </div>
              <span class="badge rounded-pill bg-secondary bg-opacity-25 text-white-50" style="font-size: 10px;">
                <%= typeof resources !=='undefined' ? resources.length : 0 %>
              </span>
            </button>
          </nav>

          <!-- Sidebar Footer -->
          <div class="p-3 border-top border-white border-opacity-10 d-flex align-items-center justify-content-between">
            <a href="/" target="_blank"
              class="text-decoration-none text-white-50 small hover-white d-flex align-items-center gap-1.5">
              <i class="fa-solid fa-arrow-up-right-from-square small"></i> Visit Site
            </a>
            <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none small" onclick="logoutAdmin()">
              <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
            </button>
          </div>
        </aside>

        <!-- Main Content Area -->
        <div class="admin-main">

          <!-- Top Bar -->
          <div class="admin-topbar">
            <div class="d-flex align-items-center gap-3">
              <button class="btn btn-sm btn-outline-secondary d-lg-none" onclick="toggleMobileSidebar()"><i
                  class="fa-solid fa-bars"></i></button>
              <div class="fw-bold text-white fs-6" id="currentSectionTitle">🔴 Live Study Manager</div>
            </div>
            <div class="d-flex align-items-center gap-2.5">
              <% if (liveSession) { %>
                <span class="badge-live-pulse"><span class="live-dot-pulse"></span> STREAM ACTIVE</span>
                <% } else { %>
                  <span class="badge bg-secondary bg-opacity-25 text-white-50 rounded-pill px-2.5 py-1"
                    style="font-size: 11px;">STREAM OFFLINE</span>
                  <% } %>
            </div>
          </div>

          <!-- Main Body Container -->
          <div class="p-3 p-md-4">

            <!-- ========================================== -->
            <!-- SECTION 1: LIVE STUDY -->
            <!-- ========================================== -->
            <div class="admin-section active" id="sec-live">

              <!-- Stream Controller Card -->
              <div class="admin-card mb-4">
                <% if (liveSession) { %>
                  <div
                    class="d-flex align-items-center justify-content-between flex-wrap gap-3 pb-3 border-bottom border-white border-opacity-10 mb-3">
                    <div class="d-flex align-items-center gap-2">
                      <span class="badge-live-pulse"><span class="live-dot-pulse"></span> LIVE NOW</span>
                      <span class="fw-bold text-white">
                        <%= liveSession.title %>
                      </span>
                    </div>
                    <button class="btn btn-gradient-danger btn-sm" onclick="endLiveStream()">
                      <i class="fa-solid fa-stop me-1"></i> End Current Live Stream
                    </button>
                  </div>
                  <div class="row g-3 align-items-center">
                    <div class="col-md-5">
                      <div class="ratio ratio-16x9 rounded-3 overflow-hidden border border-secondary border-opacity-25">
                        <iframe
                          src="https://www.youtube-nocookie.com/embed/<%= liveSession.youtubeVideoId %>?autoplay=0&rel=0&modestbranding=1"
                          allowfullscreen></iframe>
                      </div>
                    </div>
                    <div class="col-md-7">
                      <p class="text-white-50 small mb-2">
                        <%= liveSession.description || 'No session description.' %>
                      </p>
                      <div class="text-muted small mb-2"><i class="fa-regular fa-clock me-1"></i>Started: <%= new
                          Date(liveSession.startedAt).toLocaleTimeString('en-IN') %>
                      </div>
                      <a href="<%= liveSession.youtubeUrl %>" target="_blank"
                        class="btn btn-sm btn-outline-danger rounded-pill px-3"><i
                          class="fa-brands fa-youtube me-1"></i>Open on YouTube</a>
                    </div>
                  </div>
                  <% } else { %>
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                      <div>
                        <h4 class="fw-bold text-white fs-6 mb-0"><i
                            class="fa-solid fa-tower-broadcast text-danger me-2"></i>Go Live on YouTube</h4>
                        <span class="text-muted small">Start a live study session to display on the homepage &amp; study
                          room.</span>
                      </div>
                      <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="modal"
                        data-bs-target="#addPastModal">
                        <i class="fa-solid fa-plus me-1"></i> Add Past Recorded Session
                      </button>
                    </div>
                    <form id="activateLiveForm" onsubmit="activateLive(event)">
                      <div class="row g-3">
                        <div class="col-md-5">
                          <input type="text" class="form-control form-control-dark" id="liveYtUrl"
                            placeholder="Paste YouTube Live URL or Video ID *" required>
                        </div>
                        <div class="col-md-4">
                          <input type="text" class="form-control form-control-dark" id="liveTitle"
                            placeholder="Session Title (e.g. 5 Hour Focus Session) *" required>
                        </div>
                        <div class="col-md-3">
                          <button type="submit" class="btn btn-gradient-danger w-100">
                            <i class="fa-solid fa-tower-broadcast me-1"></i> Start Live Now
                          </button>
                        </div>
                      </div>
                    </form>
                    <% } %>
              </div>

              <!-- Recorded Sessions List -->
              <div class="admin-card">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                  <h4 class="fw-bold text-white fs-6 mb-0"><i class="fa-solid fa-list text-primary me-2"></i>All Study
                    Sessions (<%= allStudySessions.length %>)</h4>
                  <button class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal"
                    data-bs-target="#addPastModal">
                    <i class="fa-solid fa-plus me-1"></i> Add Past Recording
                  </button>
                </div>
                <div class="table-responsive">
                  <table class="table table-custom mb-0">
                    <thead>
                      <tr>
                        <th>Video Preview</th>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% allStudySessions.forEach(function(s) { %>
                        <tr id="session-row-<%= s.id %>">
                          <td style="width: 100px;">
                            <img
                              src="<%= (s.thumbnail && !s.thumbnail.includes('maxresdefault')) ? s.thumbnail : ('https://img.youtube.com/vi/' + s.youtubeVideoId + '/hqdefault.jpg') %>"
                              onerror="this.onerror=null;this.src='https://img.youtube.com/vi/<%= s.youtubeVideoId %>/hqdefault.jpg';"
                              alt="" class="rounded-2" style="width: 80px; height: 45px; object-fit: cover;">
                          </td>
                          <td>
                            <div class="fw-bold text-white">
                              <%= s.title %>
                            </div>
                            <div class="text-muted small" style="font-size: 11px;">
                              <%= s.duration || 'Session' %> &bull; <a href="<%= s.youtubeUrl %>" target="_blank"
                                  class="text-primary text-decoration-none">YouTube Link</a>
                            </div>
                          </td>
                          <td>
                            <% if (s.status==='LIVE' ) { %>
                              <span class="badge-live-pulse"><span class="live-dot-pulse"></span> LIVE</span>
                              <% } else { %>
                                <span class="badge bg-secondary bg-opacity-25 text-white-50 rounded-pill px-2"
                                  style="font-size: 10px;">COMPLETED</span>
                                <% } %>
                          </td>
                          <td class="text-muted small">
                            <%= new Date(s.createdAt || s.startedAt).toLocaleDateString('en-IN',
                              {day:'numeric',month:'short'}) %>
                          </td>
                          <td class="text-end">
                            <a href="/live-study/<%= s.id %>" target="_blank"
                              class="btn btn-sm btn-outline-info rounded-pill py-0 px-2" style="font-size: 11px;"><i
                                class="fa-solid fa-eye"></i></a>
                            <% if (s.status !=='LIVE' ) { %>
                              <button class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2"
                                onclick="deleteStudySession('<%= s.id %>')" style="font-size: 11px;"><i
                                  class="fa-solid fa-trash"></i></button>
                              <% } %>
                          </td>
                        </tr>
                        <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- ========================================== -->
            <!-- SECTION 2: STORE PRODUCTS -->
            <!-- ========================================== -->
            <div class="admin-section d-none" id="sec-products">

              <!-- Product Table Card -->
              <div class="admin-card">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
                  <div>
                    <h4 class="fw-bold text-white fs-6 mb-0">
                      <i class="fa-solid fa-store text-primary me-2"></i>Store Catalog
                      <span class="badge bg-primary bg-opacity-25 text-primary ms-1" style="font-size: 11px;"><%= products.length %></span>
                    </h4>
                    <span class="text-muted small">Manage store products &amp; details.</span>
                  </div>
                  <div class="d-flex gap-2">
                    <input type="text" class="form-control form-control-dark" id="productSearchInput"
                      placeholder="🔍 Search products..." style="max-width: 200px; font-size: 0.82rem;"
                      oninput="filterProductRows(this.value)">
                    <button class="btn btn-gradient-primary btn-sm rounded-pill px-3" data-bs-toggle="modal"
                      data-bs-target="#addProductModal">
                      <i class="fa-solid fa-plus me-1"></i> Add Product
                    </button>
                  </div>
                </div>

                <div class="table-responsive">
                  <table class="table table-custom mb-0" id="productTable">
                    <thead>
                      <tr>
                        <th style="width: 70px;">Image</th>
                        <th>Product Name</th>
                        <th class="text-end" style="width: 120px;">Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% products.forEach(function(p) { %>
                        <tr id="prod-row-<%= p.id %>" data-name="<%= (p.name || '').toLowerCase() %>" data-cat="<%= (p.cat || '').toLowerCase() %>">
                          <td style="vertical-align: middle;">
                            <div style="width:48px;height:48px;border-radius:8px;overflow:hidden;background:#1a233a;border:1px solid rgba(255,255,255,0.08);flex-shrink:0;">
                              <img src="<%= p.images && p.images[0] ? p.images[0] : (p.image || '/assets/images/logo.jpg') %>"
                                alt="<%= p.name %>" style="width:100%;height:100%;object-fit:cover;"
                                onerror="this.src='/assets/images/logo.jpg'">
                            </div>
                          </td>
                          <td style="vertical-align: middle;">
                            <div class="fw-bold text-white"><%= p.name %></div>
                          </td>
                          <td class="text-end" style="vertical-align: middle;">
                            <button class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1" style="font-size:12px;"
                              title="Edit" onclick="openEditProductModal('<%= p.id %>')">
                              <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                            </button>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- ========================================== -->
            <!-- SECTION 3: STORE ORDERS -->
            <!-- ========================================== -->
            <div class="admin-section d-none" id="sec-orders">
              <div class="admin-card">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                  <h4 class="fw-bold text-white fs-6 mb-0"><i class="fa-solid fa-receipt text-success me-2"></i>Customer
                    Purchases (<%= orders.length %>)</h4>
                </div>

                <% if (orders.length===0) { %>
                  <div class="text-center py-5 text-muted">
                    <div class="fs-2 mb-2">📦</div>
                    <p class="small mb-0">No customer orders yet.</p>
                  </div>
                  <% } else { %>
                    <div class="table-responsive">
                      <table class="table table-custom mb-0">
                        <thead>
                          <tr>
                            <th>Order</th>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th class="text-end">Invoice</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% orders.forEach(function(ord) { %>
                            <tr>
                              <td class="fw-bold text-white">#<%= ord.orderId || ord.id %>
                              </td>
                              <td>
                                <div class="fw-bold text-white">
                                  <%= ord.customer?.name || ord.name || 'Student' %>
                                </div>
                                <div class="text-muted small" style="font-size: 11px;">
                                  <%= ord.customer?.phone || ord.phone || '' %>
                                </div>
                              </td>
                              <td><span class="text-white-50">
                                  <%= ord.items ? ord.items.length : 1 %> item(s)
                                </span></td>
                              <td class="fw-bold text-success">₹<%= ord.amount || ord.total || 0 %>
                              </td>
                              <td class="text-muted small">
                                <%= new Date(ord.createdAt || Date.now()).toLocaleDateString('en-IN',
                                  {day:'numeric',month:'short'}) %>
                              </td>
                              <td class="text-end">
                                <a href="/store/invoice/<%= ord.orderId || ord.id %>" target="_blank"
                                  class="btn btn-sm btn-outline-light rounded-pill py-0 px-2.5"
                                  style="font-size: 11px;">
                                  <i class="fa-solid fa-file-invoice me-1"></i> Invoice
                                </a>
                              </td>
                            </tr>
                            <% }); %>
                        </tbody>
                      </table>
                    </div>
                    <% } %>
              </div>
            </div>

            <!-- ========================================== -->
            <!-- SECTION 4: BLOG POSTS -->
            <!-- ========================================== -->
            <div class="admin-section d-none" id="sec-blogs">
              <div class="admin-card">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
                  <div>
                    <h4 class="fw-bold text-white fs-6 mb-1"><i
                        class="fa-solid fa-newspaper text-info me-2"></i>Published Articles (<%= blogs.length %>)</h4>
                    <span class="text-muted small" style="font-size: 11px;">Manage SEO blogs, format rich tables, insert images & study guides</span>
                  </div>
                  <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-gradient-primary btn-sm rounded-pill px-3" data-bs-toggle="modal"
                      data-bs-target="#addBlogModal">
                      <i class="fa-solid fa-plus me-1"></i> New Article
                    </button>
                  </div>
                </div>

                <!-- Search & Filters -->
                <div class="row g-2 mb-3">
                  <div class="col-md-6 col-lg-5">
                    <div class="input-group input-group-sm">
                      <span class="input-group-text bg-dark border-secondary border-opacity-25 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                      <input type="text" class="form-control form-control-dark" id="blogSearchInput"
                        placeholder="Search articles by title, slug or author..." oninput="filterBlogRows(this.value)">
                    </div>
                  </div>
                  <div class="col-md-4 col-lg-3">
                    <select class="form-select form-select-dark form-select-sm" id="blogCatFilter" onchange="filterBlogRows()">
                      <option value="">All Categories</option>
                      <option value="Study Tips">Study Tips</option>
                      <option value="Exam Prep">Exam Prep</option>
                      <option value="Late Night Routine">Late Night Routine</option>
                      <option value="Focus & Productivity">Focus & Productivity</option>
                      <option value="College Life">College Life</option>
                      <option value="Time Management">Time Management</option>
                    </select>
                  </div>
                </div>

                <div class="table-responsive">
                  <table class="table table-custom mb-0" id="blogTable">
                    <thead>
                      <tr>
                        <th>Article</th>
                        <th>Category</th>
                        <th>Author & Time</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% blogs.forEach(function(b) { %>
                        <tr id="blog-row-<%= b.id %>" data-title="<%= (b.title || '').toLowerCase() %>" data-slug="<%= (b.slug || '').toLowerCase() %>" data-cat="<%= (b.category || '').toLowerCase() %>" data-author="<%= (b.author || '').toLowerCase() %>">
                          <td>
                            <div class="d-flex align-items-center gap-2.5">
                              <img src="<%= b.coverImage || b.image || '/assets/images/logo.jpg' %>" alt=""
                                class="rounded-2 border border-secondary border-opacity-25"
                                style="width: 54px; height: 38px; object-fit: cover; flex-shrink: 0;"
                                onerror="this.src='/assets/images/logo.jpg'">
                              <div>
                                <div class="fw-bold text-white lh-sm">
                                  <%= b.title %>
                                </div>
                                <div class="text-muted small mt-0.5" style="font-size: 11px;">
                                  <span class="text-info">/blog/<%= b.slug %></span>
                                </div>
                              </div>
                            </div>
                          </td>
                          <td>
                            <span class="badge bg-info bg-opacity-20 text-info rounded-pill px-2.5 py-1" style="font-size: 10px;">
                              <%= b.category || 'Study Tips' %>
                            </span>
                          </td>
                          <td>
                            <div class="text-white-50 small" style="font-size: 12px;"><i class="fa-solid fa-user-pen me-1 text-muted"></i><%= b.author || '2 AM Study' %></div>
                            <div class="text-muted" style="font-size: 10px;"><i class="fa-regular fa-clock me-1"></i><%= b.readTime || '5 min read' %></div>
                          </td>
                          <td class="text-muted small">
                            <%= new Date(b.createdAt || b.date || Date.now()).toLocaleDateString('en-IN',
                              {day:'numeric',month:'short',year:'numeric'}) %>
                          </td>
                          <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                              <a href="/blog/<%= b.slug %>" target="_blank"
                                class="btn btn-sm btn-outline-info rounded-pill py-0.5 px-2.5" style="font-size: 11px;"
                                title="View Live Blog"><i class="fa-solid fa-eye me-1"></i> View</a>
                              <button class="btn btn-sm btn-outline-warning rounded-pill py-0.5 px-2.5"
                                onclick="openEditBlogModal('<%= b.id %>')" style="font-size: 11px;" title="Edit Article"><i
                                  class="fa-solid fa-pen-to-square me-1"></i> Edit</button>
                              <button class="btn btn-sm btn-outline-danger rounded-pill py-0.5 px-2"
                                onclick="deleteBlog('<%= b.id %>')" style="font-size: 11px;" title="Delete Article"><i
                                  class="fa-solid fa-trash"></i></button>
                            </div>
                          </td>
                        </tr>
                        <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- ========================================== -->
            <!-- SECTION 5: STUDENT SAFETY -->
            <!-- ========================================== -->
            <div class="admin-section d-none" id="sec-safety">
              <div class="admin-card">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                  <div>
                    <h4 class="fw-bold text-white fs-6 mb-0"><i
                        class="fa-solid fa-shield-halved text-warning me-2"></i>Student Safety Reports (<%=
                        safetyCases.length %>)</h4>
                  </div>
                  <a href="/api/student-safety/admin/export-csv" class="btn btn-sm btn-outline-light rounded-pill px-3"
                    style="font-size: 11px;">
                    <i class="fa-solid fa-file-csv me-1"></i> Export CSV
                  </a>
                </div>

                <% if (safetyCases.length===0) { %>
                  <div class="text-center py-5 text-muted">
                    <div class="fs-2 mb-2">🛡️</div>
                    <p class="small mb-0">No impersonation cases reported.</p>
                  </div>
                  <% } else { %>
                    <div class="table-responsive">
                      <table class="table table-custom mb-0">
                        <thead>
                          <tr>
                            <th>Case ID</th>
                            <th>Reported Target</th>
                            <th>Reason / Details</th>
                            <th>Evidence</th>
                            <th>Status</th>
                            <th class="text-end">Moderate</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% safetyCases.forEach(function(c) { %>
                            <tr id="safety-row-<%= c.caseId %>">
                              <td class="fw-bold text-white font-monospace">
                                #<%= c.caseId %>
                              </td>
                              <td>
                                <div class="fw-bold text-white">
                                  <%= c.platform %>: @<%= c.fakeUsername || c.fakeProfileUsername || c.targetName
                                      || 'Profile' %>
                                </div>
                                <a href="<%= c.fakeProfileUrl %>" target="_blank"
                                  class="text-danger text-decoration-none small" style="font-size: 11px;">
                                  <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Open Fake Profile
                                </a>
                                <% if (c.realProfileUrl) { %>
                                  <br>
                                  <a href="<%= c.realProfileUrl %>" target="_blank"
                                    class="text-success text-decoration-none small" style="font-size: 11px;">
                                    <i class="fa-solid fa-check me-1"></i>Real Profile
                                  </a>
                                  <% } %>
                              </td>
                              <td>
                                <span class="badge bg-light bg-opacity-10 text-white rounded-pill px-2"
                                  style="font-size: 10px;">
                                  <%= c.reason || 'Impersonation' %>
                                </span>
                                <% if (c.college) { %>
                                  <div class="text-white-50 small mt-1" style="font-size: 11px;"><i
                                      class="fa-solid fa-school me-1"></i>
                                    <%= c.college %>
                                  </div>
                                  <% } %>
                                    <% if (c.description) { %>
                                      <div class="text-white-50 small text-truncate mt-1"
                                        style="max-width: 200px; font-size: 11px;">
                                        <%= c.description %>
                                      </div>
                                      <% } %>
                              </td>
                              <td>
                                <% if (Array.isArray(c.evidence) && c.evidence.length> 0) { %>
                                  <div class="d-flex gap-1 flex-wrap">
                                    <% c.evidence.forEach(function(ev, idx) { %>
                                      <% const evUrl=typeof ev==='object' ? ev.url : ev; %>
                                        <a href="<%= evUrl %>" target="_blank"
                                          class="btn btn-sm btn-outline-secondary py-0 px-2 text-white"
                                          style="font-size: 10px;">
                                          📎 #<%= idx + 1 %>
                                        </a>
                                        <% }); %>
                                  </div>
                                  <% } else { %>
                                    <span class="text-muted small">None</span>
                                    <% } %>
                              </td>
                              <td>
                                <% if (c.status==='Verified' ) { %>
                                  <span class="badge bg-success bg-opacity-25 text-success rounded-pill px-2 py-1"
                                    style="font-size: 11px;">✅ Verified</span>
                                  <% } else if (c.status==='Resolved' ) { %>
                                    <span class="badge bg-primary bg-opacity-25 text-info rounded-pill px-2 py-1"
                                      style="font-size: 11px;">🎉 Resolved</span>
                                    <% } else if (c.status==='Rejected' ) { %>
                                      <span class="badge bg-danger bg-opacity-25 text-danger rounded-pill px-2 py-1"
                                        style="font-size: 11px;">❌ Rejected</span>
                                      <% } else { %>
                                        <span class="badge bg-warning bg-opacity-25 text-warning rounded-pill px-2 py-1"
                                          style="font-size: 11px;">🟡 Pending Review</span>
                                        <% } %>
                              </td>
                              <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end flex-wrap">
                                  <% if (c.status !=='Verified' ) { %>
                                    <button class="btn btn-sm btn-outline-success rounded-pill py-0 px-2 fw-semibold"
                                      onclick="moderateCase('<%= c.caseId %>', 'approve')"
                                      style="font-size: 11px;">Verify</button>
                                    <% } %>
                                      <% if (c.status==='Verified' ) { %>
                                        <button class="btn btn-sm btn-outline-info rounded-pill py-0 px-2 fw-semibold"
                                          onclick="moderateCase('<%= c.caseId %>', 'resolve')"
                                          style="font-size: 11px;">Resolve</button>
                                        <% } %>
                                          <% if (c.status !=='Rejected' ) { %>
                                            <button
                                              class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2 fw-semibold"
                                              onclick="moderateCase('<%= c.caseId %>', 'reject')"
                                              style="font-size: 11px;">Reject</button>
                                            <% } %>
                                              <button
                                                class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 fw-semibold"
                                                title="Delete Case"
                                                onclick="moderateCase('<%= c.caseId %>', 'delete')"
                                                style="font-size: 11px;"><i class="fa-solid fa-trash"></i></button>
                                </div>
                              </td>
                            </tr>
                            <% }); %>
                        </tbody>
                      </table>
                    </div>
                    <% } %>
              </div>
            </div>

            <!-- ========================================== -->
            <!-- SECTION 6: REVIEWS -->
            <!-- ========================================== -->
            <div class="admin-section d-none" id="sec-reviews">
              <div class="admin-card">
                <h4 class="fw-bold text-white fs-6 mb-3"><i class="fa-solid fa-star text-warning me-2"></i>Shopper
                  Reviews (<%= feedbacks.length %>)</h4>
                <div class="row g-3">
                  <% feedbacks.forEach(function(fb) { %>
                    <div class="col-md-6 col-lg-4" id="fb-card-<%= fb.id %>">
                      <div class="p-3 rounded-3 h-100 d-flex flex-column justify-content-between"
                        style="background: var(--card-bg-subtle); border: 1px solid var(--card-border);">
                        <div>
                          <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="fw-bold text-white small">
                              <%= fb.name %>
                            </div>
                            <div class="text-warning small">
                              <% for(let i=0; i < (fb.rating || 5); i++) { %>★<% } %>
                            </div>
                          </div>
                          <p class="text-white-50 small mb-2">"<%= fb.comment %>"</p>
                        </div>
                        <div
                          class="d-flex align-items-center justify-content-between pt-2 border-top border-white border-opacity-10 text-muted"
                          style="font-size: 11px;">
                          <span>
                            <%= fb.product || 'Store Item' %>
                          </span>
                          <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none"
                            onclick="deleteFeedback('<%= fb.id %>')"><i
                              class="fa-solid fa-trash me-1"></i>Delete</button>
                        </div>
                      </div>
                    </div>
                    <% }); %>
                </div>
              </div>
            </div>

            <!-- ========================================== -->
            <!-- SECTION 7: COLLEGE LIFE ENJOY -->
            <!-- ========================================== -->
            <div class="admin-section d-none" id="sec-college">
              <!-- Add Video Form -->
              <div class="admin-card mb-4">
                <div class="mb-3">
                  <h4 class="fw-bold text-white fs-6 mb-0"><i class="fa-solid fa-graduation-cap me-2"
                      style="color: #fb923c;"></i>Add College Life Video</h4>
                  <span class="text-muted small">Add a YouTube link with title for the 🎉 College Life Enjoy
                    section.</span>
                </div>
                <form id="addCollegeVideoForm" onsubmit="addCollegeVideo(event)">
                  <div class="row g-3">
                    <div class="col-md-5">
                      <input type="text" class="form-control form-control-dark" id="clYtUrl"
                        placeholder="YouTube Video URL *" required oninput="onCollegeYtUrlInput('clYtUrl', 'addClThumbPreview')">
                    </div>
                    <div class="col-md-4">
                      <input type="text" class="form-control form-control-dark" id="clTitle" placeholder="Video Title *"
                        required>
                    </div>
                    <div class="col-md-3">
                      <button type="submit" class="btn btn-gradient-primary w-100">
                        <i class="fa-solid fa-plus me-1"></i> Add Video
                      </button>
                    </div>
                  </div>
                  <!-- Live Preview Row (Auto-detected from URL) -->
                  <div class="mt-2.5 p-2 rounded-3 bg-dark border border-secondary border-opacity-25 d-none align-items-center gap-3" id="addClThumbContainer">
                    <img id="addClThumbPreview" src="" alt="Thumbnail" class="rounded-2 shadow-sm" style="width: 96px; height: 54px; object-fit: cover;">
                    <div class="small text-muted" style="font-size: 12px;">
                      <span class="text-success fw-bold"><i class="fa-solid fa-circle-check me-1"></i> YouTube Video Detected!</span>
                      <div class="text-white-50">Thumbnail confirmed from YouTube CDN</div>
                    </div>
                  </div>
                  <div class="row g-3 mt-1">
                    <div class="col-md-3">
                      <select class="form-select form-select-dark" id="clCategory">
                        <option value="Campus Vibe">Campus Vibe</option>
                        <option value="Hostel Fun">Hostel Fun</option>
                        <option value="Study Break">Study Break</option>
                        <option value="College Fest">College Fest</option>
                        <option value="Friends & Fun">Friends & Fun</option>
                      </select>
                    </div>
                    <div class="col-md-2">
                      <input type="text" class="form-control form-control-dark" id="clDuration"
                        placeholder="Duration (e.g. 5 Min)">
                    </div>
                    <div class="col-md-5">
                      <input type="text" class="form-control form-control-dark" id="clDescription"
                        placeholder="Short description (optional)">
                    </div>
                    <div class="col-md-2 d-flex align-items-center gap-2">
                      <input class="form-check-input mt-0" type="checkbox" id="clFeatured">
                      <label class="form-check-label text-white-50 small" for="clFeatured">Set as Featured</label>
                    </div>
                  </div>
                </form>
              </div>

              <!-- Videos List -->
              <div class="admin-card">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                  <h4 class="fw-bold text-white fs-6 mb-0">
                    <i class="fa-solid fa-list text-primary me-2"></i>All College Life Videos
                    (<%= typeof collegeVideos !=='undefined' ? collegeVideos.length : 0 %>)
                  </h4>
                  <a href="/college-life" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3"
                    style="font-size: 11px;">
                    <i class="fa-solid fa-eye me-1"></i> View Public Page
                  </a>
                </div>

                <% if (typeof collegeVideos !=='undefined' && collegeVideos.length) { %>
                  <div class="table-responsive">
                    <table class="table table-custom mb-0">
                      <thead>
                        <tr>
                          <th>Thumbnail</th>
                          <th>Title</th>
                          <th>Category</th>
                          <th>Duration</th>
                          <th>Featured</th>
                          <th class="text-end">Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% collegeVideos.forEach(function(v) { %>
                          <tr id="cv-row-<%= v.id %>">
                            <td style="width: 90px;">
                              <img
                                src="<%= (v.thumbnail && !v.thumbnail.includes('maxresdefault')) ? v.thumbnail : ('https://img.youtube.com/vi/' + v.youtubeVideoId + '/hqdefault.jpg') %>"
                                onerror="this.onerror=null;this.src='https://img.youtube.com/vi/<%= v.youtubeVideoId %>/hqdefault.jpg';"
                                alt="" class="rounded-2" style="width: 78px; height: 44px; object-fit: cover;">
                            </td>
                            <td>
                              <div class="fw-bold text-white">
                                <%= v.title %>
                              </div>
                              <a href="<%= v.youtubeUrl %>" target="_blank"
                                class="text-primary text-decoration-none small" style="font-size: 11px;">YouTube
                                Link</a>
                            </td>
                            <td>
                              <span class="badge bg-warning bg-opacity-25 text-warning rounded-pill px-2"
                                style="font-size: 10px;">
                                <%= v.category || 'College Life' %>
                              </span>
                            </td>
                            <td class="text-white-50 small">
                              <%= v.duration || '—' %>
                            </td>
                            <td>
                              <% if (v.isFeatured) { %>
                                <span class="badge bg-success bg-opacity-25 text-success rounded-pill px-2"
                                  style="font-size: 10px;">⭐ Featured</span>
                                <% } else { %>
                                  <button class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2"
                                    onclick="setCollegeFeatured('<%= v.id %>')" style="font-size: 10px;">Set
                                    Featured</button>
                                  <% } %>
                            </td>
                            <td class="text-end">
                              <div class="d-flex gap-1 justify-content-end">
                                <a href="/college-life/<%= v.id %>" target="_blank"
                                  class="btn btn-sm btn-outline-info rounded-pill py-0 px-2" style="font-size: 11px;" title="View Video">
                                  <i class="fa-solid fa-eye"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-warning rounded-pill py-0 px-2"
                                  title="Edit Video" onclick="openEditCollegeVideoModal('<%= v.id %>')" style="font-size: 11px;">
                                  <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2"
                                  title="Delete Video" onclick="deleteCollegeVideo('<%= v.id %>')" style="font-size: 11px;">
                                  <i class="fa-solid fa-trash"></i>
                                </button>
                              </div>
                            </td>
                          </tr>
                          <% }); %>
                      </tbody>
                    </table>
                  </div>
                  <% } else { %>
                    <div class="text-center py-5 text-muted">
                      <div class="fs-2 mb-2">🎓</div>
                      <p class="small mb-0">No college life videos yet. Use the form above to add the first one.</p>
                    </div>
                    <% } %>
              </div>
            </div>

            <!-- ========================================== -->
            <!-- SECTION 8: EXAM RESOURCES -->
            <!-- ========================================== -->
            <div class="admin-section d-none" id="sec-resources">
              <!-- Add Resource Card Form -->
              <div class="admin-card mb-4">
                <div class="mb-3">
                  <h4 class="fw-bold text-white fs-6 mb-0"><i class="fa-solid fa-book-open text-info me-2"></i>Add Exam
                    Resource Card</h4>
                  <span class="text-muted small">Add a new resource card that will display on the /resources
                    page.</span>
                </div>
                <form id="addResourceForm" onsubmit="addResourceCard(event)">
                  <div class="row g-3">
                    <div class="col-md-5">
                      <input type="text" class="form-control form-control-dark" id="resTitle"
                        placeholder="Resource Title (e.g. 2026 Official Syllabus PDF) *" required>
                    </div>
                    <div class="col-md-4">
                      <input type="text" class="form-control form-control-dark" id="resExam"
                        placeholder="Exam Name (e.g. GATE CSE, JEE Main, UPSC) *" required>
                    </div>
                    <div class="col-md-3">
                      <button type="submit" class="btn btn-gradient-primary w-100">
                        <i class="fa-solid fa-plus me-1"></i> Add Card
                      </button>
                    </div>
                  </div>
                  <div class="row g-3 mt-1">
                    <div class="col-md-3">
                      <select class="form-select form-select-dark" id="resCategory">
                        <option value="PYQ">Previous Year Papers (PYQ)</option>
                        <option value="SYLLABUS">Official Syllabus</option>
                        <option value="NOTIFICATION">Exam Notification</option>
                        <option value="ANSWER_KEY">Answer Key</option>
                        <option value="NOTES">Study Notes & Material</option>
                        <option value="CUTOFF">Cut-offs & Stats</option>
                        <option value="RESULT">Results & Scorecard</option>
                      </select>
                    </div>
                    <div class="col-md-2">
                      <input type="number" class="form-control form-control-dark" id="resYear"
                        placeholder="Year (e.g. 2026)" value="2026">
                    </div>
                    <div class="col-md-4">
                      <input type="url" class="form-control form-control-dark" id="resUrl"
                        placeholder="Official / Download URL *" required>
                    </div>
                    <div class="col-md-3">
                      <input type="text" class="form-control form-control-dark" id="resDesc"
                        placeholder="Short description (optional)">
                    </div>
                  </div>
                </form>
              </div>

              <!-- Resources List Table -->
              <div class="admin-card">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                  <h4 class="fw-bold text-white fs-6 mb-0">
                    <i class="fa-solid fa-list text-primary me-2"></i>All Active Resource Cards
                    (<%= typeof resources !=='undefined' ? resources.length : 0 %>)
                  </h4>
                  <a href="/resources" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3"
                    style="font-size: 11px;">
                    <i class="fa-solid fa-eye me-1"></i> View /resources Page
                  </a>
                </div>

                <% if (typeof resources !=='undefined' && resources.length) { %>
                  <div class="table-responsive">
                    <table class="table table-custom mb-0">
                      <thead>
                        <tr>
                          <th>Title</th>
                          <th>Exam</th>
                          <th>Category</th>
                          <th>Year</th>
                          <th class="text-end">Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% resources.forEach(function(r) { %>
                          <tr id="res-row-<%= r.id %>">
                            <td>
                              <div class="fw-bold text-white">
                                <%= r.title %>
                              </div>
                              <a href="<%= r.officialUrl %>" target="_blank"
                                class="text-info text-decoration-none small" style="font-size: 11px;">
                                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>
                                <%= r.officialUrl %>
                              </a>
                            </td>
                            <td>
                              <span class="badge bg-secondary bg-opacity-25 text-white rounded-pill px-2"
                                style="font-size: 10px;">
                                <%= r.exam %>
                              </span>
                            </td>
                            <td>
                              <span class="badge bg-primary bg-opacity-25 text-primary rounded-pill px-2"
                                style="font-size: 10px;">
                                <%= r.category %>
                              </span>
                            </td>
                            <td class="text-white-50 small">
                              <%= r.latestYear || '-' %>
                            </td>
                            <td class="text-end">
                              <button class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2"
                                onclick="deleteResourceCard('<%= r.id %>')" style="font-size: 11px;">
                                <i class="fa-solid fa-trash"></i>
                              </button>
                            </td>
                          </tr>
                          <% }); %>
                      </tbody>
                    </table>
                  </div>
                  <% } else { %>
                    <div class="text-center py-5 text-muted">
                      <div class="fs-2 mb-2">📚</div>
                      <p class="small mb-0">No resource cards added yet. Use the form above to add the first card.</p>
                    </div>
                    <% } %>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- MODALS -->
      <!-- ========================================== -->

      <!-- Modal: Add Past Session -->
      <div class="modal fade" id="addPastModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content modal-content-dark">
            <div class="modal-header modal-header-dark">
              <h5 class="modal-title fw-bold text-white fs-6"><i class="fa-solid fa-film text-primary me-2"></i>Add Past
                Recorded Session</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="addPastSessionForm" onsubmit="addPastSession(event)">
              <div class="modal-body p-3">
                <div class="mb-3">
                  <label class="form-label text-white-50 small fw-semibold">YouTube Video URL *</label>
                  <input type="text" class="form-control form-control-dark" id="pastYtUrl"
                    placeholder="https://www.youtube.com/watch?v=..." required>
                </div>
                <div class="mb-3">
                  <label class="form-label text-white-50 small fw-semibold">Title *</label>
                  <input type="text" class="form-control form-control-dark" id="pastTitle"
                    placeholder="e.g. 10 Hours All Night Study Challenge" required>
                </div>
                <div class="row g-2 mb-3">
                  <div class="col-6">
                    <label class="form-label text-white-50 small fw-semibold">Duration</label>
                    <input type="text" class="form-control form-control-dark" id="pastDuration"
                      placeholder="e.g. 5 Hours">
                  </div>
                  <div class="col-6">
                    <label class="form-label text-white-50 small fw-semibold">Custom Thumbnail URL</label>
                    <input type="text" class="form-control form-control-dark" id="pastThumbnail"
                      placeholder="Leave empty for auto">
                  </div>
                </div>
              </div>
              <div class="modal-footer modal-footer-dark">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3"
                  data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-gradient-primary btn-sm rounded-pill px-4">Save Session</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Modal: Add Product -->
      <div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content modal-content-dark">
            <div class="modal-header modal-header-dark">
              <h5 class="modal-title fw-bold text-white fs-6"><i class="fa-solid fa-plus text-primary me-2"></i>Add New Product</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="createProductForm" onsubmit="createProduct(event)">
              <div class="modal-body p-3">

                <!-- Image Upload Area -->
                <div class="mb-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px dashed rgba(255,255,255,0.15);">
                  <label class="form-label text-white-50 small fw-semibold d-flex justify-content-between align-items-center mb-2">
                    <span><i class="fa-solid fa-image text-primary me-1"></i> Product Images</span>
                    <span class="text-muted" style="font-size: 11px;">Upload up to 4 images or paste URL</span>
                  </label>
                  <div class="d-flex gap-2 mb-2 flex-wrap" id="addProdImgPreviews">
                    <div class="prod-img-slot" style="width:72px;height:72px;border-radius:8px;overflow:hidden;background:#0d121f;border:2px dashed rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative;" onclick="document.getElementById('addProdFileInput').click()">
                      <i class="fa-solid fa-plus text-muted fs-5"></i>
                    </div>
                  </div>
                  <input type="file" id="addProdFileInput" accept="image/*" class="d-none" multiple onchange="handleAddProdImageUpload(this)">
                  <div class="input-group input-group-sm">
                    <input type="text" class="form-control form-control-dark" id="addProdImageUrl"
                      placeholder="Or paste image URL: https://...">
                    <button type="button" class="btn btn-outline-primary btn-sm px-3" onclick="addProdUrlImage()">
                      <i class="fa-solid fa-link me-1"></i> Add URL
                    </button>
                  </div>
                  <input type="hidden" id="addProdImagesJson" value="[]">
                </div>

                <!-- Name + Category -->
                <div class="row g-2 mb-3">
                  <div class="col-md-8">
                    <label class="form-label text-white-50 small fw-semibold">Product Name *</label>
                    <input type="text" class="form-control form-control-dark" id="prodName" required
                      placeholder="e.g. Insulated Water Bottle 750ml">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-white-50 small fw-semibold">Category</label>
                    <select class="form-select form-select-dark" id="prodCat">
                      <option value="notebooks">Notebooks</option>
                      <option value="bottles">Bottles</option>
                      <option value="bags">Bags</option>
                      <option value="essentials">Essentials</option>
                      <option value="stationery">Stationery</option>
                    </select>
                  </div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                  <label class="form-label text-white-50 small fw-semibold">Description</label>
                  <textarea class="form-control form-control-dark" id="prodDesc" rows="2"
                    placeholder="Brief product description for the store listing..."></textarea>
                </div>

                <!-- Price + MRP + Stock -->
                <div class="row g-2 mb-3">
                  <div class="col-md-4">
                    <label class="form-label text-white-50 small fw-semibold">Sale Price (₹) *</label>
                    <input type="number" class="form-control form-control-dark" id="prodPrice" required
                      placeholder="499" min="1">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-white-50 small fw-semibold">MRP / Original (₹)</label>
                    <input type="number" class="form-control form-control-dark" id="prodOrig"
                      placeholder="699" min="1">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-white-50 small fw-semibold">Stock Quantity *</label>
                    <input type="number" class="form-control form-control-dark" id="prodStock" required
                      value="25" min="0">
                  </div>
                </div>

                <!-- Badge -->
                <div class="row g-2">
                  <div class="col-md-4">
                    <label class="form-label text-white-50 small fw-semibold">Badge Type</label>
                    <select class="form-select form-select-dark" id="prodBadge">
                      <option value="">None</option>
                      <option value="top">Top</option>
                      <option value="hot">Hot</option>
                      <option value="new">New</option>
                      <option value="sale">Sale</option>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-white-50 small fw-semibold">Badge Label</label>
                    <input type="text" class="form-control form-control-dark" id="prodBadgeLabel"
                      placeholder="e.g. Best Seller">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-white-50 small fw-semibold">Emoji</label>
                    <input type="text" class="form-control form-control-dark" id="prodEmoji" value="✨"
                      placeholder="✨" style="font-size: 1.2rem;">
                  </div>
                </div>

              </div>
              <div class="modal-footer modal-footer-dark">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" id="createProductBtn" class="btn btn-gradient-primary btn-sm rounded-pill px-4">
                  <i class="fa-solid fa-plus me-1"></i> Create Product
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Modal: Edit Product -->
      <div class="modal fade" id="editProductModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content modal-content-dark">
            <div class="modal-header modal-header-dark">
              <h5 class="modal-title fw-bold text-white fs-6"><i class="fa-solid fa-pen-to-square text-warning me-2"></i>Edit Product</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="editProductForm" onsubmit="saveEditProduct(event)">
              <input type="hidden" id="editProdId">
              <div class="modal-body p-3">

                <!-- Image Management -->
                <div class="mb-3 p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px dashed rgba(255,255,255,0.15);">
                  <label class="form-label text-white-50 small fw-semibold d-flex justify-content-between align-items-center mb-2">
                    <span><i class="fa-solid fa-images text-warning me-1"></i> Product Images</span>
                    <span class="text-muted" style="font-size: 11px;">Click × to remove · Upload or paste URL to add</span>
                  </label>
                  <div class="d-flex gap-2 flex-wrap mb-2" id="editProdImgPreviews"></div>
                  <input type="file" id="editProdFileInput" accept="image/*" class="d-none" multiple onchange="handleEditProdImageUpload(this)">
                  <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-warning btn-sm px-3" onclick="document.getElementById('editProdFileInput').click()">
                      <i class="fa-solid fa-upload me-1"></i> Upload Image
                    </button>
                    <input type="text" class="form-control form-control-dark" id="editProdImageUrl" placeholder="Or paste image URL...">
                    <button type="button" class="btn btn-outline-primary btn-sm px-3" onclick="editProdAddUrl()">
                      <i class="fa-solid fa-link"></i>
                    </button>
                  </div>
                  <input type="hidden" id="editProdImagesJson" value="[]">
                </div>

                <!-- Name + Category -->
                <div class="row g-2 mb-3">
                  <div class="col-md-8">
                    <label class="form-label text-white-50 small fw-semibold">Product Name *</label>
                    <input type="text" class="form-control form-control-dark" id="editProdName" required>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-white-50 small fw-semibold">Category</label>
                    <select class="form-select form-select-dark" id="editProdCat">
                      <option value="notebooks">Notebooks</option>
                      <option value="bottles">Bottles</option>
                      <option value="bags">Bags</option>
                      <option value="essentials">Essentials</option>
                      <option value="stationery">Stationery</option>
                    </select>
                  </div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                  <label class="form-label text-white-50 small fw-semibold">Description</label>
                  <textarea class="form-control form-control-dark" id="editProdDesc" rows="2"
                    placeholder="Product description..."></textarea>
                </div>

                <!-- Price + MRP + Stock -->
                <div class="row g-2 mb-3">
                  <div class="col-md-4">
                    <label class="form-label text-white-50 small fw-semibold">Sale Price (₹) *</label>
                    <input type="number" class="form-control form-control-dark" id="editProdPrice" required min="1">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-white-50 small fw-semibold">MRP / Original (₹)</label>
                    <input type="number" class="form-control form-control-dark" id="editProdOrig" min="1">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-white-50 small fw-semibold">Stock Quantity *</label>
                    <input type="number" class="form-control form-control-dark" id="editProdStock" required min="0">
                  </div>
                </div>

                <!-- Badge -->
                <div class="row g-2">
                  <div class="col-md-4">
                    <label class="form-label text-white-50 small fw-semibold">Badge Type</label>
                    <select class="form-select form-select-dark" id="editProdBadge">
                      <option value="">None</option>
                      <option value="top">Top</option>
                      <option value="hot">Hot</option>
                      <option value="new">New</option>
                      <option value="sale">Sale</option>
                    </select>

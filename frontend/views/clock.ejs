      <!-- Stopwatch Section -->
      <div class="col-lg-4">
        <div class="clock-feature-card text-center">
          <h6 class="fw-bold mb-3 text-start text-dark"><i class="fa-solid fa-stopwatch me-1.5 text-warning"></i> Stopwatch</h6>
          <div class="stopwatch-display mb-3" id="sw-display">00:00.00</div>
          <div class="d-flex justify-content-center gap-2 mb-3">
            <button class="btn btn-success btn-sm rounded-pill px-3 py-1.5 fw-bold" id="sw-start-btn" onclick="toggleStopwatch()">Start</button>

<%- include('partials/header') %>

<!-- Top Hero Banner (Compact & Animated with 2 AM Study - Matches Music, Blog, & About) -->
<section class="hero-clock-section">
  <div class="container text-center">
    <div class="hero-clock-badge">
      <span class="pulse-dot"></span>
      <span>2 AM Study Focus Studio</span>
      <i class="fa-solid fa-clock text-primary ms-1" style="font-size: 0.85rem;"></i>
    </div>
    
    <h1 class="animated-2am-title">
      Digital Clock &amp; <span class="gradient-2am-text">2 AM Study</span> Hub
    </h1>
    
    <p class="hero-clock-subtitle">
      Real-time precision digital clock, interactive calendar, multi-city world clock, stopwatch &amp; exam countdown.
    </p>
  </div>
</section>

<style>
/* Hero Section & Animations (Matches Music & Blog Page Hero) */
@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes pulseGlow {
  0%, 100% { transform: scale(1); opacity: 0.8; }
  50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 10px rgba(37, 99, 235, 0.7); }
}

.hero-clock-section {
  padding: 85px 16px 24px !important;
  background: radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.08) 0%, transparent 65%), #f8fafc;
  border-bottom: 1px solid rgba(15, 23, 42, 0.06);
}

.hero-clock-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #ffffff;
  border: 1px solid rgba(37, 99, 235, 0.2);
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.08);
  border-radius: 50px;
  padding: 5px 14px;
  font-size: 0.82rem;
  font-weight: 700;
  color: #1e40af;
  margin-bottom: 10px;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #2563eb;
  animation: pulseGlow 1.8s infinite ease-in-out;
}

.animated-2am-title {
  font-size: 2.2rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f172a;
  margin-bottom: 6px;
}

.gradient-2am-text {
  background: linear-gradient(135deg, #2563eb 0%, #7c3aed 45%, #ec4899 75%, #2563eb 100%);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: gradientShift 5s ease infinite;
}

.hero-clock-subtitle {
  font-size: 0.92rem;
  color: #64748b;
  max-width: 660px;
  margin: 0 auto;
  line-height: 1.5;
}

@media (max-width: 768px) {
  .animated-2am-title {
    font-size: 1.65rem;
  }
}

/* Page Body */
.clock-hub-page {
  background: #f8fafc;
  min-height: 85vh;
  color: #0f172a;
}

/* Clock Cockpit Stage */
.clock-cockpit-stage {
  background: #0f172a;
  border: 1px solid #334155;
  border-radius: 28px;
  padding: 3rem 2rem;
  box-shadow: 0 20px 40px rgba(15, 23, 42, 0.12);
  position: relative;
  overflow: hidden;
  color: #ffffff;
}

.clock-cockpit-stage::before {
  content: '';
  position: absolute;
  top: -50%;
  left: 50%;
  transform: translateX(-50%);
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.18) 0%, transparent 70%);
  pointer-events: none;
}

.main-clock-display {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  font-size: clamp(3.5rem, 8.5vw, 6.5rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  text-shadow: 0 0 35px rgba(99, 102, 241, 0.5);
  line-height: 1;
  margin-bottom: 0.5rem;
  color: #ffffff;
}

.clock-date-display {
  font-size: 1.2rem;
  color: #94a3b8;
  font-weight: 500;
}

/* Cards System */
.clock-feature-card {
  background: #ffffff;
  border: 1px solid rgba(15, 23, 42, 0.08);
  border-radius: 20px;
  padding: 1.75rem;
  height: 100%;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  transition: all 0.25s ease;
}

.clock-feature-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 16px 32px rgba(15, 23, 42, 0.08);
  border-color: rgba(37, 99, 235, 0.25);
}

/* World Clock */
.world-clock-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
}

.world-clock-item {
  background: #f8fafc;
  padding: 1rem;
  border-radius: 14px;
  border: 1px solid #e2e8f0;
  transition: all 0.2s ease;
}

.world-clock-item:hover {
  border-color: #93c5fd;
  background: #ffffff;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.06);
}

.world-label {
  color: #64748b;
  font-weight: 700;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 0.25rem;
}

.world-time {
  font-weight: 800;
  color: #1e40af;
  font-size: 1.25rem;
}

/* Stopwatch */
.stopwatch-display {
  font-size: 3.2rem;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: #0f172a;
  letter-spacing: -0.02em;
}

.laps-container {
  max-height: 140px;
  overflow-y: auto;
  margin-top: 1rem;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 0.5rem;
}

.lap-item {
  display: flex;
  justify-content: space-between;
  padding: 0.4rem 0.6rem;
  border-bottom: 1px solid #e2e8f0;
  font-size: 0.85rem;
  color: #475569;
}

/* Calendar */
.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
  text-align: center;
}

.calendar-day-label {
  font-size: 0.75rem;
  font-weight: 700;
  color: #2563eb;
  padding-bottom: 4px;
}

.calendar-day {
  padding: 0.45rem;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 600;
  color: #334155;
  cursor: pointer;
  transition: all 0.15s ease;
  position: relative;
}

.calendar-day:hover {
  background: #f1f5f9;
  color: #0f172a;
}

.calendar-day.today {
  background: #2563eb;
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.35);
}

.calendar-day.special-event {
  background: linear-gradient(135deg, #f43f5e, #fb923c);
  color: white;
  font-weight: 800;
}

.event-dot {
  position: absolute;
  bottom: 2px;
  left: 50%;
  transform: translateX(-50%);
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #ffffff;
}

.calendar-day.other-month {
  opacity: 0.25;
}

/* Today's Focus */
.focus-widget-container {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 999px;
  padding: 0.4rem 0.5rem 0.4rem 1.75rem;
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 580px;
  transition: all 0.3s ease;
}

.focus-widget-container:focus-within {
  background: rgba(255, 255, 255, 0.14);
  border-color: #818cf8;
  box-shadow: 0 0 20px rgba(129, 140, 248, 0.4);
}

.focus-input {
  background: transparent;
  border: none;
  color: #ffffff;
  font-size: 1rem;
  font-weight: 500;
  width: 100%;
  outline: none;
}

.focus-input::placeholder { color: rgba(255, 255, 255, 0.45); }

.focus-complete-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, 0.1);
  color: #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 0.75rem;
  transition: all 0.2s ease;
  cursor: pointer;
  flex-shrink: 0;
}

.focus-complete-btn:hover {
  background: #10b981;
  color: white;
}

.focus-widget-container.completed {
  border-color: #10b981;
  background: rgba(16, 185, 129, 0.12);
}

.focus-widget-container.completed .focus-input {
  text-decoration: line-through;
  color: #34d399;
}

.focus-widget-container.completed .focus-complete-btn {
  background: #10b981;
  color: white;
}

/* Fullscreen Mode */
#clockHubCenterpiece:fullscreen {
  background: #090d16 !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  width: 100vw !important;
  height: 100vh !important;
  padding: 3rem !important;
  border-radius: 0 !important;
}

#clockHubCenterpiece:fullscreen .main-clock-display {
  font-size: min(20vw, 20vh) !important;
  text-shadow: 0 0 50px rgba(99, 102, 241, 0.7) !important;
}

#clockHubCenterpiece:fullscreen .clock-date-display {
  font-size: min(3.5vw, 3.5vh) !important;
  margin-top: 1rem !important;
}
</style>

<main class="clock-hub-page py-5 my-0">

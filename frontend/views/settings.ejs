<%- include('partials/header') %>

<section class="py-5 bg-light pb-4" style="padding-top: 90px !important;">
  <div class="container py-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
      <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-secondary bg-opacity-10 text-dark mb-2 fw-semibold small">
          ⚙️ Account Settings
        </div>
        <h1 class="display-6 fw-extrabold text-dark mb-1">Profile & Preferences</h1>
        <p class="text-muted small mb-0">Manage your profile, notification delivery channels, and Student Safety alerts.</p>
      </div>
      <a href="/profile" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
        👤 View Profile
      </a>
    </div>
  </div>
</section>

<main class="container py-5">
  <div class="row justify-content-center g-4">
    <div class="col-lg-8">
      
      <div id="settingsAlert" class="alert border-0 rounded-3 p-3 small mb-4 d-none"></div>

      <!-- Settings Card: Edit Profile -->
      <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5 mb-4">
        <h2 class="h5 fw-bold text-dark mb-4">👤 Edit Profile Information</h2>

        <form id="settingsForm">
          <div class="mb-3">
            <label for="settingsName" class="form-label fw-semibold text-dark small">Display Name</label>
            <input type="text" class="form-control py-2" id="settingsName" placeholder="Your name">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold text-dark small">Email Address</label>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <input type="email" class="form-control py-2 bg-light flex-grow-1" id="settingsEmail" disabled readonly>
              <button type="button" id="changeEmailToggleBtn" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold flex-shrink-0">
                ✏️ Change Email
              </button>
            </div>
            <div class="form-text small text-muted">A verification link will be sent to your new address. Your email won't change until you click it.</div>
          </div>

          <!-- Change Email Secure Panel -->
          <div id="changeEmailPanel" class="d-none border rounded-4 p-4 mb-3" style="background:#f8fafc;">
            <p class="fw-bold text-dark mb-3" style="font-size:0.9rem;">🔐 Change Email Address</p>

            <div id="changeEmailAlert" class="alert border-0 rounded-3 p-3 small mb-3 d-none"></div>

            <div class="mb-3">
              <label for="newEmailInput" class="form-label small fw-semibold text-dark">New Email Address</label>
              <input type="email" class="form-control py-2" id="newEmailInput" placeholder="new@example.com" autocomplete="off">
            </div>
            <div class="mb-3">
              <label for="confirmNewEmailInput" class="form-label small fw-semibold text-dark">Confirm New Email</label>
              <input type="email" class="form-control py-2" id="confirmNewEmailInput" placeholder="Re-enter new email" autocomplete="off">
            </div>

            <!-- Shown only for email/password accounts -->
            <div id="currentPasswordSection" class="mb-3 d-none">
              <label for="currentPasswordForEmail" class="form-label small fw-semibold text-dark">Current Password <span class="text-danger">*</span></label>
              <input type="password" class="form-control py-2" id="currentPasswordForEmail" placeholder="Enter your current password" autocomplete="current-password">
              <div class="form-text small">Required to verify your identity before changing email.</div>
            </div>

            <!-- Shown only for Google-only accounts -->
            <div id="googleReauthNote" class="mb-3 d-none">
              <div class="alert alert-info border-0 rounded-3 p-3 small mb-0">
                <strong><i class="fa-brands fa-google me-1"></i> Google Account:</strong> You'll be prompted to re-authenticate with Google to confirm your identity.
              </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
              <button type="button" id="submitEmailChangeBtn" class="btn btn-primary rounded-pill px-4 fw-bold">
                Send Verification Link
              </button>
              <button type="button" id="cancelEmailChangeBtn" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold">
                Cancel
              </button>
            </div>
          </div>

          <div class="mb-4">
            <label for="settingsCollege" class="form-label fw-semibold text-dark small">College / Institution</label>
            <input type="text" class="form-control py-2" id="settingsCollege" placeholder="e.g. Delhi University, IIT Bombay">
          </div>

          <button type="submit" id="saveSettingsBtn" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm">
            Save Changes
          </button>
        </form>
      </div>

      <!-- Notification Preferences Card (Push First, Email Fallback) -->
      <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
          <div>
            <h2 class="h5 fw-bold text-dark mb-1">🔔 Smart Notification Preferences</h2>
            <p class="text-muted small mb-0">Configured with <strong>Push-First, Email-Fallback</strong> strategy. You will never receive duplicate notifications.</p>
          </div>
          <span id="pushStatusBadge" class="badge bg-secondary rounded-pill px-3 py-2">Checking Browser Push...</span>
        </div>

        <hr class="my-4">

        <!-- Browser Push Toggle & Permission Button -->
        <div class="p-3 bg-light rounded-4 mb-4">
          <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-3">
            <div>
              <div class="fw-bold text-dark mb-1">🚀 Browser Push Notifications (Priority 1)</div>
              <div class="text-muted small">Receive instant alerts directly in your browser even when 2AM Study is running in background.</div>
            </div>
            <div class="form-check form-switch fs-4">
              <input class="form-check-input" type="checkbox" role="switch" id="togglePushEnabled" checked>
            </div>
          </div>
          
          <div class="d-flex gap-2 flex-wrap align-items-center">
            <button type="button" id="requestPushBtn" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">
              🔔 Enable Push Notifications
            </button>
            <button type="button" id="testPushBtn" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">
              🧪 Send Test Push
            </button>
          </div>
        </div>

        <!-- Email Notifications Toggle (Fallback) -->
        <div class="d-flex align-items-center justify-content-between py-3 border-bottom flex-wrap gap-3">
          <div>
            <div class="fw-bold text-dark mb-1">📧 Email Notifications (Priority 2 Fallback)</div>
            <div class="text-muted small">Sent automatically only if Push Notifications are unavailable, blocked, or disabled.</div>
          </div>
          <div class="form-check form-switch fs-4">
            <input class="form-check-input" type="checkbox" role="switch" id="toggleEmailNotifications" checked>
          </div>
        </div>

        <!-- Student Safety Alerts Toggle -->
        <div class="d-flex align-items-center justify-content-between py-3 border-bottom flex-wrap gap-3">
          <div>
            <div class="fw-bold text-dark mb-1">🛡️ Fake Profile Report Alerts</div>
            <div class="text-muted small">Receive email alerts when admin verifies a fake profile — includes a direct link to report the impersonator on Instagram/other platforms. <span class="text-danger fw-semibold">Turning this off means you won't get community safety alerts.</span></div>
          </div>
          <div class="form-check form-switch fs-4">
            <input class="form-check-input" type="checkbox" role="switch" id="toggleSafetyAlerts" checked>
          </div>
        </div>

        <div class="mt-4 text-end">
          <button type="button" id="saveNotifPrefsBtn" class="btn btn-dark rounded-pill px-4 py-2 fw-bold shadow-sm">
            Save Preferences
          </button>
        </div>
      </div>

    </div>
  </div>
</main>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-app.js";
  import {
    getAuth,
    onAuthStateChanged,
    updateProfile,
    verifyBeforeUpdateEmail,
    reauthenticateWithCredential,
    reauthenticateWithPopup,
    EmailAuthProvider,
    GoogleAuthProvider
  } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-auth.js";
  import { getFirestore, doc, getDoc, setDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyCvJRS3UusvUrVCd2JSicBGL-uRD82GpNM",
    authDomain: "am-study-7ea87.firebaseapp.com",
    projectId: "am-study-7ea87",
    storageBucket: "am-study-7ea87.firebasestorage.app",
    messagingSenderId: "270924691236",
    appId: "1:270924691236:web:7ada12dcf50c290d0925b1"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);

  const form = document.getElementById('settingsForm');
  const alertEl = document.getElementById('settingsAlert');
  const saveBtn = document.getElementById('saveSettingsBtn');
  const pushBadge = document.getElementById('pushStatusBadge');
  const requestPushBtn = document.getElementById('requestPushBtn');
  const testPushBtn = document.getElementById('testPushBtn');
  const saveNotifPrefsBtn = document.getElementById('saveNotifPrefsBtn');

  let currentSubscription = null;

  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
    const rawData = window.atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) {
      outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
  }

  function updatePushBadge() {
    if (!('Notification' in window) || !('serviceWorker' in navigator)) {
      pushBadge.className = 'badge bg-danger rounded-pill px-3 py-2';
      pushBadge.textContent = '❌ Push Unsupported';
      requestPushBtn.disabled = true;
      return;
    }

    if (Notification.permission === 'granted') {
      pushBadge.className = 'badge bg-success rounded-pill px-3 py-2';
      pushBadge.textContent = '✅ Push Permission Granted';
      requestPushBtn.textContent = '✅ Push Active';
      requestPushBtn.className = 'btn btn-sm btn-success rounded-pill px-3 fw-bold';
    } else if (Notification.permission === 'denied') {
      pushBadge.className = 'badge bg-danger rounded-pill px-3 py-2';
      pushBadge.textContent = '🚫 Push Blocked';
      requestPushBtn.textContent = '⚠️ Blocked in Browser';
      requestPushBtn.className = 'btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold';
    } else {
      pushBadge.className = 'badge bg-warning text-dark rounded-pill px-3 py-2';
      pushBadge.textContent = '⚡ Permission Needed';
    }
  }

  async function registerAndSubscribePush() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      alert('Browser Push Notifications are not supported on this browser.');
      return null;
    }

    try {
      const permission = await Notification.requestPermission();
      updatePushBadge();
      if (permission !== 'granted') {
        alert('Notification permission was not granted.');
        return null;
      }

      const reg = await navigator.serviceWorker.register('/firebase-messaging-sw.js');
      await navigator.serviceWorker.ready;

      // Fetch VAPID public key
      const vapidRes = await fetch('/api/student-safety/vapid-public-key');
      const vapidData = await vapidRes.json();

      let sub = await reg.pushManager.getSubscription();
      if (!sub && vapidData.publicKey) {
        sub = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(vapidData.publicKey)
        });
      }
      currentSubscription = sub;
      return sub;
    } catch (err) {
      console.error("Push registration error:", err);
      alert('Could not enable Push Notifications: ' + err.message);
      return null;
    }
  }

  onAuthStateChanged(auth, async (user) => {
    if (!user) {
      window.location.href = '/login?redirect=/settings';
      return;
    }

    document.getElementById('settingsEmail').value = user.email;
    document.getElementById('settingsName').value = user.displayName || user.email.split('@')[0];

    // ── Email sync: if Firebase Auth email changed after verification, sync cache & Firestore ──
    const cachedEmail = localStorage.getItem('studentEmail');
    if (cachedEmail && cachedEmail !== user.email) {
      localStorage.setItem('studentEmail', user.email);
      try {
        await setDoc(doc(db, 'users', user.uid), {
          email: user.email,
          emailVerified: user.emailVerified,
          updatedAt: serverTimestamp()
        }, { merge: true });
      } catch (syncErr) {
        console.warn('Email sync warning:', syncErr);
      }
    }

    // ── Detect auth provider and show appropriate change-email UI ──
    const isPasswordUser = user.providerData.some(p => p.providerId === 'password');
    const isGoogleOnly   = user.providerData.every(p => p.providerId === 'google.com');

    if (isPasswordUser) {
      document.getElementById('currentPasswordSection').classList.remove('d-none');
    }
    if (isGoogleOnly) {
      document.getElementById('googleReauthNote').classList.remove('d-none');
    }

    updatePushBadge();

    try {
      const snap = await getDoc(doc(db, "users", user.uid));
      if (snap.exists()) {
        const data = snap.data();
        if (data.college) document.getElementById('settingsCollege').value = data.college;
        if (data.pushEnabled !== undefined) document.getElementById('togglePushEnabled').checked = data.pushEnabled;
        if (data.emailNotifications !== undefined) document.getElementById('toggleEmailNotifications').checked = data.emailNotifications;
        if (data.safetyAlerts !== undefined) document.getElementById('toggleSafetyAlerts').checked = data.safetyAlerts;
        if (data.pushSubscription) currentSubscription = data.pushSubscription;
      }
    } catch (e) {
      console.warn("Settings fetch warning:", e);
    }
  });

  requestPushBtn.addEventListener('click', async () => {
    requestPushBtn.disabled = true;
    requestPushBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Enabling...`;
    const sub = await registerAndSubscribePush();
    if (sub && auth.currentUser) {
      // Save subscription to backend
      await fetch('/api/student-safety/save-push-token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          userId: auth.currentUser.uid,
          userEmail: auth.currentUser.email,
          pushSubscription: sub,
          pushEnabled: true,
          emailNotifications: document.getElementById('toggleEmailNotifications').checked,
          safetyAlerts: document.getElementById('toggleSafetyAlerts').checked
        })
      });
      alert('✅ Browser Push Notifications enabled successfully!');
    }
    requestPushBtn.disabled = false;
    updatePushBadge();
  });

  testPushBtn.addEventListener('click', async () => {
    const user = auth.currentUser;
    let sub = currentSubscription;
    if (!sub) {
      sub = await registerAndSubscribePush();
    }
    if (!sub) {
      alert('Please enable Push Notifications first before testing.');
      return;
    }

    testPushBtn.disabled = true;
    testPushBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Sending...`;

    try {
      const res = await fetch('/api/student-safety/test-push', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          pushSubscription: sub,
          userId: user ? user.uid : 'anonymous',
          userEmail: user ? user.email : null
        })
      });
      const data = await res.json();
      if (data.success) {
        alert('🚀 Test push notification triggered! Check your browser notifications.');
      } else {
        alert('❌ Test push failed: ' + data.message);
      }
    } catch (err) {
      alert('Error sending test push: ' + err.message);
    } finally {
      testPushBtn.disabled = false;
      testPushBtn.textContent = '🧪 Send Test Push';
    }
  });

  saveNotifPrefsBtn.addEventListener('click', async () => {
    const user = auth.currentUser;
    if (!user) return;

    const pushEnabled = document.getElementById('togglePushEnabled').checked;
    const emailNotifications = document.getElementById('toggleEmailNotifications').checked;
    const safetyAlerts = document.getElementById('toggleSafetyAlerts').checked;

    saveNotifPrefsBtn.disabled = true;
    saveNotifPrefsBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Saving...`;

    try {
      // Save to Firestore
      await setDoc(doc(db, "users", user.uid), {
        pushEnabled,
        emailNotifications,
        safetyAlerts,
        updatedAt: serverTimestamp()
      }, { merge: true });

      // Sync with backend
      await fetch('/api/student-safety/save-push-token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          userId: user.uid,
          userEmail: user.email,
          pushSubscription: currentSubscription,
          pushEnabled,
          emailNotifications,
          safetyAlerts
        })
      });

      alertEl.className = 'alert alert-success border-0 rounded-3 p-3 small mb-4';
      alertEl.textContent = '✅ Notification preferences saved successfully!';
      alertEl.classList.remove('d-none');
    } catch (err) {
      alertEl.className = 'alert alert-danger border-0 rounded-3 p-3 small mb-4';
      alertEl.textContent = 'Failed to save preferences: ' + err.message;
      alertEl.classList.remove('d-none');
    } finally {
      saveNotifPrefsBtn.disabled = false;
      saveNotifPrefsBtn.textContent = 'Save Preferences';
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const user = auth.currentUser;
    if (!user) return;

    const newName = document.getElementById('settingsName').value.trim();
    const newCollege = document.getElementById('settingsCollege').value.trim();

    saveBtn.disabled = true;
    saveBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Saving...`;

    try {
      await updateProfile(user, { displayName: newName });
      
      await setDoc(doc(db, "users", user.uid), {
        displayName: newName,
        college: newCollege,
        updatedAt: serverTimestamp()
      }, { merge: true });

      localStorage.setItem('studentName', newName);
      if (newCollege) localStorage.setItem('studentCollege', newCollege);

      alertEl.className = 'alert alert-success border-0 rounded-3 p-3 small mb-4';
      alertEl.textContent = '✅ Profile settings saved successfully!';
      alertEl.classList.remove('d-none');

    } catch (err) {
      alertEl.className = 'alert alert-danger border-0 rounded-3 p-3 small mb-4';
      alertEl.textContent = err.message || 'Failed to update settings.';
      alertEl.classList.remove('d-none');
    } finally {
      saveBtn.disabled = false;
      saveBtn.innerText = 'Save Changes';
    }
  });
  // ── Secure Change Email Feature ──────────────────────────────────────────
  const changeEmailToggleBtn  = document.getElementById('changeEmailToggleBtn');
  const changeEmailPanel      = document.getElementById('changeEmailPanel');
  const cancelEmailChangeBtn  = document.getElementById('cancelEmailChangeBtn');
  const submitEmailChangeBtn  = document.getElementById('submitEmailChangeBtn');
  const changeEmailAlert      = document.getElementById('changeEmailAlert');

  function showCEAlert(type, message) {
    changeEmailAlert.className = `alert alert-${type} border-0 rounded-3 p-3 small mb-3`;
    changeEmailAlert.textContent = message;
    changeEmailAlert.classList.remove('d-none');
  }

  function clearCEPanel() {
    document.getElementById('newEmailInput').value = '';
    document.getElementById('confirmNewEmailInput').value = '';
    const pwField = document.getElementById('currentPasswordForEmail');
    if (pwField) pwField.value = '';
    changeEmailAlert.classList.add('d-none');
  }

  // Toggle open/close
  changeEmailToggleBtn.addEventListener('click', () => {
    const isOpen = !changeEmailPanel.classList.contains('d-none');
    changeEmailPanel.classList.toggle('d-none', isOpen);
    changeEmailToggleBtn.textContent = isOpen ? '✏️ Change Email' : '✖ Close';
    if (!isOpen) clearCEPanel();
  });

  cancelEmailChangeBtn.addEventListener('click', () => {
    changeEmailPanel.classList.add('d-none');
    changeEmailToggleBtn.textContent = '✏️ Change Email';
    clearCEPanel();
  });

  submitEmailChangeBtn.addEventListener('click', async () => {
    const user = auth.currentUser;
    if (!user) return;

    const newEmail     = document.getElementById('newEmailInput').value.trim().toLowerCase();
    const confirmEmail = document.getElementById('confirmNewEmailInput').value.trim().toLowerCase();
    const emailRegex   = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    // ── Client-side validation ──
    if (!newEmail || !emailRegex.test(newEmail)) {
      showCEAlert('danger', '❌ Please enter a valid email address.'); return;
    }
    if (newEmail !== confirmEmail) {
      showCEAlert('danger', '❌ Email addresses do not match. Please re-enter.'); return;
    }
    if (newEmail === (user.email || '').toLowerCase()) {
      showCEAlert('warning', '⚠️ The new email is the same as your current email.'); return;
    }

    submitEmailChangeBtn.disabled = true;
    submitEmailChangeBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Sending...`;
    changeEmailAlert.classList.add('d-none');

    const isPasswordUser = user.providerData.some(p => p.providerId === 'password');
    const isGoogleUser   = user.providerData.some(p => p.providerId === 'google.com');

    try {
      // ── Step 1: Re-authenticate (required by Firebase before sensitive ops) ──
      if (isPasswordUser) {
        const currentPassword = document.getElementById('currentPasswordForEmail').value;
        if (!currentPassword) {
          showCEAlert('danger', '❌ Please enter your current password to continue.');
          return;
        }
        const credential = EmailAuthProvider.credential(user.email, currentPassword);
        await reauthenticateWithCredential(user, credential);

      } else if (isGoogleUser) {
        const provider = new GoogleAuthProvider();
        await reauthenticateWithPopup(user, provider);
      }

      // ── Step 2: Send verification to the NEW email ──
      // Firebase Auth sends a link to newEmail.
      // The email in Firebase Auth ONLY changes after the user clicks that link.
      // We do NOT touch Firestore or localStorage here.
      await verifyBeforeUpdateEmail(user, newEmail);

      // ── Step 3: Success message ──
      showCEAlert('success',
        `✅ Verification link sent to ${newEmail}. Please check your new inbox and click the link. ` +
        `Your email won't change until you verify it. Once verified, it will sync automatically on your next login.`
      );
      document.getElementById('newEmailInput').value = '';
      document.getElementById('confirmNewEmailInput').value = '';
      const pwField = document.getElementById('currentPasswordForEmail');
      if (pwField) pwField.value = '';

    } catch (err) {
      console.error('Change email error:', err);
      const errorMessages = {
        'auth/requires-recent-login'  : '🔒 Session expired. Please log out and log back in before changing your email.',
        'auth/email-already-in-use'   : '❌ This email address is already registered to another account.',
        'auth/invalid-email'          : '❌ The email address you entered is not valid.',
        'auth/operation-not-allowed'  : '❌ Email change is currently disabled. Please contact support.',
        'auth/network-request-failed' : '❌ Network error. Please check your connection and try again.',
        'auth/wrong-password'         : '❌ Incorrect current password. Please try again.',
        'auth/invalid-credential'     : '❌ Incorrect current password. Please try again.',
        'auth/popup-closed-by-user'   : '❌ Google sign-in was cancelled. Please try again.',
        'auth/too-many-requests'      : '❌ Too many attempts. Please wait a moment and try again.'
      };
      showCEAlert('danger', errorMessages[err.code] || err.message || 'Failed to send verification link. Please try again.');
    } finally {
      submitEmailChangeBtn.disabled = false;
      submitEmailChangeBtn.textContent = 'Send Verification Link';
    }
  });
</script>

<%- include('partials/footer') %>

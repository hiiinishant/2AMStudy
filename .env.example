# Server Configuration
PORT=3000
NODE_ENV=production
SESSION_SECRET=2am-study-store-secret-key-change-this

# Razorpay Payment Gateway (Student Store)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Email / SMTP Configuration (Nodemailer for contact forms & safety notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
RECEIVER_EMAIL=support@2amstudy.online

# Cloudinary Storage (Student Identity Shield Evidence Uploads)
CLOUDINARY_CLOUD_NAME=2amstudy
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Doubt Solver (Help Bot)
GEMINI_API_KEY=your_gemini_api_key_here

# Student Safety Admin Security
ADMIN_PASSWORD=your_admin_password_here
ADMIN_PASSCODE=2AM-ADMIN-2026

# Optional Services
YOUTUBE_API_KEY=your_youtube_api_key

# Firebase Admin SDK — for Firestore atomic inventory & order persistence
# Option A: paste the full service account JSON as a single-line string
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}
# Option B: point to a downloaded service account key file
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
# If neither is set, inventory falls back to in-memory (no Firestore)
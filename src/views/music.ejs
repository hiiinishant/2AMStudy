        </button>
      </div>

      <!-- Quick Genre Pills -->
      <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <span class="text-muted small fw-semibold me-1"><i class="fa-solid fa-bolt text-warning me-1"></i>Quick Picks:</span>

            </div>
            <div class="card-body p-4 text-center">
              <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-1 mb-2">Classical Focus</span>
              <h5 class="fw-bold text-dark mb-1">Peaceful Piano</h5>

<%- include('partials/header') %>

<!-- Top Hero Banner (Compact & Animated with 2 AM Study) -->
<section class="hero-music-section">
  <div class="container text-center">
    <div class="hero-study-badge">
      <span class="pulse-dot"></span>
      <span>2 AM Study Music Studio</span>
      <div class="eq-mini-bars">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>
    
    <h1 class="animated-2am-title">
      <span class="gradient-2am-text">2 AM Study</span> Focus &amp; Lofi Beats
    </h1>
    
    <p class="hero-music-subtitle">
      Ambient study lofi, deep focus beats &amp; relaxing soundscapes designed to elevate your late-night productivity.
    </p>
  </div>
</section>

<style>
/* Hero Section & Animations */
@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes eqBounce {
  0%, 100% { height: 4px; }
  50% { height: 13px; }
}

@keyframes pulseGlow {
  0%, 100% { transform: scale(1); opacity: 0.8; }
  50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 10px rgba(37, 99, 235, 0.7); }
}

.hero-music-section {
  padding: 85px 16px 24px !important;
  background: radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.08) 0%, transparent 65%), #f8fafc;
  border-bottom: 1px solid rgba(15, 23, 42, 0.06);
}

.hero-study-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #ffffff;
  border: 1px solid rgba(37, 99, 235, 0.2);
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.08);
  border-radius: 50px;
  padding: 5px 14px;
  font-size: 0.82rem;
  font-weight: 700;
  color: #1e40af;
  margin-bottom: 10px;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #2563eb;
  animation: pulseGlow 1.8s infinite ease-in-out;
}

.eq-mini-bars {
  display: inline-flex;
  align-items: flex-end;
  gap: 2px;
  height: 14px;
}

.eq-mini-bars span {
  width: 2.5px;
  background: #2563eb;
  border-radius: 2px;
  animation: eqBounce 1.1s infinite ease-in-out;
}
.eq-mini-bars span:nth-child(1) { animation-delay: 0.1s; }
.eq-mini-bars span:nth-child(2) { animation-delay: 0.35s; }
.eq-mini-bars span:nth-child(3) { animation-delay: 0.2s; }
.eq-mini-bars span:nth-child(4) { animation-delay: 0.45s; }

.animated-2am-title {
  font-size: 2.2rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f172a;
  margin-bottom: 6px;
}

.gradient-2am-text {
  background: linear-gradient(135deg, #2563eb 0%, #7c3aed 45%, #ec4899 75%, #2563eb 100%);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: gradientShift 5s ease infinite;
}

.hero-music-subtitle {
  font-size: 0.92rem;
  color: #64748b;
  max-width: 620px;
  margin: 0 auto;
  line-height: 1.5;
}

@media (max-width: 768px) {
  .animated-2am-title {
    font-size: 1.65rem;
  }
}
.music-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
  align-items: center;
  padding: 1.1rem 1.25rem;
  border: 1px solid rgba(15, 23, 42, 0.08);
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  margin-bottom: 2rem;
}

.music-search-wrap {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex: 1;
  min-width: 260px;
  border: 1.5px solid rgba(15, 23, 42, 0.12);
  border-radius: 14px;
  padding: 0.65rem 1rem;
  background: #f8fafc;
  transition: all 0.2s ease;
}

.music-search-wrap:focus-within {
  border-color: #2563eb;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

.music-search-wrap input {
  border: none;
  background: transparent;
  outline: none;
  width: 100%;
  font-size: 0.95rem;
  color: #0f172a;
}

.music-tag-pill {
  padding: 0.45rem 1rem;
  border-radius: 20px;
  font-size: 0.82rem;
  font-weight: 600;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
  color: #475569;
  cursor: pointer;
  transition: all 0.2s ease;
}

.music-tag-pill:hover {
  background: #2563eb;
  color: #fff;
  border-color: #2563eb;
  transform: translateY(-1px);
}

/* Custom Tabs */
.custom-music-tabs {
  border-bottom: 2px solid #e2e8f0;
  gap: 12px;
  margin-bottom: 2rem;
}

.custom-music-tabs .nav-link {
  font-size: 1rem;
  font-weight: 700;
  padding: 0.85rem 1.6rem;
  color: #64748b;
  border: none;
  border-radius: 12px 12px 0 0;
  background: transparent;
  position: relative;
  transition: all 0.2s ease;
}

.custom-music-tabs .nav-link.active {
  color: #2563eb;
  background: transparent;
}

.custom-music-tabs .nav-link.active::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  right: 0;
  height: 3px;
  background: #2563eb;
  border-radius: 3px 3px 0 0;
}

/* Video & Sound Cards */
.music-card {
  cursor: pointer;
  transition: all 0.25s ease;
  border-radius: 18px !important;
  overflow: hidden;
  border: 1px solid rgba(15, 23, 42, 0.08) !important;
}

.music-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 32px rgba(15, 23, 42, 0.1) !important;
  border-color: rgba(37, 99, 235, 0.3) !important;
}

.music-card-thumb-wrap {
  position: relative;
  width: 100%;
  height: 180px;
  background: #0f172a;
  overflow: hidden;
}

.music-card-thumb-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.music-card:hover .music-card-thumb-wrap img {
  transform: scale(1.05);
}

.music-play-badge {
  position: absolute;
  bottom: 12px;
  right: 12px;
  background: rgba(15, 23, 42, 0.75);
  backdrop-filter: blur(4px);
  color: #fff;
  border-radius: 50px;
  padding: 4px 10px;
  font-size: 0.75rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 4px;
}

.music-card-title {
  font-size: 0.95rem;
  font-weight: 700;
  line-height: 1.35;
  color: #0f172a;
  margin-bottom: 6px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  height: 2.7em;
}

/* Ambient Cards */
.ambient-card {
  border-radius: 20px;
  border: 1px solid rgba(15, 23, 42, 0.08);
  transition: all 0.25s ease;
  cursor: pointer;
}

.ambient-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 30px rgba(15, 23, 42, 0.08);
  border-color: #2563eb;
}

/* Player Wrap (Proportional 16:9 Cinema Screen) */
#ytPlayerWrap {
  background: #0f172a;
  border: 1px solid rgba(255, 255, 255, 0.12);
  width: 100%;
  max-width: 980px;
  margin-left: auto;
  margin-right: auto;
}

.music-player-screen {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #000;
  border-radius: 16px;
  overflow: hidden;
}

.music-player-screen iframe,
.music-player-screen #player {
  position: absolute;
  top: 0;
  left: 0;
  width: 100% !important;
  height: 100% !important;
}
</style>

<main class="container py-5 my-0">


      <!-- Video Player (Shows On Top Above Search Results) -->
      <div id="ytPlayerWrap" class="d-none mb-5 p-3 p-md-4 rounded-4 shadow-lg">
        <div class="music-player-screen shadow-lg border border-secondary border-opacity-25">
          <div id="player"></div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 text-secondary small px-1">
          <span><i class="fa-solid fa-headphones me-1 text-primary"></i> 2 AM Study Focus Studio</span>

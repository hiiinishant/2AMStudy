      <!-- Give Feedback Modal -->
      <div class="modal fade" id="giveFeedbackModal" tabindex="-1" aria-labelledby="giveFeedbackModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content shadow-lg border-0 rounded-4 bg-dark text-white" style="border: 1px solid rgba(255,255,255,0.1) !important;">
            <div class="modal-header border-0 pb-0">
              <h5 class="modal-title fw-bold text-warning" id="giveFeedbackModalLabel">
                ❤️ Share Shopper Feedback
              </h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="shopperFeedbackForm">
              <div class="modal-body py-4">
                <div class="mb-3">
                  <label class="form-label small fw-semibold text-warning">Your Name</label>
                  <input type="text" class="form-control bg-secondary text-white border-0 rounded-3" id="fbName" placeholder="e.g. Meera P." required>
                </div>
                <div class="mb-3">
                  <label class="form-label small fw-semibold text-warning">Product Purchased</label>
                  <select class="form-select bg-secondary text-white border-0 rounded-3" id="fbProduct">
                    <option value="Smart Thermal Bottle">Smart Thermal Bottle</option>
                    <option value="Ergonomic Study Bag">Ergonomic Study Bag</option>
                    <option value="Premium Grid Notebook">Premium Grid Notebook</option>
                    <option value="2 AM Signature Diary">2 AM Signature Diary</option>
                    <option value="2 AM Coffee Mug">2 AM Coffee Mug</option>
                    <option value="2 AM Study Essentials">2 AM Study Essentials</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label small fw-semibold text-warning">Rating</label>
                  <select class="form-select bg-secondary text-white border-0 rounded-3" id="fbRating">
                    <option value="5">⭐⭐⭐⭐⭐ (5/5)</option>
                    <option value="4">⭐⭐⭐⭐ (4/5)</option>
                    <option value="3">⭐⭐⭐ (3/5)</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label small fw-semibold text-warning">Your Feedback / Review</label>
                  <textarea class="form-control bg-secondary text-white border-0 rounded-3" id="fbComment" rows="3" placeholder="Tell us how the product helped your study sessions..." required></textarea>
                </div>
              </div>
              <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-warning fw-bold rounded-pill px-4 text-dark" id="submitFbBtn">Submit Feedback</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const fbForm = document.getElementById('shopperFeedbackForm');
          if (!fbForm) return;

          fbForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('submitFbBtn');
            btn.disabled = true;
            btn.textContent = 'Submitting...';

            const name = document.getElementById('fbName').value;
            const product = document.getElementById('fbProduct').value;
            const rating = document.getElementById('fbRating').value;
            const comment = document.getElementById('fbComment').value;

            try {
              const res = await fetch('/store/api/store/feedback', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, product, rating, comment })
              });
              const data = await res.json();
              if (data.success && data.feedback) {
                const fb = data.feedback;
                const container = document.getElementById('carouselInnerFeedbacks');
                if (container) {
                  const activeItems = container.querySelectorAll('.carousel-item.active');
                  activeItems.forEach(el => el.classList.remove('active'));

                  let starsHtml = '';
                  for (let i = 0; i < (fb.rating || 5); i++) {
                    starsHtml += '<i class="fa-solid fa-star text-warning"></i>';
                  }

                  const newSlide = document.createElement('div');
                  newSlide.className = 'carousel-item active';
                  newSlide.innerHTML = `
                    <div class="review-slide-content px-md-3">
                      <div class="review-stars mb-2" style="font-size: 0.82rem;">
                        ${starsHtml}
                      </div>
                      <p class="mb-3 text-dark" style="font-size: 0.95rem; line-height: 1.65; font-style: italic; color: #1e293b;">
                        "${fb.comment}"
                      </p>
                      <div class="d-flex flex-column align-items-center justify-content-center gap-1">
                        <img src="${fb.avatar}" alt="${fb.name}" class="rounded-circle border border-2" style="border-color: #f59e0b !important; width: 44px; height: 44px; object-fit: cover;" loading="lazy">
                        <div>
                          <h6 class="fw-bold mb-0" style="color: #0f172a; font-size: 0.88rem;">${fb.name}</h6>
                          <small class="fw-semibold" style="color: #d97706; font-size: 0.75rem;">Verified Buyer • ${fb.product}</small>
                        </div>
                      </div>
                    </div>
                  `;
                  container.insertBefore(newSlide, container.firstChild);
                }

                const modalEl = document.getElementById('giveFeedbackModal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
                fbForm.reset();
                alert('🎉 Thank you! Your feedback has been published live on 2 AM Study.');
              } else {
                alert(data.error || 'Could not submit feedback.');
              }
            } catch(err) {
              console.error('Feedback submit error:', err);
              alert('Network error. Please try again.');
            } finally {
              btn.disabled = false;
              btn.textContent = 'Submit Feedback';
            }
          });
        });
      </script>


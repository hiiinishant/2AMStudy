<%- include('partials/header') %>

  <main>

    <div class="carousel slid" data-bs-ride="carousel" id="slider1">
      <div class="carousel-indicators">
        <button type="button" data-bs-target="#slider1" data-bs-slide-to="0" class="active" aria-current="true"
          aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#slider1" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#slider1" data-bs-slide-to="2" aria-label="Slide 3"></button>
        <button type="button" data-bs-target="#slider1" data-bs-slide-to="3" aria-label="Slide 4"></button>
        <button type="button" data-bs-target="#slider1" data-bs-slide-to="4" aria-label="Slide 5"></button>
      </div>

      <div class="carousel-inner">
        <div class="carousel-item active ">
          <img src="/assets/images/student1.webp" alt="A group of successful college students studying together"
            style="width:100%; height:565px; object-fit:cover;object-position:11% center;">

        </div>
        <div class="carousel-item ">
          <img src="/assets/images/college-student-4369850_1280.webp"
            alt="A focused student working in a modern university library"
            style="width:100%; height:575px; object-fit:cover; object-position:20% center;" loading="lazy">

        </div>
        <div class="carousel-item ">
          <img src="/assets/images/student3.webp" alt="Confident student preparing for academic success"
            style="width:100%; height:575px; object-fit:cover;" loading="lazy">

        </div>
        <div class="carousel-item ">
          <img src="/assets/images/student5.webp" alt="Students collaborating on a future-shaping project"
            style="width:100%; height:575px; object-fit:cover;" loading="lazy">
        </div>
        <div class="carousel-item ">
          <img src="/assets/images/student6.webp"
            alt="Happy student celebrating graduation and successful transformation"
            style="width:100%; height:575px; object-fit:cover;" loading="lazy">

        </div>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#slider1" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#slider1" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>

    <style>
      .quick-access-card {
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        cursor: pointer;
        position: relative;
        overflow: hidden;
      }

      .quick-access-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 24px -4px rgba(15, 23, 42, 0.08), 0 4px 12px -2px rgba(15, 23, 42, 0.03) !important;
        border-color: rgba(79, 70, 229, 0.35) !important;
      }

      .quick-access-card:active {
        transform: translateY(-1px) scale(0.985) !important;
        box-shadow: 0 4px 8px -2px rgba(15, 23, 42, 0.05) !important;
      }

      .btn-hero-cta {
        position: relative;
        font-weight: 600 !important;
        font-size: 0.84rem !important;
        padding: 0.42rem 1.05rem !important;
        border-radius: 9999px !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none !important;
      }

      .btn-hero-cta .cta-icon-badge {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
        transition: transform 0.2s ease;
        flex-shrink: 0;
      }

      .btn-hero-cta:hover .cta-icon-badge {
        transform: scale(1.1);
      }

      .btn-hero-cta .cta-arrow {
        transition: transform 0.2s ease;
        font-size: 0.75rem;
      }

      .btn-hero-cta:hover .cta-arrow {
        transform: translateX(3px);
      }

      .btn-whatsapp-pro {
        background-color: #ecfdf5 !important;
        color: #047857 !important;
        border: 1px solid #a7f3d0 !important;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.12) !important;
      }

      .btn-whatsapp-pro .cta-icon-badge {
        background: #10b981 !important;
        color: #ffffff !important;
      }

      .btn-whatsapp-pro:hover {
        background-color: #d1fae5 !important;
        border-color: #6ee7b7 !important;
        color: #065f46 !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.22) !important;
      }

      .btn-whatsapp-pro:active {
        transform: translateY(0) scale(0.98) !important;
      }

      .btn-youtube-pro {
        background-color: #fff1f2 !important;
        color: #be123c !important;
        border: 1px solid #fecdd3 !important;
        box-shadow: 0 2px 8px rgba(225, 29, 72, 0.12) !important;
      }

      .btn-youtube-pro .cta-icon-badge {
        background: #e11d48 !important;
        color: #ffffff !important;
      }

      .btn-youtube-pro:hover {
        background-color: #ffe4e6 !important;
        border-color: #fda4af !important;
        color: #9f1239 !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(225, 29, 72, 0.22) !important;
      }

      .btn-youtube-pro:active {
        transform: translateY(0) scale(0.98) !important;
      }
    </style>

    <section class="container-fluid py-lg-5 py-sm-4 py-3">
      <div class="container">
        <div class="row align-items-center gy-4">
          <!-- Left Column: Title, Subtitle, Bullet List -->
          <div class="col-lg-7 col-12 text-center text-lg-start">
            <div class="bannerContent">
              <h1 class="display-4 fw-bold mb-3">Transformation Bridge - <span class="theme-text">Expert Study Tips &
                  Student Productivity</span></h1>
              <p class="lead mb-4">Bridging the gap from college life to a <span class="fw-bold">successful
                  future.</span>
              </p>

              <!-- Slogan Badges: Inspiring Minds · Empowering Dreams · Shaping Leaders (In-Line for phone & desktop) -->
              <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start gap-2 gap-sm-2.5 my-3.5 hero-slogan-strip">
                <div class="d-inline-flex align-items-center gap-1.5 px-3 py-1.5 rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 shadow-xs" style="font-size: 0.84rem; font-weight: 600; white-space: nowrap;">
                  <i class="fa-solid fa-circle-check text-success" style="font-size: 0.85rem;"></i>
                  <span>Inspiring Minds</span>
                </div>
                <div class="d-inline-flex align-items-center gap-1.5 px-3 py-1.5 rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 shadow-xs" style="font-size: 0.84rem; font-weight: 600; white-space: nowrap;">
                  <i class="fa-solid fa-circle-check text-success" style="font-size: 0.85rem;"></i>
                  <span>Empowering Dreams</span>
                </div>
                <div class="d-inline-flex align-items-center gap-1.5 px-3 py-1.5 rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 shadow-xs" style="font-size: 0.84rem; font-weight: 600; white-space: nowrap;">
                  <i class="fa-solid fa-circle-check text-success" style="font-size: 0.85rem;"></i>
                  <span>Shaping Leaders</span>
                </div>
              </div>

              <!-- Hero CTA Buttons: WhatsApp & YouTube -->
              <div class="mt-4 pt-1">
                <div class="d-flex flex-wrap align-items-center gap-3 justify-content-center justify-content-lg-start">
                  <a href="https://chat.whatsapp.com/" target="_blank" rel="noopener noreferrer"
                    class="btn btn-hero-cta btn-whatsapp-pro shadow-sm">
                    <span class="cta-icon-badge">
                      <i class="fa-brands fa-whatsapp fs-6"></i>
                    </span>
                    <span>Join WhatsApp Group</span>
                    <i class="fa-solid fa-arrow-right cta-arrow opacity-75 ms-1"></i>
                  </a>
                  <a href="https://www.youtube.com/@2amstudy" target="_blank" rel="noopener noreferrer"
                    class="btn btn-hero-cta btn-youtube-pro shadow-sm">
                    <span class="cta-icon-badge">
                      <i class="fa-brands fa-youtube fs-6"></i>
                    </span>
                    <span>Visit YouTube Channel</span>
                    <i class="fa-solid fa-arrow-right cta-arrow opacity-75 ms-1"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Live Study Stream / Study Together Card -->
          <div class="col-lg-5 col-12">
            <div
              class="card border-0 shadow-lg rounded-4 pt-2.5 pt-md-3 px-3 px-md-4 pb-3 pb-md-4 position-relative overflow-hidden"
              style="background: radial-gradient(ellipse at 50% 0%, #170d2c 0%, #0c0a18 60%, #03020a 100%); border: 1px solid rgba(99, 102, 241, 0.25) !important;">

              <!-- Card Header -->
              <div class="d-flex align-items-center justify-content-between mb-4 pb-2">
                <div class="d-flex align-items-center gap-2">
                  <span
                    class="badge rounded-pill px-2.5 py-1 text-white border border-white border-opacity-10 d-inline-flex align-items-center gap-1.5"
                    style="background: rgba(255, 255, 255, 0.06); font-size: 11px; font-weight: 500;">
                    <span
                      style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #ef4444; animation: liveNavPulse 1.4s ease-in-out infinite;"></span>
                    <% if (typeof liveSession !=='undefined' && liveSession) { %>Live Now<% } else { %>Study Live<% } %>
                  </span>
                </div>
                <span class="badge rounded-pill px-2.5 py-1 text-white border border-white border-opacity-10"
                  style="background: rgba(255, 255, 255, 0.06); font-size: 11px; font-weight: 500;">
                  <i class="fa-solid fa-users me-1 text-info opacity-75"></i> 2,400+ studying
                </span>
              </div>

              <!-- Animated Study Video Screen -->
              <% const activeVideo=(typeof liveSession !=='undefined' && liveSession) ? liveSession : ((typeof
                latestPastSession !=='undefined' && latestPastSession) ? latestPastSession : null); const
                vidId=activeVideo ? activeVideo.youtubeVideoId : 'jfKfPfyJRdk' ; const videoTitle=activeVideo ?
                activeVideo.title : '5 Hour Deep Focus Study Session' ; const videoDuration=(activeVideo &&
                activeVideo.duration) ? activeVideo.duration : '' ; %>
                <div class="position-relative rounded-3 overflow-hidden mb-2.5"
                  style="aspect-ratio: 16/9; background: #000; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5); border: 1px solid rgba(255, 255, 255, 0.1);">
                  <iframe
                    src="https://www.youtube.com/embed/<%= vidId %>?autoplay=1&mute=1&playsinline=1&rel=0&modestbranding=1"
                    class="w-100 h-100 position-absolute top-0 start-0 border-0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen title="<%= videoTitle %>">
                  </iframe>

                  <!-- Corner Live Tag (only if currently live) -->
                  <% if (typeof liveSession !=='undefined' && liveSession) { %>
                    <div
                      class="position-absolute top-0 start-0 m-2 d-flex align-items-center gap-1.5 px-2 py-0.5 rounded-pill"
                      style="background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(6px); font-size: 10px; color: #f87171; border: 1px solid rgba(220, 38, 38, 0.35); font-weight: 700; pointer-events: none;">
                      <span
                        style="width: 6px; height: 6px; border-radius: 50%; background: #ef4444; display: inline-block;"></span>
                      <span>LIVE NOW</span>
                    </div>
                    <% } %>

                      <!-- Corner Brand Tag -->
                      <div
                        class="position-absolute top-0 end-0 m-2 d-flex align-items-center gap-1 px-2 py-0.5 rounded-pill"
                        style="background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(6px); font-size: 10px; color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.35); pointer-events: none;">
                        <i class="fa-solid fa-moon"></i>
                        <span>2 AM Study</span>
                      </div>
                </div>

                <!-- Stream Title (Clean gap below video) -->
                <div class="mt-3 mb-3 px-1 text-center text-sm-start">
                  <h3 class="fw-bold text-white mb-0"
                    style="font-size: 0.98rem; line-height: 1.38; letter-spacing: -0.01em;">
                    <%= videoTitle %>
                  </h3>
                </div>

                <!-- Main CTA Button -->
                <div class="mb-3">
                  <a href="/live-study"
                    class="btn w-100 fw-bold d-flex align-items-center justify-content-center gap-2 py-2.5 rounded-pill text-white shadow-sm"
                    style="background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%); border: none; font-size: 0.95rem; box-shadow: 0 6px 20px rgba(220, 38, 38, 0.45); transition: transform 0.2s ease, box-shadow 0.2s ease;">
                    <i class="fa-brands fa-youtube fs-5"></i>
                    <span>Join Live Study Stream</span>
                    <i class="fa-solid fa-arrow-right small ms-1"></i>
                  </a>
                </div>

                <!-- Bottom Tagline -->
                <div class="pt-2.5 border-top border-white border-opacity-10 text-center">
                  <span class="text-white-50 small d-inline-flex align-items-center justify-content-center gap-1.5"
                    style="font-size: 11.5px;">
                    <span>✨ Create your very own focused study session</span>
                  </span>
                </div>
            </div>
          </div>
        </div>
      </div>
    </section>


  <!-- Auto-close mobile offcanvas & Firebase Auth Listener -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-app.js";
    import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-auth.js";

    const firebaseConfig = {
      apiKey: "AIzaSyCvJRS3UusvUrVCd2JSicBGL-uRD82GpNM",
      authDomain: "am-study-7ea87.firebaseapp.com",
      projectId: "am-study-7ea87",
      storageBucket: "am-study-7ea87.firebasestorage.app",
      messagingSenderId: "270924691236",
      appId: "1:270924691236:web:7ada12dcf50c290d0925b1"
    };

    let app, auth;
    try {
      app = initializeApp(firebaseConfig);
      auth = getAuth(app);
    } catch (e) { }

    document.addEventListener('DOMContentLoaded', function () {
      const offcanvasEl = document.getElementById('mobileMenuOffcanvas');
      if (offcanvasEl) {
        const links = offcanvasEl.querySelectorAll('a.nav-link, a.dropdown-item');
        links.forEach(link => {
          link.addEventListener('click', function (e) {
            if (this.classList.contains('dropdown-toggle')) return;
            if (offcanvasEl.classList.contains('show')) {
              const href = this.getAttribute('href');
              const bsOffcanvas = bootstrap.Offcanvas.getInstance(offcanvasEl);
              if (bsOffcanvas) {
                if (href && href.includes('#')) {
                  const url = new URL(this.href, window.location.origin);
                  const isSamePage = (url.pathname === window.location.pathname || url.pathname === window.location.pathname + '/');
                  if (isSamePage) {
                    e.preventDefault();
                    bsOffcanvas.hide();
                    setTimeout(() => {
                      window.location.hash = url.hash;
                      const target = document.querySelector(url.hash);
                      if (target) target.scrollIntoView({ behavior: 'smooth' });
                    }, 350);
                  }
                } else {
                  bsOffcanvas.hide();
                }
              }
            }
          });
        });
      }

      // Real-time Firebase Auth Source-of-Truth Listener
      const guestAuthButtons = document.getElementById('guestAuthButtons');
      const userMenuDropdown = document.getElementById('userMenuDropdown');
      const headerUserAvatar = document.getElementById('headerUserAvatar');
      const headerUserName = document.getElementById('headerUserName');
      const bellWrapper = document.getElementById('notifBellWrapper');
      const bellCount = document.getElementById('notifBellCount');
      const logoutBtn = document.getElementById('headerLogoutBtn');

      if (auth) {
        onAuthStateChanged(auth, (user) => {
          if (user) {
            // Logged in state
            const name = user.displayName || user.email.split('@')[0];
            if (guestAuthButtons) guestAuthButtons.classList.add('d-none');
            if (userMenuDropdown) userMenuDropdown.classList.remove('d-none');
            if (headerUserName) headerUserName.textContent = name.length > 12 ? name.substring(0, 12) + '...' : name;
            if (headerUserAvatar) headerUserAvatar.textContent = name.charAt(0).toUpperCase();

            if (bellWrapper) {
              bellWrapper.classList.remove('d-none');
              fetch(`/api/student-safety/notifications/${encodeURIComponent(user.uid)}`)
                .then(r => r.json())
                .then(data => {
                  const unread = data.unreadCount || 0;
                  if (unread > 0 && bellCount) {
                    bellCount.textContent = unread > 9 ? '9+' : unread;
                    bellCount.classList.remove('d-none');
                    bellWrapper.classList.add('notif-bell-active');
                  }
                })
                .catch(() => { });
            }

            // Sync to local storage
            localStorage.setItem('isLoggedIn', 'true');
            localStorage.setItem('user_id', user.uid);
            localStorage.setItem('studentEmail', user.email || '');
            localStorage.setItem('studentName', name);

          } else {
            // Logged out state
            if (guestAuthButtons) guestAuthButtons.classList.remove('d-none');
            if (userMenuDropdown) userMenuDropdown.classList.add('d-none');
            if (bellWrapper) bellWrapper.classList.add('d-none');

            localStorage.removeItem('isLoggedIn');
            localStorage.removeItem('user_id');
            localStorage.removeItem('studentEmail');
            localStorage.removeItem('studentName');
          }
        });

        if (logoutBtn) {
          logoutBtn.addEventListener('click', async () => {
            try {
              await signOut(auth);
              ['isLoggedIn', 'user_id', 'studentEmail', 'studentName', 'studentRegistered', 'studentCollege'].forEach(k => localStorage.removeItem(k));
              window.location.href = '/login';
            } catch (e) {
              console.error("Logout error:", e);
            }
          });
        }
      }
    });
  </script>
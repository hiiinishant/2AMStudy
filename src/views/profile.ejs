<%- include('partials/header') %>

<style>
/* 2AM Study — Premium Student Profile Dashboard */
:root {
  --pf-bg: #f8fafc;
  --pf-card: #ffffff;
  --pf-border: #e2e8f0;
  --pf-primary: #2563eb;
  --pf-primary-hover: #1d4ed8;
  --pf-text: #0f172a;
  --pf-muted: #64748b;
  --pf-success: #16a34a;
  --pf-orange: #ea580c;
}

body {
  background-color: var(--pf-bg);
  color: var(--pf-text);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}

.pf-main {
  padding-top: 100px;
  padding-bottom: 70px;
  min-height: calc(100vh - 120px);
}

/* Hero Profile Header */
.pf-hero-card {
  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
  border-radius: 24px;
  padding: 32px;
  color: #ffffff;
  margin-bottom: 28px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
}
.pf-hero-card::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 380px;
  height: 380px;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.25) 0%, rgba(37, 99, 235, 0) 70%);
  pointer-events: none;
}

.pf-avatar {
  width: 88px;
  height: 88px;
  border-radius: 24px;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.2rem;
  font-weight: 800;
  color: #ffffff;
  box-shadow: 0 8px 20px rgba(37, 99, 235, 0.35);
  border: 3px solid rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.pf-hero-info {
  flex: 1;
  min-width: 0;
}
.pf-hero-name {
  font-size: 1.85rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  margin-bottom: 4px;
}
.pf-hero-email {
  color: #94a3b8;
  font-size: 0.92rem;
}

.pf-badge-verified {
  background: rgba(34, 197, 94, 0.18);
  color: #4ade80;
  border: 1px solid rgba(34, 197, 94, 0.3);
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

/* Stats Counter Row */
.pf-stat-card {
  background: var(--pf-card);
  border: 1px solid var(--pf-border);
  border-radius: 18px;
  padding: 20px;
  text-align: center;
  transition: transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 2px 8px rgba(0,0,0,0.02);
}
.pf-stat-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(0,0,0,0.05);
}
.pf-stat-icon {
  font-size: 1.6rem;
  margin-bottom: 8px;
}
.pf-stat-val {
  font-size: 1.55rem;
  font-weight: 800;
  color: var(--pf-text);
  line-height: 1.2;
}
.pf-stat-label {
  font-size: 0.8rem;
  color: var(--pf-muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

/* Section Card */
.pf-card {
  background: var(--pf-card);
  border: 1px solid var(--pf-border);
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  margin-bottom: 24px;
}
.pf-card-title {
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--pf-text);
  margin-bottom: 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Navigation Grid */
.pf-nav-card {
  background: #f8fafc;
  border: 1px solid var(--pf-border);
  border-radius: 16px;
  padding: 18px;
  text-decoration: none;
  display: flex;
  align-items: flex-start;
  gap: 14px;
  transition: all 0.2s ease;
  height: 100%;
}
.pf-nav-card:hover {
  background: #ffffff;
  border-color: var(--pf-primary);
  transform: translateY(-3px);
  box-shadow: 0 8px 20px rgba(37, 99, 235, 0.08);
}
.pf-nav-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.35rem;
  flex-shrink: 0;
}
.pf-nav-title {
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--pf-text);
  margin-bottom: 2px;
}
.pf-nav-desc {
  font-size: 0.8rem;
  color: var(--pf-muted);
  line-height: 1.4;
  margin: 0;
}

/* Order Mini Card */
.pf-order-card {
  border: 1px solid var(--pf-border);
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 12px;
  background: #ffffff;
  transition: border-color 0.2s;
}
.pf-order-card:hover {
  border-color: #cbd5e1;
}

@media (max-width: 768px) {
  .pf-main { padding-top: 80px; }
  .pf-hero-card { padding: 22px; }
  .pf-avatar { width: 68px; height: 68px; font-size: 1.7rem; border-radius: 18px; }
  .pf-hero-name { font-size: 1.45rem; }
}
</style>

<main class="container pf-main">

  <!-- Instant Pre-Hydration to prevent 0ms flicker -->
  <script>
    (function() {
      try {
        var isLogged = localStorage.getItem('isLoggedIn') === 'true' || localStorage.getItem('studentRegistered') === 'true';
        var name = localStorage.getItem('studentName') || localStorage.getItem('studentEmail');
        var email = localStorage.getItem('studentEmail');
        var college = localStorage.getItem('studentCollege');
        if (name) {
          var cleanName = name.includes('@') ? name.split('@')[0] : name;
          document.addEventListener('DOMContentLoaded', function() {
            var n = document.getElementById('profileNameHeader');
            var e = document.getElementById('profileEmailHeader');

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-app.js";
  import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-auth.js";
  import { getFirestore, doc, getDoc } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyCvJRS3UusvUrVCd2JSicBGL-uRD82GpNM",
    authDomain: "am-study-7ea87.firebaseapp.com",
    projectId: "am-study-7ea87",
    storageBucket: "am-study-7ea87.firebasestorage.app",
    messagingSenderId: "270924691236",
    appId: "1:270924691236:web:7ada12dcf50c290d0925b1"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);

  onAuthStateChanged(auth, async (user) => {
    if (!user) {
      window.location.href = '/login?redirect=/profile';
      return;
    }

    const name = user.displayName || user.email.split('@')[0];
    const email = user.email || '';

    const nameEl = document.getElementById('profileNameHeader');
    const emailEl = document.getElementById('profileEmailHeader');
    const emailTextEl = document.getElementById('profileEmailText');
    const avatarEl = document.getElementById('profileAvatar');
    const statusEl = document.getElementById('profileVerifiedStatus');

    if (nameEl) nameEl.textContent = name;
    if (emailEl) emailEl.textContent = email;
    if (emailTextEl) emailTextEl.textContent = email;
    if (avatarEl) avatarEl.textContent = name.charAt(0).toUpperCase();
    if (statusEl) statusEl.textContent = user.emailVerified ? 'Verified ✅' : 'Pending Verification 📩';

    // Fetch user Firestore data
    try {
      const snap = await getDoc(doc(db, "users", user.uid));
      if (snap.exists()) {
        const data = snap.data();
        if (data.college) {
          const c = document.getElementById('profileCollege');
          if (c) c.textContent = data.college;
        }
        if (data.trustScore !== undefined) {
          const ts = document.getElementById('profileTrustScore');
          if (ts) ts.textContent = `${data.trustScore} / 100`;
        }
      }
    } catch (e) {
      console.warn("Profile fetch error:", e);
    }

    // Fetch Trust Score & Reports Count from API
    try {
      const tsRes = await fetch(`/api/student-safety/trust-score/${encodeURIComponent(user.uid)}`);
      const tsData = await tsRes.json();
      if (tsData.success) {
        const ts = document.getElementById('profileTrustScore');
        if (ts) ts.textContent = `${tsData.trustScore} / 100`;
        const rc = document.getElementById('profileReportsCount');
        if (rc) rc.textContent = tsData.totalReports || 0;
      }
    } catch(e) {}

    // Load Recent Store Orders from API
    loadRecentOrders(user);
  });

  // Sign Out
  const signOutBtn = document.getElementById('signOutBtn');
  if (signOutBtn) {
    signOutBtn.addEventListener('click', async () => {
      try {
        await signOut(auth);
        ['isLoggedIn', 'user_id', 'studentEmail', 'studentName', 'studentRegistered', 'studentCollege'].forEach(k => localStorage.removeItem(k));
        window.location.href = '/login';
      } catch (e) {
        console.error("Sign out error:", e);
      }
    });
  }

  // Load Recent Orders from API + Firestore + local fallback
  async function loadRecentOrders(user) {
    const skeleton = document.getElementById('ordersSkeleton');
    const list = document.getElementById('ordersList');
    const empty = document.getElementById('ordersEmpty');
    const countEl = document.getElementById('profileOrdersCount');

    try {
      const userEmail = user?.email || localStorage.getItem('studentEmail') || '';
      const userId = user?.uid || localStorage.getItem('user_id') || '';

      const res = await fetch(`/api/store/my-orders?email=${encodeURIComponent(userEmail)}&uid=${encodeURIComponent(userId)}`, { credentials: 'include' });
      const data = await res.json();

      if (skeleton) skeleton.classList.add('d-none');

      if (data.success && Array.isArray(data.orders) && data.orders.length > 0) {
        if (countEl) countEl.textContent = data.orders.length;
        if (empty) empty.classList.add('d-none');
        if (list) {
          list.classList.remove('d-none');
          // Show top 2 recent orders on profile
          const topOrders = data.orders.slice(0, 2);
          list.innerHTML = topOrders.map(order => {
            const orderId = order.orderId || order.id || 'N/A';
            const invoiceNo = order.invoiceNo || orderId;
            const items = order.items || [];
            const itemCount = items.length || 1;
            const total = order.finalTotal || items.reduce((s, i) => s + ((Number(i.price) || 0) * (Number(i.qty) || 1)), 0);
            const dateStr = order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Recent';

            return `
              <div class="pf-order-card d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                  <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2.5 fs-4">🧾</div>
                  <div>
                    <div class="fw-bold text-dark mb-0.5">${invoiceNo}</div>
                    <div class="text-muted small">${itemCount} item${itemCount !== 1 ? 's' : ''} &bull; Placed on ${dateStr}</div>
                    <div class="small fw-bold text-dark mt-0.5">₹${Number(total).toLocaleString()} &bull; <span class="text-success">Paid & Verified</span></div>
                  </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <a href="/store/invoice/${encodeURIComponent(orderId)}" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                    View Invoice
                  </a>
                </div>
              </div>
            `;
          }).join('');
        }
        return;
      }
    } catch(err) {
      console.warn("Recent orders load notice:", err);
    }

    if (skeleton) skeleton.classList.add('d-none');
    if (list) list.classList.add('d-none');
    if (empty) empty.classList.remove('d-none');
    if (countEl) countEl.textContent = '0';
  }
</script>


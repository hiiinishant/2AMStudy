<%- include('partials/header') %>

<section class="py-5 bg-light pb-4" style="padding-top: 90px !important;">
  <div class="container py-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
      <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary mb-2 fw-semibold small">
          👤 Account Profile
        </div>
        <h1 class="display-6 fw-extrabold text-dark mb-1" id="profileNameHeader">Student Profile</h1>
        <p class="text-muted small mb-0" id="profileEmailHeader">Manage your account details and view your platform standing.</p>
      </div>
      <a href="/settings" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
        ⚙️ Edit Settings
      </a>
    </div>
  </div>
</section>

<main class="container py-5">
  <div class="row g-4">
    <!-- Left Column: User Card -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white mb-4">
        <div class="user-avatar-placeholder rounded-circle bg-primary text-white mx-auto d-flex align-items-center justify-content-center fw-bold fs-2 mb-3" id="profileAvatar" style="width: 80px; height: 80px;">
          👤
        </div>
        <h2 class="h5 fw-bold text-dark mb-1" id="profileCardName">Loading...</h2>
        <p class="text-muted small mb-3" id="profileCardEmail">...</p>
        
        <div class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1.5 rounded-pill mb-3" id="profileRoleBadge">
          Verified Student
        </div>

        <div class="p-3 bg-light rounded-3 text-start small">
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">College:</span>
            <span class="fw-bold text-dark" id="profileCollege">Not specified</span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Email Verified:</span>
            <span class="fw-bold text-success" id="profileVerifiedStatus">Yes</span>
          </div>
          <div class="d-flex justify-content-between">
            <span class="text-muted">Trust Score:</span>
            <span class="fw-bold text-primary" id="profileTrustScore">0 / 100</span>
          </div>
        </div>

        <div class="mt-3 d-grid gap-2">
          <a href="/store" class="btn btn-sm btn-primary rounded-pill fw-semibold">
            🛒 Go to Store
          </a>
          <button id="signOutBtn" class="btn btn-sm btn-outline-danger rounded-pill fw-semibold">
            🚪 Sign Out
          </button>
        </div>
      </div>
    </div>

    <!-- Right Column: Navigation & Standing -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
        <h3 class="h5 fw-bold text-dark mb-4">Account Dashboard & Navigation</h3>
        
        <div class="row g-3">
          <div class="col-md-6">
            <a href="/student-safety/my-reports" class="card h-100 p-4 border text-decoration-none rounded-4 shadow-sm hover-elevate">
              <div class="fs-2 mb-2">📄</div>
              <h4 class="h6 fw-bold text-dark mb-1">My Reports</h4>
              <p class="text-muted small mb-0">Track submitted fake profile reports and progress timelines.</p>
            </a>
          </div>
          <div class="col-md-6">
            <a href="/student-safety/notifications" class="card h-100 p-4 border text-decoration-none rounded-4 shadow-sm hover-elevate">
              <div class="fs-2 mb-2">🔔</div>
              <h4 class="h6 fw-bold text-dark mb-1">Notifications</h4>
              <p class="text-muted small mb-0">View real-time alerts for case status changes and approvals.</p>
            </a>
          </div>
          <div class="col-md-6">
            <a href="/student-safety/cases" class="card h-100 p-4 border text-decoration-none rounded-4 shadow-sm hover-elevate">
              <div class="fs-2 mb-2">🛡️</div>
              <h4 class="h6 fw-bold text-dark mb-1">Student Safety Hub</h4>
              <p class="text-muted small mb-0">Browse admin-verified impersonation cases needing support.</p>
            </a>
          </div>
          <div class="col-md-6">
            <a href="/store" class="card h-100 p-4 border text-decoration-none rounded-4 shadow-sm hover-elevate">
              <div class="fs-2 mb-2">🛒</div>
              <h4 class="h6 fw-bold text-dark mb-1">Student Store</h4>
              <p class="text-muted small mb-0">Explore 2AM Study notebooks, merchandise, and supplies.</p>
            </a>
          </div>
        </div>
      </div>

      <!-- My Orders Section -->
      <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5 mt-4">
        <h3 class="h5 fw-bold text-dark mb-4">🧾 My Orders</h3>
        <div id="ordersContainer">
          <div class="text-center py-4 text-muted">
            <div class="fs-1 mb-2">🛍️</div>
            <p class="mb-2 fw-semibold">No orders yet</p>
            <p class="small mb-3">Once you place an order, it will appear here with your invoice.</p>
            <a href="/store" class="btn btn-sm btn-primary rounded-pill px-4">Shop Now</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-app.js";
  import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-auth.js";
  import { getFirestore, doc, getDoc } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyCvJRS3UusvUrVCd2JSicBGL-uRD82GpNM",
    authDomain: "am-study-7ea87.firebaseapp.com",
    projectId: "am-study-7ea87",
    storageBucket: "am-study-7ea87.firebasestorage.app",
    messagingSenderId: "270924691236",
    appId: "1:270924691236:web:7ada12dcf50c290d0925b1"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);

  onAuthStateChanged(auth, async (user) => {
    if (!user) {
      window.location.href = '/login?redirect=/profile';
      return;
    }

    const name = user.displayName || user.email.split('@')[0];
    document.getElementById('profileNameHeader').textContent = name;
    document.getElementById('profileCardName').textContent = name;
    document.getElementById('profileCardEmail').textContent = user.email;
    document.getElementById('profileEmailHeader').textContent = user.email;
    document.getElementById('profileAvatar').textContent = name.charAt(0).toUpperCase();
    document.getElementById('profileVerifiedStatus').textContent = user.emailVerified ? 'Verified ✅' : 'Pending Verification 📩';

    // Fetch user Firestore data
    try {
      const snap = await getDoc(doc(db, "users", user.uid));
      if (snap.exists()) {
        const data = snap.data();
        if (data.college) document.getElementById('profileCollege').textContent = data.college;
        if (data.trustScore !== undefined) document.getElementById('profileTrustScore').textContent = `${data.trustScore} / 100`;
      }
    } catch (e) {
      console.warn("Profile fetch error:", e);
    }

    // Load My Orders from localStorage
    loadOrders();
  });

  // Sign Out
  document.getElementById('signOutBtn').addEventListener('click', async () => {
    try {
      await signOut(auth);
      localStorage.removeItem('isLoggedIn');
      localStorage.removeItem('user_id');
      localStorage.removeItem('studentEmail');
      localStorage.removeItem('studentName');
      localStorage.removeItem('studentRegistered');
      window.location.href = '/login';
    } catch (e) {
      console.error("Sign out error:", e);
    }
  });

  // Render My Orders from localStorage
  function loadOrders() {
    const ordersContainer = document.getElementById('ordersContainer');
    const lastOrder = JSON.parse(localStorage.getItem('2am_last_order') || 'null');

    if (!lastOrder || !lastOrder.orderId) {
      // Keep the empty state
      return;
    }

    const orderDate = lastOrder.createdAt
      ? new Date(lastOrder.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })
      : 'Recently';

    const totalAmount = lastOrder.amount
      ? `₹${Number(lastOrder.amount).toLocaleString('en-IN')}`
      : (lastOrder.items ? `₹${lastOrder.items.reduce((s, i) => s + (Number(i.price) * Number(i.qty || 1)), 0).toLocaleString('en-IN')}` : '—');

    const itemCount = lastOrder.items ? lastOrder.items.length : 1;

    ordersContainer.innerHTML = `
      <div class="border rounded-4 p-4 d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
        <div class="d-flex align-items-start gap-3">
          <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-3 fw-bold" style="width:48px;height:48px;font-size:22px;">🧾</div>
          <div>
            <div class="fw-bold text-dark mb-1">${lastOrder.orderId}</div>
            <div class="text-muted small">${itemCount} item${itemCount !== 1 ? 's' : ''} · Placed on ${orderDate}</div>
            <div class="text-muted small">Amount: <strong class="text-dark">${totalAmount}</strong></div>
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 mt-1" style="font-size:11px;">✓ Order Confirmed</span>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a href="/store/invoice/${lastOrder.orderId}" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
            📄 View Invoice
          </a>
          <a href="/store" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">
            🛒 Shop Again
          </a>
        </div>
      </div>
      <p class="text-muted small mt-2 mb-0">
        <i class="fa-solid fa-circle-info me-1"></i>
        Full order history will be available in a future update. Your latest order is shown above.
      </p>
    `;
  }
</script>

<%- include('partials/footer') %>

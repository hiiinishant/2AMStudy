<%- include('partials/header') %>

<!-- Top Hero Banner (Compact & Animated with 2 AM Study - Matches Music & Blog) -->
<section class="hero-quotes-section">
  <div class="container text-center">
    <div class="hero-quotes-badge">
      <span class="pulse-dot"></span>
      <span>Inspiration &amp; Mindset Hub</span>
      <i class="fa-solid fa-quote-left text-primary ms-1" style="font-size: 0.85rem;"></i>
    </div>
    
    <h1 class="animated-2am-title">
      Motivational Study Quotes — <span class="gradient-2am-text">2 AM Study</span>
    </h1>
    
    <p class="hero-quotes-subtitle">
      Fuel your late-night study sessions with deep focus affirmations, discipline reminders &amp; downloadable wisdom cards.
    </p>
  </div>
</section>

<style>
/* Hero Section & Animations (Matches Music & Blog Page Hero) */
@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes pulseGlow {
  0%, 100% { transform: scale(1); opacity: 0.8; }
  50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 10px rgba(37, 99, 235, 0.7); }
}

.hero-quotes-section {
  padding: 85px 16px 24px !important;
  background: radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.08) 0%, transparent 65%), #f8fafc;
  border-bottom: 1px solid rgba(15, 23, 42, 0.06);
}

.hero-quotes-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #ffffff;
  border: 1px solid rgba(37, 99, 235, 0.2);
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.08);
  border-radius: 50px;
  padding: 5px 14px;
  font-size: 0.82rem;
  font-weight: 700;
  color: #1e40af;
  margin-bottom: 10px;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #2563eb;
  animation: pulseGlow 1.8s infinite ease-in-out;
}

.animated-2am-title {
  font-size: 2.2rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f172a;
  margin-bottom: 6px;
}

.gradient-2am-text {
  background: linear-gradient(135deg, #2563eb 0%, #7c3aed 45%, #ec4899 75%, #2563eb 100%);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: gradientShift 5s ease infinite;
}

.hero-quotes-subtitle {
  font-size: 0.92rem;
  color: #64748b;
  max-width: 660px;
  margin: 0 auto;
  line-height: 1.5;
}

@media (max-width: 768px) {
  .animated-2am-title {
    font-size: 1.65rem;
  }
}

/* Category Filter Bar */
.quote-filter-bar {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 2rem;
}

.quote-filter-btn {
  padding: 8px 18px;
  border-radius: 100px;
  font-size: 0.86rem;
  font-weight: 700;
  border: 1px solid #e2e8f0;
  background: #ffffff;
  color: #64748b;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.quote-filter-btn:hover {
  background: #f8fafc;
  color: #0f172a;
  border-color: #cbd5e1;
}

.quote-filter-btn.active {
  background: #2563eb;
  color: #ffffff;
  border-color: #2563eb;
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25);
}

/* Quote Stage Card */
.quote-card-stage {
  min-height: 480px;
  border-radius: 28px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.15);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 3.5rem 2.5rem;
  transition: all 0.5s ease;
  background: #0f172a;
}

.quote-bg-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.quote-overlay-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.55) 0%, rgba(15, 23, 42, 0.85) 100%);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.quote-content-box {
  position: relative;
  z-index: 5;
  max-width: 820px;
  text-align: center;
  color: #ffffff;
}

.quote-text-display {
  font-size: clamp(1.4rem, 3.2vw, 2.3rem);
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: -0.01em;
  margin-bottom: 1.5rem;
  text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.quote-author-display {
  font-size: 1.1rem;
  font-weight: 600;
  color: #93c5fd;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  transition: opacity 0.3s ease;
}

/* Action Controls Bar */
.quote-actions-bar {
  position: relative;
  z-index: 5;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin-top: 2.5rem;
}

.quote-action-btn {
  border-radius: 100px;
  padding: 10px 22px;
  font-weight: 700;
  font-size: 0.88rem;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s ease;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.quote-action-btn:hover {
  transform: translateY(-2px);
}

.quote-theme-pill {
  padding: 5px 12px;
  border-radius: 100px;
  font-size: 0.75rem;
  font-weight: 700;
  border: 1px solid rgba(255, 255, 255, 0.25);
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  cursor: pointer;
  transition: all 0.2s ease;
}

.quote-theme-pill:hover,
.quote-theme-pill.active {
  background: #ffffff;
  color: #0f172a;
  border-color: #ffffff;
}

/* Toast Feedback */
.quote-toast {
  position: fixed;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  background: #0f172a;
  color: #ffffff;
  padding: 12px 24px;
  border-radius: 100px;
  font-weight: 700;
  font-size: 0.9rem;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  gap: 8px;
  z-index: 9999;
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.quote-toast.show {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}
</style>

<main class="container py-5 my-0">
  
  <!-- Category Filters -->
  <div class="quote-filter-bar" id="category-filters">
    <button class="quote-filter-btn active" data-category="all">
      <i class="fa-solid fa-layer-group"></i> All Quotes
    </button>
    <button class="quote-filter-btn" data-category="focus">
      ⚡ Deep Focus
    </button>
    <button class="quote-filter-btn" data-category="discipline">
      🧠 Discipline
    </button>
    <button class="quote-filter-btn" data-category="success">
      🏆 Success
    </button>
    <button class="quote-filter-btn" data-category="persistence">
      🔥 Persistence
    </button>
    <button class="quote-filter-btn" data-category="latenight">
      🌙 2 AM Study Wisdom
    </button>
  </div>

  <!-- Main Quote Card (Full Container Width) -->
  <div class="quote-card-stage mb-4" id="quoteCaptureArea">
    
    <!-- Background Layer -->
    <div class="quote-bg-layer" id="quoteBg"></div>
    <div class="quote-overlay-layer" id="quoteOverlay"></div>

    <!-- Center Content -->
    <div class="quote-content-box">
      <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4 border border-white border-opacity-25" style="background: rgba(255, 255, 255, 0.1);">
        <i class="fa-solid fa-sparkles text-warning small"></i>
        <span class="small fw-bold text-white text-uppercase" id="quoteCategoryTag" style="letter-spacing: 0.08em; font-size: 0.75rem;">Deep Focus</span>
      </div>

      <div class="quote-text-display" id="quoteText">
        "The quality of your work is defined by the depth of your focus."
      </div>
      
      <div class="quote-author-display" id="quoteAuthor">
        — Cal Newport
      </div>
    </div>

    <!-- Interactive Actions (Excluded during image download) -->
    <div class="quote-actions-bar no-export">
      <button class="btn btn-primary quote-action-btn shadow" id="btnNextQuote" onclick="generateNewQuote()">
        <i class="fa-solid fa-rotate"></i> Next Quote
      </button>
      <button class="btn btn-light quote-action-btn shadow-sm" onclick="copyQuote()">
        <i class="fa-solid fa-copy text-primary"></i> Copy Text
      </button>
      <button class="btn btn-light quote-action-btn shadow-sm" onclick="shareQuote()">
        <i class="fa-solid fa-share-nodes text-primary"></i> Share
      </button>
      <button class="btn btn-outline-light quote-action-btn" onclick="downloadQuote()">
        <i class="fa-solid fa-download"></i> Save Card Image
      </button>
      <a href="/timer" class="btn btn-warning text-dark quote-action-btn shadow-sm">
        <i class="fa-solid fa-stopwatch"></i> Start Timer With Quote
      </a>
    </div>

    <!-- Card Aesthetic Theme Switcher -->
    <div class="position-absolute top-0 end-0 p-3 p-md-4 d-flex align-items-center gap-2 no-export" style="z-index: 10;">
      <span class="small text-white text-opacity-75 d-none d-md-inline fw-semibold me-1">Theme:</span>
      <button class="quote-theme-pill active" onclick="setQuoteTheme('midnight', this)">🌌 Midnight</button>
      <button class="quote-theme-pill" onclick="setQuoteTheme('dawn', this)">🌅 Dawn</button>
      <button class="quote-theme-pill" onclick="setQuoteTheme('forest', this)">🌲 Forest</button>
      <button class="quote-theme-pill" onclick="setQuoteTheme('cyber', this)">⚡ Cyber</button>
    </div>

    <!-- 2 AM Study Brand Watermark -->
    <div class="position-absolute bottom-0 start-0 p-3 p-md-4" style="z-index: 10;">
      <div class="d-flex align-items-center gap-2 text-white text-opacity-75">
        <i class="fa-solid fa-moon text-warning small"></i>
        <span class="fw-bold small" style="letter-spacing: 0.05em;">2 AM STUDY</span>
      </div>
    </div>

  </div>

  <!-- Bottom Tip -->
  <div class="text-center mt-3">
    <p class="text-muted small mb-0">
      <i class="fa-solid fa-keyboard me-1 text-primary"></i> Press <kbd class="bg-light text-dark border px-2 py-1 rounded">Spacebar</kbd> on your keyboard for a new quote anytime!
    </p>
  </div>

</main>

<!-- Toast Notification -->
<div class="quote-toast" id="quoteToast">
  <i class="fa-solid fa-circle-check text-success fs-5"></i>
  <span id="toastMessage">Quote copied to clipboard!</span>
</div>

<!-- html2canvas for High-Res Image Export -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
  (function () {
    const quotes = [
      { text: "The quality of your work is defined by the depth of your focus.", author: "Cal Newport", category: "focus" },
      { text: "It’s not that I’m so smart, it’s just that I stay with problems longer.", author: "Albert Einstein", category: "persistence" },
      { text: "Focusing is about saying no to the hundred other good ideas that there are.", author: "Steve Jobs", category: "focus" },
      { text: "Success is the sum of small efforts, repeated day in and day out.", author: "Robert Collier", category: "success" },
      { text: "Discipline is choosing between what you want now and what you want most.", author: "Abraham Lincoln", category: "discipline" },
      { text: "Our greatest weakness lies in giving up. The most certain way to succeed is always to try just one more time.", author: "Thomas Edison", category: "persistence" },
      { text: "Don't stop when you're tired. Stop when you're done.", author: "David Goggins", category: "discipline" },
      { text: "Focus on being productive instead of busy.", author: "Tim Ferriss", category: "focus" },
      { text: "Success is not final, failure is not fatal: it is the courage to continue that counts.", author: "Winston Churchill", category: "success" },
      { text: "You don't have to be great to start, but you have to start to be great.", author: "Zig Ziglar", category: "success" },
      { text: "Hard work beats talent when talent doesn't work hard.", author: "Tim Notke", category: "discipline" },
      { text: "Motivation is what gets you started. Habit is what keeps you going.", author: "Jim Ryun", category: "discipline" },
      { text: "The secret of getting ahead is getting started.", author: "Mark Twain", category: "success" },
      { text: "Late nights and early mornings are the quiet forge where champions are made.", author: "2 AM Study", category: "latenight" },
      { text: "When the whole world goes to sleep, your dreams are wide awake.", author: "2 AM Study Mindset", category: "latenight" },
      { text: "Small daily improvements over time lead to stunning long-term results.", author: "Robin Sharma", category: "persistence" },
      { text: "You do not rise to the level of your goals. You fall to the level of your systems.", author: "James Clear", category: "discipline" },
      { text: "Action precedes motivation. Do the first two minutes, and momentum will take care of the rest.", author: "Deep Focus Principle", category: "focus" },
      { text: "Grit is passion and perseverance for very long-term goals.", author: "Angela Duckworth", category: "persistence" },
      { text: "While they party, you prepare. When they regret, you excel.", author: "2 AM Study Creed", category: "latenight" }
    ];

    const themes = {
      midnight: {
        bg: 'linear-gradient(135deg, #090d16 0%, #1e1b4b 50%, #0f172a 100%)',
        overlay: 'rgba(15, 23, 42, 0.4)'
      },
      dawn: {
        bg: 'linear-gradient(135deg, #312e81 0%, #4c1d95 40%, #be185d 80%, #fb923c 100%)',
        overlay: 'rgba(15, 23, 42, 0.35)'
      },
      forest: {
        bg: 'linear-gradient(135deg, #064e3b 0%, #065f46 50%, #022c22 100%)',
        overlay: 'rgba(2, 44, 34, 0.4)'
      },
      cyber: {
        bg: 'linear-gradient(135deg, #1e1b4b 0%, #3b0764 45%, #4338ca 100%)',
        overlay: 'rgba(15, 23, 42, 0.35)'
      }
    };

    let currentCategory = 'all';
    let currentTheme = 'midnight';

    function showToast(msg) {
      const toast = document.getElementById('quoteToast');
      const msgEl = document.getElementById('toastMessage');
      if (toast && msgEl) {
        msgEl.textContent = msg;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2500);
      }
    }

    window.setQuoteTheme = function (themeKey, btn) {
      currentTheme = themeKey;
      document.querySelectorAll('.quote-theme-pill').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');

      const bgLayer = document.getElementById('quoteBg');
      if (bgLayer && themes[themeKey]) {
        bgLayer.style.background = themes[themeKey].bg;
      }
      showToast(`✨ Switched to ${themeKey.toUpperCase()} theme`);
    };

    window.generateNewQuote = function () {
      const textEl = document.getElementById('quoteText');
      const authorEl = document.getElementById('quoteAuthor');
      const tagEl = document.getElementById('quoteCategoryTag');

      const pool = currentCategory === 'all'
        ? quotes
        : quotes.filter(q => q.category === currentCategory);

      const randomQuote = pool[Math.floor(Math.random() * pool.length)];

      if (textEl && authorEl) {
        textEl.style.opacity = '0';
        textEl.style.transform = 'translateY(8px)';
        authorEl.style.opacity = '0';

        setTimeout(() => {
          textEl.textContent = `"${randomQuote.text}"`;
          authorEl.textContent = `— ${randomQuote.author}`;
          if (tagEl) tagEl.textContent = randomQuote.category.replace('latenight', '2 AM Study').toUpperCase();

          textEl.style.opacity = '1';
          textEl.style.transform = 'translateY(0)';
          authorEl.style.opacity = '1';
        }, 250);
      }
    };

    window.copyQuote = function () {
      const text = `${document.getElementById('quoteText').textContent} ${document.getElementById('quoteAuthor').textContent}`;
      navigator.clipboard.writeText(text).then(() => {
        showToast("📋 Quote copied to clipboard!");
      }).catch(() => {
        showToast("Quote ready to copy!");
      });
    };

    window.shareQuote = function () {
      const text = document.getElementById('quoteText').textContent;
      const author = document.getElementById('quoteAuthor').textContent;
      if (navigator.share) {
        navigator.share({
          title: '2 AM Study Inspiration',
          text: `${text} ${author} — via 2 AM Study`,
          url: window.location.href
        }).catch(() => {});
      } else {
        copyQuote();
      }
    };

    window.downloadQuote = async function () {
      const captureArea = document.getElementById('quoteCaptureArea');
      const noExportItems = captureArea.querySelectorAll('.no-export');

      noExportItems.forEach(el => el.style.display = 'none');
      showToast("🎨 Rendering high-res quote card...");

      try {
        const canvas = await html2canvas(captureArea, {
          scale: 2,
          backgroundColor: null,
          useCORS: true
        });

        const link = document.createElement('a');
        link.download = `2AM_Study_Quote_${Date.now()}.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
        showToast("✅ Image downloaded successfully!");
      } catch (err) {
        console.error(err);
        showToast("Could not export image.");
      } finally {
        noExportItems.forEach(el => el.style.display = '');
      }
    };

    // Category button binding
    document.querySelectorAll('.quote-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.quote-filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentCategory = btn.dataset.category;
        generateNewQuote();
      });
    });

    // Spacebar listener for quick quote generation
    document.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') {
        e.preventDefault();
        generateNewQuote();
      }
    });

    // Init theme & quote
    setQuoteTheme('midnight');
    generateNewQuote();
  })();
</script>

<%- include('partials/footer') %>
<%- include('partials/header') %>

<section class="how-it-works-hero py-5" style="padding-top: 90px !important; background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 60%, #0f172a 100%);">
  <div class="container py-5 text-center text-white">
    <div class="d-inline-flex align-items-center gap-2 px-4 py-2 rounded-pill mb-4 fw-semibold small"
      style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(8px);">
      🛡️ Student Identity Shield
    </div>
    <h1 class="display-4 fw-extrabold mb-4" style="letter-spacing: -0.03em; line-height: 1.1;">
      How Student Identity<br>
      <span style="background: linear-gradient(135deg, #60a5fa, #34d399); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Shield Works</span>
    </h1>
    <p class="lead mb-5 mx-auto" style="max-width: 640px; color: rgba(255,255,255,0.75);">
      Protecting students from fake social media profiles is a community effort. Here's how the process works — from submission to resolution.
    </p>

    <!-- Quick Action Buttons -->
    <div class="d-flex flex-wrap gap-3 justify-content-center">
      <a href="/student-safety/report" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow-lg">
        🚨 Report a Fake Profile
      </a>
      <a href="/student-safety/cases" class="btn btn-outline-light btn-lg rounded-pill px-5 fw-bold">
        📋 Browse Active Cases
      </a>
    </div>
  </div>
</section>

<main class="py-5 bg-light">
  <div class="container py-3">

    <!-- 5-Step Process Timeline -->
    <div class="text-center mb-5">
      <h2 class="h3 fw-extrabold text-dark mb-2">The 5-Step Process</h2>
      <p class="text-muted small">Every report follows this structured, human-reviewed process.</p>
    </div>

    <div class="d-flex flex-column gap-4 mb-5">

      <!-- Step 1 -->
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden hiw-step-card">
        <div class="row g-0">
          <div class="col-lg-2 hiw-step-number d-flex align-items-center justify-content-center text-white py-4 py-lg-0"
            style="background: linear-gradient(135deg, #dc2626, #b91c1c); min-height: 120px;">
            <div class="text-center">
              <div class="display-5 mb-1">📝</div>
              <div class="fw-extrabold small text-uppercase opacity-75">Step 1</div>
            </div>
          </div>
          <div class="col-lg-10 p-4 p-lg-5">
            <h3 class="h4 fw-extrabold text-dark mb-3">Report a Fake Profile</h3>
            <p class="text-muted mb-3">If you find a fake account impersonating yourself or another student, submit a report with the following information:</p>
            <div class="row g-3">
              <div class="col-md-6">
                <ul class="list-unstyled mb-0">
                  <li class="d-flex align-items-start gap-2 mb-2">
                    <span class="text-danger mt-1 flex-shrink-0">→</span>
                    <span class="text-dark small">Select the social media platform (Instagram, Facebook, X, LinkedIn, etc.)</span>
                  </li>
                  <li class="d-flex align-items-start gap-2 mb-2">
                    <span class="text-danger mt-1 flex-shrink-0">→</span>
                    <span class="text-dark small">Enter the fake profile link and the fake username</span>
                  </li>
                  <li class="d-flex align-items-start gap-2 mb-2">
                    <span class="text-danger mt-1 flex-shrink-0">→</span>
                    <span class="text-dark small">Explain why you believe it's fake or impersonating</span>
                  </li>
                </ul>
              </div>
              <div class="col-md-6">
                <ul class="list-unstyled mb-0">
                  <li class="d-flex align-items-start gap-2 mb-2">
                    <span class="text-danger mt-1 flex-shrink-0">→</span>
                    <span class="text-dark small">Upload screenshots or other supporting evidence (JPG, PNG, PDF — up to 5 files)</span>
                  </li>
                  <li class="d-flex align-items-start gap-2 mb-2">
                    <span class="text-danger mt-1 flex-shrink-0">→</span>
                    <span class="text-dark small">Choose anonymous reporting if you prefer to remain private</span>
                  </li>
                  <li class="d-flex align-items-start gap-2">
                    <span class="text-danger mt-1 flex-shrink-0">→</span>
                    <span class="text-dark small">Submit — your report is securely stored and queued for review</span>
                  </li>
                </ul>
              </div>
            </div>
            <div class="alert alert-danger border-0 rounded-3 mt-3 p-3 small mb-0 d-flex gap-2 align-items-start">
              <span class="flex-shrink-0">🔒</span>
              <span>Every report is securely stored. Only authorized moderators can view evidence and reporter details.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden hiw-step-card">
        <div class="row g-0">
          <div class="col-lg-2 hiw-step-number d-flex align-items-center justify-content-center text-white py-4 py-lg-0"
            style="background: linear-gradient(135deg, #2563eb, #1d4ed8); min-height: 120px;">
            <div class="text-center">
              <div class="display-5 mb-1">🔍</div>
              <div class="fw-extrabold small text-uppercase opacity-75">Step 2</div>
            </div>
          </div>
          <div class="col-lg-10 p-4 p-lg-5">
            <h3 class="h4 fw-extrabold text-dark mb-3">Moderator Verification</h3>
            <p class="text-muted mb-4">Our moderation team carefully reviews every report. <strong class="text-dark">Reports are reviewed by real human moderators</strong> — not automated systems — to ensure accuracy and fairness.</p>
            <div class="row g-3">
              <div class="col-md-4">
                <div class="p-3 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25 text-center h-100">
                  <div class="fs-3 mb-2">✅</div>
                  <div class="fw-bold text-success small mb-1">Verify</div>
                  <div class="text-muted" style="font-size: 12px;">Report is genuine and has sufficient evidence. Case is published for community support.</div>
                </div>
              </div>
              <div class="col-md-4">
                <div class="p-3 rounded-3 bg-warning bg-opacity-10 border border-warning border-opacity-25 text-center h-100">
                  <div class="fs-3 mb-2">📩</div>
                  <div class="fw-bold text-warning small mb-1">Request Evidence</div>
                  <div class="text-muted" style="font-size: 12px;">Additional proof or context is needed before a decision can be made.</div>
                </div>
              </div>
              <div class="col-md-4">
                <div class="p-3 rounded-3 bg-danger bg-opacity-10 border border-danger border-opacity-25 text-center h-100">
                  <div class="fs-3 mb-2">❌</div>
                  <div class="fw-bold text-danger small mb-1">Reject</div>
                  <div class="text-muted" style="font-size: 12px;">Insufficient evidence, or the report violates community guidelines.</div>
                </div>
              </div>
            </div>
            <div class="alert alert-primary border-0 rounded-3 mt-3 p-3 small mb-0 d-flex gap-2 align-items-start">
              <span class="flex-shrink-0">ℹ️</span>
              <span><strong>Only verified cases are published publicly.</strong> Pending, rejected, and evidence-requested cases remain private until a decision is made.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden hiw-step-card">
        <div class="row g-0">
          <div class="col-lg-2 hiw-step-number d-flex align-items-center justify-content-center text-white py-4 py-lg-0"
            style="background: linear-gradient(135deg, #16a34a, #15803d); min-height: 120px;">
            <div class="text-center">
              <div class="display-5 mb-1">🤝</div>
              <div class="fw-extrabold small text-uppercase opacity-75">Step 3</div>
            </div>
          </div>
          <div class="col-lg-10 p-4 p-lg-5">
            <h3 class="h4 fw-extrabold text-dark mb-3">Community Support</h3>
            <p class="text-muted mb-3">Once a case is verified by our moderation team, it becomes publicly visible in the <a href="/student-safety/cases" class="text-success text-decoration-none fw-semibold">Active Cases</a> section. The community can then:</p>
            <div class="d-flex flex-column gap-2 mb-3">
              <div class="d-flex align-items-center gap-3 p-3 bg-white rounded-3 border">
                <span class="text-success fs-4 flex-shrink-0">👁️</span>
                <div>
                  <div class="fw-bold text-dark small">View the verified case</div>
                  <div class="text-muted" style="font-size:12px;">Students can browse fake profile details, reason, description, and verified evidence.</div>
                </div>
              </div>
              <div class="d-flex align-items-center gap-3 p-3 bg-white rounded-3 border">
                <span class="text-success fs-4 flex-shrink-0">👍</span>
                <div>
                  <div class="fw-bold text-dark small">Support the report</div>
                  <div class="text-muted" style="font-size:12px;">One support per logged-in student. Support count reflects community concern.</div>
                </div>
              </div>
              <div class="d-flex align-items-center gap-3 p-3 bg-white rounded-3 border">
                <span class="text-success fs-4 flex-shrink-0">📢</span>
                <div>
                  <div class="fw-bold text-dark small">Share the case</div>
                  <div class="text-muted" style="font-size:12px;">Share via WhatsApp, Telegram, X (Twitter), or copy a direct link to raise awareness.</div>
                </div>
              </div>
            </div>
            <div class="alert border-0 rounded-3 p-3 small mb-0 d-flex gap-2 align-items-start" style="background: #f0fdf4; border-left: 3px solid #16a34a !important;">
              <span class="flex-shrink-0">💡</span>
              <span>Support helps demonstrate community concern but does not automatically determine the outcome on external platforms. You should still report fake accounts directly on those platforms.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden hiw-step-card">
        <div class="row g-0">
          <div class="col-lg-2 hiw-step-number d-flex align-items-center justify-content-center text-white py-4 py-lg-0"
            style="background: linear-gradient(135deg, #7c3aed, #6d28d9); min-height: 120px;">
            <div class="text-center">
              <div class="display-5 mb-1">📊</div>
              <div class="fw-extrabold small text-uppercase opacity-75">Step 4</div>
            </div>
          </div>
          <div class="col-lg-10 p-4 p-lg-5">
            <h3 class="h4 fw-extrabold text-dark mb-3">Case Tracking</h3>
            <p class="text-muted mb-4">Track your report in real time from your <a href="/student-safety/my-reports" class="text-decoration-none fw-semibold" style="color: #7c3aed;">My Reports</a> page. You'll receive notifications whenever your case status changes.</p>

            <!-- Status Pills -->
            <div class="d-flex flex-wrap gap-2 mb-4">
              <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background: #fef9c3; color: #854d0e; font-size: 13px;">🟡 Pending Review</span>
              <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background: #dbeafe; color: #1e40af; font-size: 13px;">🔵 Needs More Evidence</span>
              <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background: #dcfce7; color: #15803d; font-size: 13px;">🟢 Verified</span>
              <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background: #fee2e2; color: #b91c1c; font-size: 13px;">🔴 Rejected</span>
              <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background: #e0e7ff; color: #4338ca; font-size: 13px;">✅ Resolved</span>
            </div>

            <!-- Progress Timeline Visual -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <div class="d-flex flex-column align-items-center text-center" style="min-width: 70px;">
                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold mb-1" style="width:36px;height:36px;font-size:14px;">✓</div>
                <div style="font-size:11px;" class="fw-semibold text-dark">Submitted</div>
              </div>
              <div style="height:2px;flex:1;min-width:20px;background:linear-gradient(to right,#16a34a,#2563eb);"></div>
              <div class="d-flex flex-column align-items-center text-center" style="min-width: 70px;">
                <div class="rounded-circle bg-warning text-white d-flex align-items-center justify-content-center fw-bold mb-1" style="width:36px;height:36px;font-size:14px;">2</div>
                <div style="font-size:11px;" class="fw-semibold text-dark">Under Review</div>
              </div>
              <div style="height:2px;flex:1;min-width:20px;background:#e2e8f0;"></div>
              <div class="d-flex flex-column align-items-center text-center" style="min-width: 70px;">
                <div class="rounded-circle bg-light border text-muted d-flex align-items-center justify-content-center fw-bold mb-1" style="width:36px;height:36px;font-size:14px;">3</div>
                <div style="font-size:11px;" class="text-muted">Verified</div>
              </div>
              <div style="height:2px;flex:1;min-width:20px;background:#e2e8f0;"></div>
              <div class="d-flex flex-column align-items-center text-center" style="min-width: 80px;">
                <div class="rounded-circle bg-light border text-muted d-flex align-items-center justify-content-center fw-bold mb-1" style="width:36px;height:36px;font-size:14px;">4</div>
                <div style="font-size:11px;" class="text-muted">Community<br>Support</div>
              </div>
              <div style="height:2px;flex:1;min-width:20px;background:#e2e8f0;"></div>
              <div class="d-flex flex-column align-items-center text-center" style="min-width: 70px;">
                <div class="rounded-circle bg-light border text-muted d-flex align-items-center justify-content-center fw-bold mb-1" style="width:36px;height:36px;font-size:14px;">5</div>
                <div style="font-size:11px;" class="text-muted">Resolved</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 5 -->
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden hiw-step-card">
        <div class="row g-0">
          <div class="col-lg-2 hiw-step-number d-flex align-items-center justify-content-center text-white py-4 py-lg-0"
            style="background: linear-gradient(135deg, #0891b2, #0e7490); min-height: 120px;">
            <div class="text-center">
              <div class="display-5 mb-1">🎉</div>
              <div class="fw-extrabold small text-uppercase opacity-75">Step 5</div>
            </div>
          </div>
          <div class="col-lg-10 p-4 p-lg-5">
            <h3 class="h4 fw-extrabold text-dark mb-3">Resolution</h3>
            <p class="text-muted mb-4">When a case is resolved by our moderation team, the following happens automatically:</p>
            <div class="row g-3">
              <div class="col-md-6">
                <div class="d-flex align-items-start gap-3">
                  <span class="text-cyan fs-5 flex-shrink-0" style="color: #0891b2;">✔</span>
                  <div>
                    <div class="fw-bold text-dark small mb-1">Report marked as resolved</div>
                    <div class="text-muted" style="font-size:12px;">The case status is updated across the platform.</div>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="d-flex align-items-start gap-3">
                  <span class="fs-5 flex-shrink-0" style="color: #0891b2;">✔</span>
                  <div>
                    <div class="fw-bold text-dark small mb-1">Your case history is updated</div>
                    <div class="text-muted" style="font-size:12px;">Visible in your My Reports dashboard with the full timeline.</div>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="d-flex align-items-start gap-3">
                  <span class="fs-5 flex-shrink-0" style="color: #0891b2;">✔</span>
                  <div>
                    <div class="fw-bold text-dark small mb-1">Supporters are notified</div>
                    <div class="text-muted" style="font-size:12px;">Everyone who supported the case receives a resolution notification.</div>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="d-flex align-items-start gap-3">
                  <span class="fs-5 flex-shrink-0" style="color: #0891b2;">✔</span>
                  <div>
                    <div class="fw-bold text-dark small mb-1">Trust score updated</div>
                    <div class="text-muted" style="font-size:12px;">Your trust score increases for each verified and resolved report.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div><!-- end steps -->

    <!-- Community Guidelines + Privacy + Help — 3 columns -->
    <div class="row g-4 mb-5">
      <!-- Community Guidelines -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
          <div class="fs-2 mb-3">📜</div>
          <h3 class="h5 fw-extrabold text-dark mb-3">Community Guidelines</h3>
          <p class="text-muted small mb-3">To keep Student Identity Shield trustworthy and effective:</p>
          <ul class="list-unstyled d-flex flex-column gap-2">
            <li class="d-flex align-items-start gap-2 small">
              <span class="text-success flex-shrink-0 mt-1">✅</span>
              <span class="text-dark">Report only genuine impersonation or fraud</span>
            </li>
            <li class="d-flex align-items-start gap-2 small">
              <span class="text-success flex-shrink-0 mt-1">✅</span>
              <span class="text-dark">Provide accurate information and evidence</span>
            </li>
            <li class="d-flex align-items-start gap-2 small">
              <span class="text-danger flex-shrink-0 mt-1">❌</span>
              <span class="text-dark">Do not submit false or malicious reports</span>
            </li>
            <li class="d-flex align-items-start gap-2 small">
              <span class="text-danger flex-shrink-0 mt-1">❌</span>
              <span class="text-dark">Do not violate anyone's privacy or misuse others' information</span>
            </li>
          </ul>
          <div class="alert alert-warning border-0 rounded-3 p-3 small mt-3 mb-0">
            ⚠️ Misuse of this feature may result in account restrictions or removal of reports.
          </div>
        </div>
      </div>

      <!-- Privacy & Security -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
          <div class="fs-2 mb-3">🔒</div>
          <h3 class="h5 fw-extrabold text-dark mb-3">Privacy & Security</h3>
          <p class="text-muted small mb-3">Your identity and data are handled with care:</p>
          <ul class="list-unstyled d-flex flex-column gap-2">
            <li class="d-flex align-items-start gap-2 small">
              <span class="text-primary flex-shrink-0 mt-1">🛡️</span>
              <span class="text-dark">Your personal information is protected and never shared publicly</span>
            </li>
            <li class="d-flex align-items-start gap-2 small">
              <span class="text-primary flex-shrink-0 mt-1">🛡️</span>
              <span class="text-dark">Anonymous reporting is available — your name stays hidden</span>
            </li>
            <li class="d-flex align-items-start gap-2 small">
              <span class="text-primary flex-shrink-0 mt-1">🛡️</span>
              <span class="text-dark">Reporter identities are never displayed publicly on case pages</span>
            </li>
            <li class="d-flex align-items-start gap-2 small">
              <span class="text-primary flex-shrink-0 mt-1">🛡️</span>
              <span class="text-dark">Evidence files are reviewed only by authorized moderators</span>
            </li>
            <li class="d-flex align-items-start gap-2 small">
              <span class="text-primary flex-shrink-0 mt-1">🛡️</span>
              <span class="text-dark">All uploads are stored securely via Cloudinary with access controls</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Need Help -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
          <div class="fs-2 mb-3">💬</div>
          <h3 class="h5 fw-extrabold text-dark mb-3">Need Help?</h3>
          <p class="text-muted small mb-4">If you have questions about your report or need assistance, our support team is here for you.</p>
          <div class="d-flex flex-column gap-3">
            <a href="/contact" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold d-flex align-items-center gap-2">
              <i class="fa-solid fa-envelope"></i> Contact Support Team
            </a>
            <a href="https://wa.me/+916202225179" target="_blank" rel="noopener noreferrer"
              class="btn btn-outline-success rounded-pill px-4 py-2 fw-semibold d-flex align-items-center gap-2">
              <i class="fa-brands fa-whatsapp"></i> Chat on WhatsApp
            </a>
            <a href="/student-safety/my-reports" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold d-flex align-items-center gap-2">
              <i class="fa-solid fa-file-lines"></i> Track My Reports
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Final CTA Banner -->
    <div class="card border-0 rounded-4 overflow-hidden shadow-sm mb-2">
      <div class="p-5 text-center text-white" style="background: linear-gradient(135deg, #0f172a, #1e3a5f);">
        <h2 class="h3 fw-extrabold mb-3">Together, We Can Build a Safer Online Space</h2>
        <p class="mb-4 opacity-75">Every verified report makes the student community stronger and more secure.</p>
        <div class="d-flex flex-wrap gap-3 justify-content-center">
          <a href="/student-safety/report" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold">
            🚨 Report a Fake Profile
          </a>
          <a href="/student-safety/cases" class="btn btn-outline-light btn-lg rounded-pill px-5 fw-bold">
            📋 View Active Cases
          </a>
        </div>
      </div>
    </div>

  </div>
</main>

<style>
  .hiw-step-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hiw-step-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.1) !important;
  }
</style>

<%- include('partials/footer') %>

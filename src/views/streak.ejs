<%- include('partials/header') %>

<style>
  .streak-page-wrapper {
    background: #f8fafc;
    min-height: 85vh;
    padding: 2.5rem 0 4rem;
  }

  .leaderboard-hero {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1.5rem;
    padding: 2rem 2.5rem;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
    position: relative;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .leaderboard-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, #4f46e5, #f59e0b, #dc2626);
  }

  .leaderboard-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1.5rem;
    box-shadow: 0 12px 35px rgba(15, 23, 42, 0.04);
    overflow: hidden;
  }

  .rank-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #f1f5f9;
    transition: all 0.2s ease;
  }

  .rank-row:hover {
    background: #fafcff;
  }

  .rank-row.rank-1 {
    background: linear-gradient(90deg, rgba(254, 243, 199, 0.45) 0%, rgba(255, 255, 255, 0.9) 100%);
    border-left: 4px solid #f59e0b;
  }

  .rank-row.rank-user {
    background: linear-gradient(90deg, rgba(99, 102, 241, 0.08) 0%, rgba(255, 255, 255, 0.9) 100%);
    border-left: 4px solid #4f46e5;
  }

  .rank-badge {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .rank-1 .rank-badge {
    background: #f59e0b;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.35);
  }

  .rank-2 .rank-badge {
    background: #94a3b8;
    color: #ffffff;
  }

  .rank-3 .rank-badge {
    background: #d97706;
    color: #ffffff;
  }

  .rank-badge-default {
    background: #f1f5f9;
    color: #475569;
  }

  .time-pill {
    background: #f1f5f9;
    color: #0f172a;
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    border: 1px solid #e2e8f0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .streak-pill {
    background: rgba(245, 158, 11, 0.12);
    color: #b45309;
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    border: 1px solid rgba(245, 158, 11, 0.25);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

</style>

<main class="streak-page-wrapper">
  <div class="container" style="max-width: 860px;">

    <!-- ── Header Section ── -->
    <div class="leaderboard-hero text-center text-md-start">
      <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
        <div>
          <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2 border"
            style="background: rgba(245, 158, 11, 0.1); border-color: rgba(245, 158, 11, 0.25) !important;">
            <i class="fa-solid fa-trophy text-warning"></i>
            <span class="small fw-bold" style="color: #b45309;">Top Performers</span>
          </div>
          <h1 class="fw-bold mb-1" style="color: #0f172a; font-size: clamp(1.6rem, 3.5vw, 2.1rem); letter-spacing: -0.02em;">
            Leaderboard
          </h1>
          <p class="text-muted mb-0" style="font-size: 0.95rem;">
            Live ranking with your current progress.
          </p>
        </div>
        <div class="text-end">
          <a href="/timer" class="btn btn-primary rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="fa-solid fa-stopwatch"></i> Start Study Timer
          </a>
        </div>
      </div>
    </div>

    <!-- ── Main Leaderboard List ── -->
    <div class="leaderboard-card mb-4">
      <div class="p-3.5 px-4 bg-light border-bottom d-flex align-items-center justify-content-between">
        <span class="small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em;">Student Rank</span>
        <span class="small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em;">Study Time &amp; Streak</span>
      </div>

      <div id="leaderboardRows">
        <!-- Rendered by JS based on study hours & live user stats -->
      </div>
    </div>

  </div>
</main>

<script>
  (function () {
    // 1. Get user focus study time from Pomodoro Timer (stored in localStorage as seconds or minutes)
    let totalStudySec = parseInt(localStorage.getItem('PomTotalStudy') || '0', 10);
    let totalMinutes = Math.floor(totalStudySec / 60);

    // Fallback: check other streak / session keys
    if (totalMinutes === 0) {
      const savedMins = parseInt(localStorage.getItem('todayStudyMinutes') || '0', 10);
      if (savedMins > 0) totalMinutes = savedMins;
    }

    // Determine Streak Days (at least 1 day if studied today)
    let streakDays = parseInt(localStorage.getItem('userStudyStreak') || '0', 10);
    if (totalMinutes > 0 && streakDays === 0) {
      streakDays = 1;
      localStorage.setItem('userStudyStreak', '1');
    }

    // Helper to format minutes into clean human-readable study time
    function formatStudyTime(mins) {
      if (!mins || mins <= 0) return '0 min';
      const hrs = Math.floor(mins / 60);
      const remMins = mins % 60;
      if (hrs > 0 && remMins > 0) {
        return `${hrs} hr ${remMins} min`;
      } else if (hrs > 0) {
        return `${hrs} ${hrs === 1 ? 'hour' : 'hours'}`;
      } else {
        return `${remMins} min`;
      }
    }

    // 2. Base Leaderboard List (Top Students ranked by study time)
    const leaderboardData = [
      { name: 'Priya', minutes: 390, streak: 14, isTop: true, avatar: '👩‍🎓' },
      { name: 'Rahul Sharma', minutes: 310, streak: 9, isTop: false, avatar: '👨‍🎓' },
      { name: 'Aarav Patel', minutes: 240, streak: 7, isTop: false, avatar: '⚡' },
      { name: 'Sneha Verma', minutes: 180, streak: 5, isTop: false, avatar: '📚' },
      { name: 'Kavya Nair', minutes: 120, streak: 3, isTop: false, avatar: '🎯' },
    ];

    // Add current user to leaderboard list
    const userEntry = {
      name: 'You (Your Progress)',
      minutes: totalMinutes,
      streak: streakDays,
      isUser: true,
      avatar: '🌟'
    };

    leaderboardData.push(userEntry);

    // Sort descending by study minutes
    leaderboardData.sort((a, b) => b.minutes - a.minutes);

    // 3. Render Leaderboard Rows
    const container = document.getElementById('leaderboardRows');
    let userRank = 1;

    let html = '';
    leaderboardData.forEach((item, index) => {
      const rank = index + 1;
      if (item.isUser) userRank = rank;

      let rowClass = 'rank-row';
      let badgeClass = 'rank-badge-default';

      if (rank === 1) {
        rowClass += ' rank-1';
        badgeClass = '';
      } else if (rank === 2) {
        rowClass += ' rank-2';
        badgeClass = '';
      } else if (rank === 3) {
        rowClass += ' rank-3';
        badgeClass = '';
      }

      if (item.isUser) {
        rowClass += ' rank-user';
      }

      html += `
        <div class="${rowClass}">
          <div class="d-flex align-items-center gap-3">
            <div class="rank-badge ${badgeClass}">
              ${rank === 1 ? '<i class="fa-solid fa-crown"></i>' : '#' + rank}
            </div>
            <div>
              <div class="fw-bold text-dark d-flex align-items-center gap-2">
                <span>${item.avatar} ${item.name}</span>
                ${item.isUser ? '<span class="badge bg-primary text-white rounded-pill px-2 py-0.5" style="font-size: 10px;">YOU</span>' : ''}
                ${rank === 1 ? '<span class="badge bg-warning text-dark rounded-pill px-2 py-0.5" style="font-size: 10px;">Top #1</span>' : ''}
              </div>
              <div class="small text-muted">${item.streak} days consistency</div>
            </div>
          </div>

          <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
            <span class="time-pill">
              <i class="fa-regular fa-clock text-primary"></i> ${formatStudyTime(item.minutes)}
            </span>
            <span class="streak-pill">
              🔥 ${item.streak} ${item.streak === 1 ? 'day' : 'days'}
            </span>
          </div>
        </div>
      `;
    });

    if (container) container.innerHTML = html;
  })();
</script>

<%- include('partials/footer') %>
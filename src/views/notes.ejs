<%- include('partials/header') %>

<style>
  .erc-hero {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 2.5rem 0 2rem;
  }

  .erc-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(99, 102, 241, 0.1);
    color: #4f46e5;
    border: 1px solid rgba(99, 102, 241, 0.25);
    padding: 0.4rem 1.1rem;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .resource-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
  }

  .resource-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
    border-color: rgba(99, 102, 241, 0.3);
  }

  .resource-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 4px; height: 100%;
    background: #4f46e5;
    border-radius: 16px 0 0 16px;
  }

  .cat-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.22rem 0.65rem;
    border-radius: 100px;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(99, 102, 241, 0.1);
    color: #4338ca;
  }

  .exam-pill {
    background: #f1f5f9;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    padding: 0.18rem 0.6rem;
    border-radius: 100px;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .btn-visit {
    flex: 1;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 0.58rem 0.8rem;
    font-size: 0.77rem;
    font-weight: 700;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    transition: all 0.2s ease;
  }

  .btn-visit:hover {
    background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
    color: #fff;
    transform: translateY(-1px);
  }

  .btn-copy {
    background: #f8fafc;
    color: #475569;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 0.58rem 0.8rem;
    font-size: 0.77rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    transition: all 0.18s;
  }

  .btn-copy:hover {
    background: #eef2ff;
    border-color: #c7d2fe;
    color: #4f46e5;
  }
</style>

<!-- ── Hero Section ── -->
<section class="erc-hero">
  <div class="container text-center">
    <span class="erc-badge">
      <i class="fa-solid fa-graduation-cap"></i> Exam Resource Center
    </span>
    <h1 class="fw-bold mb-2" style="color: #0f172a; font-size: clamp(1.6rem, 3.5vw, 2.2rem); letter-spacing: -0.02em;">
      Official Exam Study Resources
    </h1>
    <p class="text-muted mx-auto mb-3" style="max-width: 580px; font-size: 0.95rem;">
      Previous year papers, official syllabi, exam notifications &amp; curated student notes.
    </p>

    <!-- Simple Search -->
    <div style="max-width: 500px; margin: 0 auto;">
      <div class="input-group">
        <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3.5 text-muted">
          <i class="fa-solid fa-magnifying-glass"></i>
        </span>
        <input type="text" id="resSearchInput" class="form-control border-start-0 rounded-end-pill py-2 shadow-none"
          placeholder="Search by exam name, paper or topic..." oninput="filterResources(this.value)">
      </div>
    </div>
  </div>
</section>

<!-- ── Main Grid ── -->
<main class="py-5" style="background: #f8fafc; min-height: 60vh;">
  <div class="container">

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 pb-1">
      <span class="small fw-bold text-muted" id="resCountLabel">
        <%= (typeof resources !== 'undefined' && resources.length) ? `${resources.length} Resource Card${resources.length > 1 ? 's' : ''}` : '0 Resource Cards' %>
      </span>
    </div>

    <!-- Cards Grid -->
    <div class="row g-4" id="resCardsGrid">
      <% if (typeof resources !== 'undefined' && resources.length) { %>
        <% resources.forEach(function(r) { %>
        <div class="col-md-6 col-lg-4 res-card-item"
          data-text="<%= (r.title + ' ' + r.exam + ' ' + (r.category || '') + ' ' + (r.description || '')).toLowerCase() %>">
          <div class="resource-card h-100">
            <div class="d-flex align-items-center justify-content-between gap-2">
              <span class="cat-badge">📄 <%= r.category || 'PYQ' %></span>
              <span class="exam-pill"><%= r.exam %></span>
            </div>

            <h3 class="fw-bold fs-6 mb-1 text-dark" style="line-height: 1.35;">
              <%= r.title %>
            </h3>

            <p class="text-muted small mb-2 flex-grow-1" style="font-size: 0.83rem; line-height: 1.55;">
              <%= r.description || 'Official verified study resource for exam preparation.' %>
            </p>

            <div class="d-flex align-items-center gap-2 small text-muted mb-2" style="font-size: 11px;">
              <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-0.5">
                <i class="fa-solid fa-circle-check me-1"></i>Official Link
              </span>
              <% if (r.latestYear) { %>
                <span>&bull; <%= r.latestYear %></span>
              <% } %>
            </div>

            <div class="d-flex gap-2 pt-2 border-top">
              <a href="<%= r.officialUrl %>" target="_blank" rel="noopener noreferrer" class="btn-visit">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> Open Resource
              </a>
              <button class="btn-copy" onclick="copyLink(this, '<%= r.officialUrl %>')" title="Copy link">
                <i class="fa-regular fa-copy"></i>
              </button>
            </div>
          </div>
        </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Clean Empty State (When no cards exist or no match) -->
    <div id="resEmptyState" class="text-center py-5 <%= (typeof resources !== 'undefined' && resources.length) ? 'd-none' : '' %>">
      <div style="font-size: 3rem; opacity: 0.4; margin-bottom: 1rem;">📚</div>
      <h4 class="fw-bold text-dark mb-1">No Resource Cards Added Yet</h4>
      <p class="text-muted small mb-0">Resource cards added by the admin will appear here.</p>
    </div>

  </div>
</main>

<script>
  function filterResources(q) {
    const query = (q || '').trim().toLowerCase();
    const items = document.querySelectorAll('.res-card-item');
    let visibleCount = 0;

    items.forEach(item => {
      const text = item.getAttribute('data-text') || '';
      const match = !query || text.includes(query);
      item.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    const countLabel = document.getElementById('resCountLabel');
    if (countLabel) countLabel.textContent = `${visibleCount} Resource Card${visibleCount !== 1 ? 's' : ''}`;

    const empty = document.getElementById('resEmptyState');
    if (empty) empty.style.display = visibleCount === 0 ? '' : 'none';
  }

  function copyLink(btn, url) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(url).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-check text-success"></i>';
        setTimeout(() => { btn.innerHTML = orig; }, 1500);
      });
    }
  }
</script>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<style>
  .session-page {
    background: radial-gradient(ellipse at 50% 0%, #0d0a1e 0%, #0a0a14 60%, #020209 100%);
    min-height: 100vh;
    padding-top: 40px;
    padding-bottom: 80px;
    color: #f8fafc;
  }
  .sess-card {
    background: rgba(15,10,30,0.72);
    border: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 1.5rem;
    box-shadow: 0 25px 60px rgba(0,0,0,0.5);
    position: relative;
    overflow: hidden;
  }
  .sess-card::before {
    content:'';
    position: absolute;
    top:0;left:0;right:0;
    height: 2px;
    background: linear-gradient(90deg,transparent,#6366f1,#38bdf8,transparent);
  }
  .yt-embed-wrapper {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 0 50px rgba(99,102,241,0.2);
  }
  .yt-embed-wrapper iframe {
    position: absolute;
    top:0;left:0;
    width:100%;height:100%;
    border:none;
  }
  .duration-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(99,102,241,0.12);
    border: 1px solid rgba(99,102,241,0.25);
    color: #a5b4fc;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: 999px;
  }
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: #cbd5e1;
    border-radius: 999px;
    padding: 10px 22px;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .back-btn:hover {
    background: rgba(255,255,255,0.1);
    color: #f8fafc;
    transform: translateX(-2px);
  }
  .watch-yt-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(220,38,38,0.15);
    border: 1px solid rgba(220,38,38,0.35);
    color: #f87171;
    border-radius: 999px;
    padding: 10px 22px;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .watch-yt-btn:hover {
    background: rgba(220,38,38,0.25);
    color: #fca5a5;
  }
  .not-found-box {
    background: rgba(15,10,30,0.7);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 1.5rem;
    padding: 4rem 2rem;
    text-align: center;
    max-width: 540px;
    margin: 6rem auto;
  }
  .not-found-icon { font-size: 4rem; opacity: 0.4; margin-bottom: 1rem; }
</style>

<main class="session-page">
  <div class="container" style="max-width:860px;">

    <% if (!session) { %>
    <!-- 404 Not Found -->
    <div class="not-found-box">
      <div class="not-found-icon">🔍</div>
      <h1 class="text-white fw-bold fs-3 mb-2">Session Not Found</h1>
      <p class="text-muted mb-4">This study session does not exist or may have been removed.</p>
      <a href="/live-study" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back to Live Study</a>
    </div>

    <% } else { %>

    <!-- Back nav -->
    <div class="mb-4">
      <a href="/live-study" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back to Live Study</a>
    </div>

    <div class="sess-card p-4 p-md-5">

      <!-- Header info -->
      <div class="mb-4">
        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
          <% if (session.status === 'LIVE') { %>
          <span class="badge rounded-pill px-3 py-2" style="background:rgba(220,38,38,0.2);color:#f87171;border:1px solid rgba(220,38,38,0.4);font-weight:700;letter-spacing:0.1em;">
            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#ef4444;margin-right:6px;animation:pulse 1.4s infinite;"></span>LIVE
          </span>
          <% } %>
          <% if (session.duration) { %>
          <span class="duration-chip"><i class="fa-regular fa-clock"></i> <%= session.duration %></span>
          <% } %>
          <% if (session.endedAt) { %>
          <span class="small text-muted"><i class="fa-regular fa-calendar me-1"></i><%= new Date(session.endedAt).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %></span>
          <% } else if (session.startedAt) { %>
          <span class="small text-muted"><i class="fa-regular fa-calendar me-1"></i><%= new Date(session.startedAt).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %></span>
          <% } %>
        </div>
        <h1 class="text-white fw-bold mb-2" style="font-size:clamp(1.4rem,3.5vw,2rem);">
          <%= session.title %>
        </h1>
        <% if (session.description) { %>
        <p class="text-muted mb-0" style="font-size:0.95rem;line-height:1.6;max-width:640px;"><%= session.description %></p>
        <% } %>
      </div>

      <!-- YouTube embed -->
      <div class="yt-embed-wrapper mb-4">
        <iframe
          src="https://www.youtube.com/embed/<%= session.youtubeVideoId %>?rel=0&modestbranding=1"
          allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture;web-share"
          allowfullscreen
          title="<%= session.title %>">
        </iframe>
      </div>

      <!-- Action row -->
      <div class="d-flex flex-wrap align-items-center gap-3">
        <a href="<%= session.youtubeUrl %>" target="_blank" rel="noopener noreferrer" class="watch-yt-btn">
          <i class="fa-brands fa-youtube"></i>
          <% if (session.status === 'LIVE') { %>Watch on YouTube<% } else { %>Open on YouTube<% } %>
        </a>
        <a href="/live-study" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back to Live Study</a>
      </div>

    </div>

    <% } %>
  </div>
</main>

<style>
  @keyframes pulse {
    0%,100%{opacity:1;transform:scale(1);}
    50%{opacity:0.4;transform:scale(0.7);}
  }
</style>

<%- include('partials/footer') %>
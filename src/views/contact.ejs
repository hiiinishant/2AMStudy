<%- include('partials/header') %>

<!-- Top Hero Banner (Compact & Animated with 2 AM Study - Matches Music, Blog, & About) -->
<section class="hero-contact-section">
  <div class="container text-center">
    <div class="hero-contact-badge">
      <span class="pulse-dot"></span>
      <span>24/7 Student Support</span>
      <i class="fa-solid fa-headset text-primary ms-1" style="font-size: 0.85rem;"></i>
    </div>
    
    <h1 class="animated-2am-title">
      Contact <span class="gradient-2am-text">2 AM Study</span> Team
    </h1>
    
    <p class="hero-contact-subtitle">
      Have a question, feedback, study resource suggestion, or store inquiry? Drop us a message below.
    </p>
  </div>
</section>

<style>
/* Hero Section & Animations (Matches Music & Blog Page Hero) */
@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes pulseGlow {
  0%, 100% { transform: scale(1); opacity: 0.8; }
  50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 10px rgba(37, 99, 235, 0.7); }
}

.hero-contact-section {
  padding: 85px 16px 24px !important;
  background: radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.08) 0%, transparent 65%), #f8fafc;
  border-bottom: 1px solid rgba(15, 23, 42, 0.06);
}

.hero-contact-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #ffffff;
  border: 1px solid rgba(37, 99, 235, 0.2);
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.08);
  border-radius: 50px;
  padding: 5px 14px;
  font-size: 0.82rem;
  font-weight: 700;
  color: #1e40af;
  margin-bottom: 10px;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #2563eb;
  animation: pulseGlow 1.8s infinite ease-in-out;
}

.animated-2am-title {
  font-size: 2.2rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f172a;
  margin-bottom: 6px;
}

.gradient-2am-text {
  background: linear-gradient(135deg, #2563eb 0%, #7c3aed 45%, #ec4899 75%, #2563eb 100%);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: gradientShift 5s ease infinite;
}

.hero-contact-subtitle {
  font-size: 0.92rem;
  color: #64748b;
  max-width: 640px;
  margin: 0 auto;
  line-height: 1.5;
}

@media (max-width: 768px) {
  .animated-2am-title {
    font-size: 1.65rem;
  }
}

/* Contact Info Cards */
.contact-info-card {
  border: 1px solid rgba(15, 23, 42, 0.08);
  border-radius: 20px;
  background: #ffffff;
  padding: 1.5rem;
  display: flex;
  align-items: flex-start;
  gap: 16px;
  transition: all 0.25s ease;
  margin-bottom: 16px;
}

.contact-info-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
  border-color: rgba(37, 99, 235, 0.3);
}

.contact-icon-box {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}
</style>

<main class="container py-5 my-0">
  <div class="row g-5">
    
    <!-- Left Column: Official Support Channels & Knowledge Hub -->
    <div class="col-lg-5">
      <div class="mb-4">
        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold mb-2">
          <i class="fa-solid fa-bolt me-1 text-warning"></i> Fast Response
        </span>
        <h2 class="fw-bold text-dark display-6 mb-2">We're Here to Help</h2>
        <p class="text-muted">Have a question about your late-night study routine, student store orders, or safety features? Connect with us directly.</p>
      </div>

      <!-- Official Email Card -->
      <a href="mailto:2amstudyofficial@gmail.com" class="text-decoration-none text-dark">
        <div class="contact-info-card">
          <div class="contact-icon-box bg-primary bg-opacity-10 text-primary">
            <i class="fa-solid fa-envelope"></i>
          </div>
          <div>
            <div class="d-flex align-items-center gap-2">
              <h6 class="fw-bold mb-1">Official Student Helpdesk</h6>
              <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Active</span>
            </div>
            <p class="text-muted small mb-0">2amstudyofficial@gmail.com</p>
          </div>
        </div>
      </a>

      <!-- Student Safety Hub Support -->
      <a href="/student-safety" class="text-decoration-none text-dark">
        <div class="contact-info-card">
          <div class="contact-icon-box bg-danger bg-opacity-10 text-danger">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">Student Safety &amp; Emergency Hub</h6>
            <p class="text-muted small mb-0">Confidential reporting &amp; verified student protection</p>
          </div>
        </div>
      </a>

      <!-- Student Store Support -->
      <a href="/store" class="text-decoration-none text-dark">
        <div class="contact-info-card">
          <div class="contact-icon-box bg-warning bg-opacity-10 text-warning">
            <i class="fa-solid fa-bag-shopping"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">Student Store &amp; Order Inquiries</h6>
            <p class="text-muted small mb-0">Merchandise, study kits &amp; delivery tracking</p>
          </div>
        </div>
      </a>

      <!-- Instant FAQs Knowledge Hub -->
      <div class="p-4 rounded-4 bg-light border border-light mt-4">
        <div class="d-flex align-items-center gap-3">
          <div class="contact-icon-box bg-primary text-white">
            <i class="fa-solid fa-circle-question"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">Looking for Instant Answers?</h6>
            <p class="text-muted small mb-2">Find quick answers on study techniques, calculators &amp; account settings.</p>
            <a href="/faqs" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold">
              Explore FAQs Q&amp;A <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Enhanced Interactive Form -->
    <div class="col-lg-7">
      <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border border-1 border-light">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <div>
            <h4 class="fw-bold text-dark mb-1">Send Us a Direct Message</h4>
            <p class="text-muted small mb-0">Fill in the details below and we will get back to you within 24 hours.</p>
          </div>
          <span class="badge bg-light text-muted border px-2.5 py-1.5 rounded-pill small">
            <i class="fa-solid fa-clock text-primary me-1"></i> &lt;24h Response
          </span>
        </div>

        <form id="contactForm" class="needs-validation" novalidate>
          <input type="hidden" name="formName" value="Contact Us Page Form">

          <div class="row g-3">
            
            <!-- Category / Reason for Contact -->
            <div class="col-12">
              <label for="inquiryCategory" class="form-label small fw-bold text-dark mb-1">Topic / Category <span class="text-danger">*</span></label>
              <select class="form-select rounded-3 py-2.5" id="inquiryCategory" name="inquiryCategory" required>
                <option value="" disabled selected>Select what you need help with...</option>
                <option value="Academic Support & Study Tips">🎓 Academic Support &amp; Study Tips</option>
                <option value="Student Store & Order Help">🛍️ Student Store &amp; Order Help</option>
                <option value="Student Safety & Incident Support">🛡️ Student Safety &amp; Incident Support</option>
                <option value="Feature Request or Tool Feedback">⚡ Feature Request or Tool Feedback</option>
                <option value="General Question or Collaboration">🤝 General Question or Collaboration</option>
              </select>
              <div class="invalid-feedback">Please choose a category.</div>
            </div>

            <!-- Full Name -->
            <div class="col-md-6">
              <div class="form-floating">
                <input type="text" class="form-control rounded-3" id="name" name="name" placeholder="John Doe" required>
                <label for="name">Your Full Name <span class="text-danger">*</span></label>
                <div class="invalid-feedback">Please enter your name.</div>
              </div>
            </div>
            
            <!-- Email Address -->
            <div class="col-md-6">
              <div class="form-floating">
                <input type="email" class="form-control rounded-3" id="email" name="email" placeholder="name@example.com" required>
                <label for="email">Email Address <span class="text-danger">*</span></label>
                <div class="invalid-feedback">Please enter a valid email.</div>
              </div>
            </div>

            <!-- Phone Number -->
            <div class="col-12">
              <div class="form-floating">
                <input type="tel" class="form-control rounded-3" id="phone" name="phone" placeholder="Phone Number" required>
                <label for="phone">Phone / Contact Number <span class="text-danger">*</span></label>
                <div class="invalid-feedback">Please enter your phone number.</div>
              </div>
            </div>

            <!-- Message Area with Character Counter -->
            <div class="col-12">
              <div class="form-floating">
                <textarea class="form-control rounded-3" id="message" name="message" placeholder="Leave a message here" style="height: 140px" maxlength="1000" required></textarea>
                <label for="message">Your Message or Question <span class="text-danger">*</span></label>
                <div class="invalid-feedback">Please provide your message.</div>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-1">
                <span class="text-muted" style="font-size: 0.75rem;">Be as detailed as possible to help us assist you faster.</span>
                <span class="text-muted" id="charCounter" style="font-size: 0.75rem;">0 / 1000</span>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="col-12 mt-3">
              <button class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm" type="submit" id="submitBtn">
                <i class="fa-regular fa-paper-plane me-2"></i> Send Direct Message
              </button>
            </div>
          </div>

          <div id="formMessage" class="mt-4 text-center d-none"></div>
        </form>
      </div>
    </div>

  </div>
</main>

<script>
  // Live character counter
  const messageInput = document.getElementById('message');
  const charCounter = document.getElementById('charCounter');
  if (messageInput && charCounter) {
    messageInput.addEventListener('input', () => {
      charCounter.textContent = `${messageInput.value.length} / 1000`;
    });
  }

  // Form submission handler
  document.getElementById('contactForm').addEventListener('submit', async function (e) {
    e.preventDefault();

    const form = this;
    if (!form.checkValidity()) {
      e.stopPropagation();
      form.classList.add('was-validated');
      return;
    }

    const submitBtn = document.getElementById('submitBtn');
    const formMessage = document.getElementById('formMessage');
    const originalBtnHTML = submitBtn.innerHTML;

    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Sending Message...';
    submitBtn.disabled = true;

    try {
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      const category = data.inquiryCategory || 'General';
      data.formName = `Contact Us Form [${category}] | Message: ${data.message}`;

      const response = await fetch('/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      formMessage.classList.remove('d-none', 'text-danger');
      formMessage.classList.add('text-success');

      if (response.ok) {
        formMessage.innerHTML = `
          <div class="alert alert-success border-0 rounded-4 p-3 shadow-sm text-start">
            <div class="d-flex align-items-center gap-2 mb-1">
              <i class="fa-solid fa-circle-check fs-5 text-success"></i>
              <strong class="text-dark">Message Sent Successfully!</strong>
            </div>
            <p class="small mb-0 text-muted">Thank you for reaching out to 2 AM Study. Our team will review your message and reply to <strong>${data.email}</strong> within 24 hours.</p>
          </div>`;
        form.reset();
        if (charCounter) charCounter.textContent = '0 / 1000';
        form.classList.remove('was-validated');
      } else {
        throw new Error(result.error || 'Something went wrong');
      }
    } catch (error) {
      formMessage.classList.remove('d-none', 'text-success');
      formMessage.classList.add('text-danger');
      formMessage.innerHTML = `
        <div class="alert alert-danger border-0 rounded-4 p-3 shadow-sm text-start">
          <div class="d-flex align-items-center gap-2 mb-1">
            <i class="fa-solid fa-circle-exclamation fs-5 text-danger"></i>
            <strong class="text-dark">Submission Failed</strong>
          </div>
          <p class="small mb-0 text-muted">${error.message || 'Could not send message. Please try again or email us directly at 2amstudyofficial@gmail.com.'}</p>
        </div>`;
    } finally {
      submitBtn.innerHTML = originalBtnHTML;
      submitBtn.disabled = false;
    }
  });
</script>

<%- include('partials/footer') %>
<%- include('../partials/header') %>

<!-- Top Hero Banner (Compact & Animated with 2 AM Study - Matches Music, Blog, & About) -->
<section class="hero-calc-section">
  <div class="container text-center">
    <div class="hero-calc-badge">
      <span class="pulse-dot"></span>
      <span>Academic Calculation Suite</span>
      <i class="fa-solid fa-calculator text-primary ms-1" style="font-size: 0.85rem;"></i>
    </div>
    
    <h1 class="animated-2am-title">
      Student Calculator Hub — <span class="gradient-2am-text">2 AM Study</span>
    </h1>
    
    <p class="hero-calc-subtitle">
      Fast, precision-engineered academic and math calculators for CGPA forecasting, scientific equations, exam percentages &amp; entrance age checks.
    </p>
  </div>
</section>

<style>
/* Hero Section & Animations (Matches Music & Blog Page Hero) */
@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes pulseGlow {
  0%, 100% { transform: scale(1); opacity: 0.8; }
  50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 10px rgba(37, 99, 235, 0.7); }
}

.hero-calc-section {
  padding: 85px 16px 24px !important;
  background: radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.08) 0%, transparent 65%), #f8fafc;
  border-bottom: 1px solid rgba(15, 23, 42, 0.06);
}

.hero-calc-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #ffffff;
  border: 1px solid rgba(37, 99, 235, 0.2);
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.08);
  border-radius: 50px;
  padding: 5px 14px;
  font-size: 0.82rem;
  font-weight: 700;
  color: #1e40af;
  margin-bottom: 10px;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #2563eb;
  animation: pulseGlow 1.8s infinite ease-in-out;
}

.animated-2am-title {
  font-size: 2.2rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f172a;
  margin-bottom: 6px;
}

.gradient-2am-text {
  background: linear-gradient(135deg, #2563eb 0%, #7c3aed 45%, #ec4899 75%, #2563eb 100%);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: gradientShift 5s ease infinite;
}

.hero-calc-subtitle {
  font-size: 0.92rem;
  color: #64748b;
  max-width: 660px;
  margin: 0 auto;
  line-height: 1.5;
}

@media (max-width: 768px) {
  .animated-2am-title {
    font-size: 1.65rem;
  }
}

/* Calculator Cards */
.calc-card {
  background: #ffffff;
  border: 1px solid rgba(15, 23, 42, 0.08);
  border-radius: 20px;
  padding: 1.75rem;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.calc-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
  border-color: rgba(37, 99, 235, 0.3);
}

.calc-icon-box {
  width: 54px;
  height: 54px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin-bottom: 1.25rem;
  transition: transform 0.25s ease;
}

.calc-card:hover .calc-icon-box {
  transform: scale(1.08);
}
</style>

<main class="container py-5 my-0">
  <div class="row g-4">

    <!-- 1. Scientific Calculator -->
    <div class="col-md-6 col-lg-3">
      <div class="calc-card">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div class="calc-icon-box bg-primary bg-opacity-10 text-primary">
            <i class="fa-solid fa-calculator"></i>
          </div>
          <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2.5 py-1 fw-bold small">
            Scientific
          </span>
        </div>
        <h5 class="fw-bold text-dark mb-1">Scientific Calculator</h5>
        <p class="text-muted small mb-4 flex-grow-1">
          Perform trigonometry, logarithms, roots, exponents &amp; complex multi-step math calculations with memory keys.
        </p>
        <a href="/calculator" class="btn btn-primary rounded-pill w-100 fw-bold shadow-sm">
          <i class="fa-solid fa-calculator me-1.5"></i> Open Calculator
        </a>
      </div>
    </div>
    
    <!-- 2. CGPA & GPA Calculator -->
    <div class="col-md-6 col-lg-3">
      <div class="calc-card">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div class="calc-icon-box bg-success bg-opacity-10 text-success">
            <i class="fa-solid fa-graduation-cap"></i>
          </div>
          <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1 fw-bold small">
            Academic
          </span>
        </div>
        <h5 class="fw-bold text-dark mb-1">CGPA &amp; GPA Calculator</h5>
        <p class="text-muted small mb-4 flex-grow-1">
          Calculate semester SGPA, cumulative CGPA &amp; university percentage conversions with customized credit weighting.
        </p>
        <a href="/calculators/cgpa" class="btn btn-outline-success rounded-pill w-100 fw-bold">
          <i class="fa-solid fa-chart-pie me-1.5"></i> Calculate CGPA
        </a>
      </div>
    </div>

    <!-- 3. Percentage Calculator -->
    <div class="col-md-6 col-lg-3">
      <div class="calc-card">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div class="calc-icon-box bg-warning bg-opacity-10 text-warning">
            <i class="fa-solid fa-percent"></i>
          </div>
          <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2.5 py-1 fw-bold small">
            Quick Math
          </span>
        </div>
        <h5 class="fw-bold text-dark mb-1">Percentage Calculator</h5>
        <p class="text-muted small mb-4 flex-grow-1">
          Instant calculation of test score percentages, mark increases, fractions &amp; exam cutoff qualifying marks.
        </p>
        <a href="/calculators/percentage" class="btn btn-outline-warning rounded-pill w-100 fw-bold text-dark">
          <i class="fa-solid fa-percent me-1.5"></i> Find Percentage
        </a>
      </div>
    </div>

    <!-- 4. Age & Exam Eligibility Evaluator -->
    <div class="col-md-6 col-lg-3">
      <div class="calc-card">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div class="calc-icon-box bg-danger bg-opacity-10 text-danger">
            <i class="fa-solid fa-cake-candles"></i>
          </div>
          <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2.5 py-1 fw-bold small">
            Eligibility
          </span>
        </div>
        <h5 class="fw-bold text-dark mb-1">Age &amp; Date Evaluator</h5>
        <p class="text-muted small mb-4 flex-grow-1">
          Find your exact chronological age in years, months, and days to verify competitive exam &amp; admission eligibility.
        </p>
        <a href="/calculators/age" class="btn btn-outline-danger rounded-pill w-100 fw-bold">
          <i class="fa-solid fa-calendar-check me-1.5"></i> Check Age
        </a>
      </div>
    </div>

  </div>

  <div class="text-center mt-5">
    <a href="/study-tools" class="btn btn-link text-muted fw-bold text-decoration-none">
      <i class="fa-solid fa-arrow-left me-2"></i> Back to Study Tools Hub
    </a>
  </div>
</main>

<%- include('../partials/footer') %>

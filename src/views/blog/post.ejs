<%- include('../partials/header') %>

<style>
  :root {
    --blog-primary: #2874f0;
    --blog-text: #1f2937;
    --blog-muted: #6b7280;
  }

  .blog-article-header {
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    padding: 60px 0 30px;
    border-bottom: 1px solid #e2e8f0;
  }

  .blog-breadcrumb {
    font-size: 13px;
    margin-bottom: 16px;
  }
  .blog-breadcrumb a { color: var(--blog-primary); text-decoration: none; font-weight: 600; }
  .blog-breadcrumb span { color: #94a3b8; margin: 0 6px; }

  .blog-category-badge {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(40, 116, 240, 0.1);
    color: var(--blog-primary);
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 14px;
  }

  .blog-title {
    font-size: 2.4rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
    margin-bottom: 18px;
    letter-spacing: -0.5px;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    color: var(--blog-muted);
    font-size: 14px;
  }

  .blog-author-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: #334155;
  }

  .blog-author-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #2563eb;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
  }

  .blog-featured-img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    margin: 30px 0;
  }

  .article-body {
    font-size: 1.1rem;
    line-height: 1.85;
    color: #334155;
  }

  .article-body h2 {
    font-size: 1.7rem;
    font-weight: 800;
    color: #0f172a;
    margin-top: 40px;
    margin-bottom: 16px;
    letter-spacing: -0.3px;
  }

  .article-body h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #1e293b;
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .article-body p {
    margin-bottom: 20px;
  }

  .article-body ul, .article-body ol {
    margin-bottom: 24px;
    padding-left: 28px;
  }

  .article-body li {
    margin-bottom: 8px;
  }

  .article-body blockquote {
    border-left: 4px solid var(--blog-primary);
    padding: 16px 20px;
    background: #f8fafc;
    border-radius: 0 12px 12px 0;
    font-style: italic;
    color: #475569;
    margin: 28px 0;
  }

  .article-body .pro-tip {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-left: 5px solid #22c55e;
    padding: 18px 22px;
    border-radius: 12px;
    margin: 28px 0;
    color: #166534;
  }

  .article-body .pro-tip strong { color: #14532d; }

  .share-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 0;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    margin: 40px 0;
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .share-btn:hover { opacity: 0.9; }

  .store-promo-card {
    background: linear-gradient(135deg, #1e3a8a, #2563eb);
    border-radius: 16px;
    padding: 32px;
    color: #fff;
    margin: 40px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
</style>

<div class="blog-article-header">
  <div class="container" style="max-width: 860px;">
    <div class="blog-breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/blog">Blog</a>
      <span>/</span>
      <span style="color: #64748b;"><%= post.title %></span>
    </div>

    <div class="blog-category-badge"><%= post.category || 'Study Tips' %></div>
    <h1 class="blog-title"><%= post.title %></h1>

    <div class="blog-meta">
      <div class="blog-author-badge">
        <div class="blog-author-avatar"><%= (post.author || 'N')[0].toUpperCase() %></div>
        <span><%= post.author || 'Nishant Kumar' %></span>
      </div>
      <span>•</span>
      <span><i class="fa-regular fa-calendar me-1"></i> <%= post.date || new Date().toISOString().split('T')[0] %></span>
      <span>•</span>
      <span><i class="fa-regular fa-clock me-1"></i> <%= post.readTime || '5 min read' %></span>
      <% if (post.views) { %>
        <span>•</span>
        <span><i class="fa-regular fa-eye me-1"></i> <%= post.views %> reads</span>
      <% } %>
    </div>
  </div>
</div>

<main class="container py-4" style="max-width: 860px;">
  <% if (post.image) { %>
    <img src="<%= post.image %>" alt="<%= post.title %>" class="blog-featured-img" onerror="this.src='/assets/images/smart_study_banner.png'">
  <% } %>

  <div class="article-body">
    <%- post.content %>
  </div>

  <!-- Share Bar -->
  <div class="share-bar">
    <span style="font-weight: 700; color: #334155;">Share this article:</span>
    <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(post.title + ' - https://2amstudy.com/blog/' + post.slug) %>" target="_blank" class="share-btn" style="background:#25D366; color:#fff;">
      <i class="fa-brands fa-whatsapp"></i> WhatsApp
    </a>
    <a href="https://t.me/share/url?url=<%= encodeURIComponent('https://2amstudy.com/blog/' + post.slug) %>&text=<%= encodeURIComponent(post.title) %>" target="_blank" class="share-btn" style="background:#0088cc; color:#fff;">
      <i class="fa-brands fa-telegram"></i> Telegram
    </a>
    <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title + ' https://2amstudy.com/blog/' + post.slug) %>" target="_blank" class="share-btn" style="background:#000; color:#fff;">
      <i class="fa-brands fa-x-twitter"></i> Post
    </a>
    <button onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!');" class="share-btn" style="background:#f1f5f9; color:#334155; border: 1px solid #cbd5e1; cursor:pointer;">
      <i class="fa-regular fa-copy"></i> Copy Link
    </button>
  </div>

  <!-- Store Promo Banner -->
  <div class="store-promo-card">
    <div>
      <h3 style="font-size: 1.3rem; font-weight: 800; margin-bottom: 8px;">Upgrade Your Study Setup 🎒</h3>
      <p style="color: rgba(255,255,255,0.85); font-size: 14px; margin: 0;">Explore notebooks, focus essentials, study lamps, and insulated bottles on 2 AM Study Store.</p>
    </div>
    <a href="/store" class="btn btn-light" style="font-weight: 700; border-radius: 100px; padding: 10px 24px; color: #1e3a8a; white-space: nowrap;">
      Explore Store <i class="fa-solid fa-arrow-right ms-1"></i>
    </a>
  </div>

  <!-- Back to Blogs -->
  <div class="text-center my-5">
    <a href="/blog" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-bold">
      <i class="fa-solid fa-arrow-left me-2"></i> Back to All Articles
    </a>
  </div>
</main>

<%- include('../partials/footer') %>

            ${c.verifiedBy ? `<div class="col-12"><span class="text-muted fw-semibold">Verified by:</span> <code>${escHtml(c.verifiedByName || c.verifiedBy)}</code> at ${c.verifiedAt ? new Date(c.verifiedAt).toLocaleString('en-IN') : ''}</div>` : ''}
            ${c.resolvedBy ? `<div class="col-12"><span class="text-muted fw-semibold">Resolved by:</span> <code>${escHtml(c.resolvedBy)}</code> at ${c.resolvedAt ? new Date(c.resolvedAt).toLocaleString('en-IN') : ''}</div>` : ''}
          </div>
        </div>
      </div>
    `;

    // Footer action buttons
    document.getElementById('offcanvasFooter').innerHTML = `
      <button class="btn btn-success fw-bold rounded-pill px-3 action-btn" data-action="approve" title="Approve [A]">✅ Approve</button>
      <button class="btn btn-danger fw-bold rounded-pill px-3 action-btn" data-action="reject" title="Reject [R]">❌ Reject</button>
      <button class="btn btn-info text-dark fw-bold rounded-pill px-3 action-btn" data-action="request_evidence" title="Request Evidence [E]">📩 Evidence</button>
      <button class="btn btn-primary fw-bold rounded-pill px-3 action-btn" data-action="resolve" title="Resolve [S]">✔ Resolve</button>
      <button class="btn btn-warning fw-bold rounded-pill px-3 action-btn" data-action="reopen">🔄 Reopen</button>
      <button class="btn btn-outline-danger fw-bold rounded-pill px-3 action-btn" data-action="delete">🗑 Delete</button>
    `;

    document.querySelectorAll('.action-btn').forEach(btn => {
      btn.addEventListener('click', () => openActionModal(btn.getAttribute('data-action'), c.caseId));
    });

    // Lightbox for evidence images
    document.querySelectorAll('.evidence-img-thumb').forEach(el => {
      el.addEventListener('click', () => openLightbox(el.getAttribute('data-url')));
    });

    bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('caseOffcanvas')).show();
  }

  // expose for duplicate merge button
  window.triggerMerge = function(targetId, sourceId) {
    openActionModal('merge', targetId, sourceId);
  };

  // ── Open Action Modal ──
  function openActionModal(action, caseId, prefillSourceId = '') {
    pendingAction = { action, caseId };
    const modal = document.getElementById('actionConfirmModal');
    const titleEl = document.getElementById('actionModalTitle');
    const descEl = document.getElementById('actionModalDesc');
    const noteSection = document.getElementById('actionNoteSection');
    const noteLabelEl = document.getElementById('actionNoteLabel');
    const noteInput = document.getElementById('actionNoteInput');
    const deleteWarning = document.getElementById('actionDeleteWarning');
    const mergeSection = document.getElementById('actionMergeSection');
    const confirmBtn = document.getElementById('actionConfirmBtn');
    const header = document.getElementById('actionModalHeader');

    noteSection.classList.add('d-none');
    deleteWarning.classList.add('d-none');
    mergeSection.classList.add('d-none');
    noteInput.value = '';
    noteInput.classList.remove('is-invalid');
    document.getElementById('mergeCaseIdInput').value = prefillSourceId;

    const configs = {
      approve: { title: '✅ Approve & Publish Case', desc: `Approve case <strong>${caseId}</strong> — it will be marked <strong>Verified</strong> and visible to the community.`, btnClass: 'btn-success', btnText: 'Approve', headerBg: '#f0fdf4' },
      reject: { title: '❌ Reject Report', desc: `Reject case <strong>${caseId}</strong>. The reporter will be notified with your reason.`, btnClass: 'btn-danger', btnText: 'Reject', headerBg: '#fff1f2', needsNote: true, noteLabel: 'Rejection Reason *' },
      request_evidence: { title: '📩 Request More Evidence', desc: `Ask for more evidence on case <strong>${caseId}</strong>. Status will change to <em>Needs Evidence</em>.`, btnClass: 'btn-info', btnText: 'Send Request', headerBg: '#eff6ff', needsNote: true, noteLabel: 'Evidence Required (Moderator Note) *' },
      resolve: { title: '✔ Mark as Resolved', desc: `Mark case <strong>${caseId}</strong> as <strong>Resolved</strong>. Use this when the fake account has been removed.`, btnClass: 'btn-primary', btnText: 'Mark Resolved', headerBg: '#f5f3ff' },
      reopen: { title: '🔄 Reopen Case', desc: `Reopen case <strong>${caseId}</strong> — status returns to <em>Pending Review</em>.`, btnClass: 'btn-warning text-dark', btnText: 'Reopen', headerBg: '#fffbeb' },
      delete: { title: '🗑 Delete Case', desc: `Permanently delete case <strong>${caseId}</strong>.`, btnClass: 'btn-danger', btnText: 'Delete Permanently', headerBg: '#fff1f2', showDeleteWarning: true },
      merge: { title: '🔗 Merge Cases', desc: `Merge a duplicate case into <strong>${caseId}</strong>. Evidence and support count will be combined.`, btnClass: 'btn-secondary', btnText: 'Merge Cases', headerBg: '#f8fafc', showMerge: true }
    };
    const cfg = configs[action] || { title: 'Confirm', desc: '', btnClass: 'btn-primary', btnText: 'Confirm' };

    titleEl.textContent = cfg.title;
    descEl.innerHTML = cfg.desc;
    confirmBtn.className = `btn rounded-pill px-5 fw-bold ${cfg.btnClass}`;
    confirmBtn.textContent = cfg.btnText;
    header.style.background = cfg.headerBg || '#fff';

    if (cfg.needsNote) { noteSection.classList.remove('d-none'); noteLabelEl.innerHTML = cfg.noteLabel; }
    if (cfg.showDeleteWarning) deleteWarning.classList.remove('d-none');
    if (cfg.showMerge) mergeSection.classList.remove('d-none');

    confirmBtn.onclick = () => executeAction();
    bootstrap.Modal.getOrCreateInstance(modal).show();
  }

  // ── Execute Action ──
  async function executeAction() {
    if (!pendingAction) return;
    const { action, caseId } = pendingAction;
    const noteInput = document.getElementById('actionNoteInput');
    const note = noteInput.value.trim();

    if ((action === 'reject' || action === 'request_evidence') && !note) {
      noteInput.classList.add('is-invalid');
      return;
    }
    noteInput.classList.remove('is-invalid');

    let body = { caseId, action, note, moderatorUid, moderatorName };
    if (action === 'merge') {
      body.sourceCaseId = document.getElementById('mergeCaseIdInput').value.trim();
      if (!body.sourceCaseId) { alert('Please enter a source Case ID.'); return; }
    }

    const confirmBtn = document.getElementById('actionConfirmBtn');
    confirmBtn.disabled = true;
    confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing…';

    try {
      const res = await fetch('/api/student-safety/admin/moderate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const result = await res.json();

      if (!res.ok || !result.success) {
        alert(result.message || 'Action failed.');
        confirmBtn.disabled = false;
        confirmBtn.textContent = 'Confirm';
        return;
      }

      // Firestore audit log
      try {
        await addDoc(collection(db, 'studentSafetyModerationLogs'), {
          caseId, moderatorUid, moderatorName, action,
          reason: note || (action + ' action'),
          createdAt: serverTimestamp()
        });
      } catch (_) {}

      bootstrap.Modal.getOrCreateInstance(document.getElementById('actionConfirmModal')).hide();
      bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('caseOffcanvas')).hide();
      pendingAction = null;

      // Animated toast
      showToast(`✅ Case ${caseId} updated: ${result.status}`, 'success');
      await loadCases();
      loadAuditLogs();
    } catch (err) {
      console.error(err);
      alert('Network error. Please try again.');
      confirmBtn.disabled = false;
      confirmBtn.textContent = 'Confirm';
    }
  }

  // ── Bulk Actions ──
  function setupBulkActions() {
    document.getElementById('bulkApproveBtn').addEventListener('click', () => executeBulk('approve'));
    document.getElementById('bulkRejectBtn').addEventListener('click', () => {
      const reason = prompt('Rejection reason for all selected cases:');
      if (!reason || !reason.trim()) return;
      executeBulk('reject', reason.trim());
    });
    document.getElementById('bulkDeleteBtn').addEventListener('click', () => {
      if (!confirm(`Delete ${selectedCaseIds.size} selected cases permanently?`)) return;
      executeBulk('delete');
    });
    document.getElementById('clearSelectionBtn').addEventListener('click', () => {
      selectedCaseIds.clear();
      updateBulkBar();
      renderTable();
    });
  }

  async function executeBulk(action, note = '') {
    if (selectedCaseIds.size === 0) return;
    const body = { caseIds: Array.from(selectedCaseIds), action, note, moderatorUid, moderatorName };
    try {
      const res = await fetch('/api/student-safety/admin/moderate/bulk', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
      });
      const result = await res.json();
      if (!result.success) { alert(result.message || 'Bulk action failed.'); return; }
      showToast(`✅ Bulk ${action}: ${result.processed} cases updated`, 'success');
      selectedCaseIds.clear();
      updateBulkBar();
      await loadCases();
      loadAuditLogs();
    } catch (err) { alert('Network error.'); }
  }

  function updateBulkBar() {
    const bar = document.getElementById('bulkActionsBar');
    const count = document.getElementById('bulkSelectedCount');
    if (selectedCaseIds.size > 0) {
      bar.classList.remove('d-none');
      count.textContent = `${selectedCaseIds.size} selected`;
    } else {
      bar.classList.add('d-none');
    }
  }

  // ── Select All ──
  function setupSelectAll() {
    document.getElementById('selectAllCheckbox').addEventListener('change', function() {
      const pageItems = filteredCases.slice((currentPage-1)*PAGE_SIZE, currentPage*PAGE_SIZE);
      if (this.checked) pageItems.forEach(c => selectedCaseIds.add(c.caseId));
      else pageItems.forEach(c => selectedCaseIds.delete(c.caseId));
      updateBulkBar();
      renderTable();
    });
  }

  function updateSelectAllCheckbox() {
    const cb = document.getElementById('selectAllCheckbox');
    const pageItems = filteredCases.slice((currentPage-1)*PAGE_SIZE, currentPage*PAGE_SIZE);
    cb.checked = pageItems.length > 0 && pageItems.every(c => selectedCaseIds.has(c.caseId));
    cb.indeterminate = !cb.checked && pageItems.some(c => selectedCaseIds.has(c.caseId));
  }

  // ── Audit Logs ──
  async function loadAuditLogs() {
    const tbody = document.getElementById('auditLogBody');
    try {
      const res = await fetch('/api/student-safety/moderation-logs');
      const data = await res.json();
      const logs = data.logs || [];
      if (logs.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="text-center text-muted py-4">No audit logs yet.</td></tr>`;
        return;
      }
      tbody.innerHTML = logs.slice(0, 100).map(l => `
        <tr>
          <td><code class="small text-muted">${escHtml(l.logId||'—')}</code></td>
          <td><code class="small text-primary">${escHtml(l.caseId||'—')}</code></td>
          <td><span class="small">${escHtml(l.moderatorName||l.moderatorUid||'—')}</span></td>
          <td>${actionBadge(l.action)}</td>
          <td><span class="small text-muted">${escHtml(l.previousStatus||'—')}</span></td>
          <td><span class="small">${escHtml(l.newStatus||'—')}</span></td>
          <td><span class="small text-muted" style="max-width:200px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(l.reason||'—')}</span></td>
          <td><span class="small text-muted">${l.createdAt ? new Date(l.createdAt).toLocaleString('en-IN') : '—'}</span></td>
        </tr>
      `).join('');
    } catch(err) {
      tbody.innerHTML = `<tr><td colspan="8" class="text-center text-danger py-3">Failed to load logs.</td></tr>`;
    }
  }

  // ── Tabs ──
  function setupTabs() {
    document.querySelectorAll('[data-tab]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-tab]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const tab = btn.getAttribute('data-tab');
        document.getElementById('tab-queue').classList.toggle('d-none', tab !== 'queue');
        document.getElementById('tab-logs').classList.toggle('d-none', tab !== 'logs');
      });
    });
  }

  // ── Keyboard Shortcuts ──
  function setupKeyboardShortcuts() {
    document.addEventListener('keydown', e => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;
      if (!activeInspectCase) return;
      const map = { a: 'approve', r: 'reject', e: 'request_evidence', s: 'resolve' };
      if (map[e.key.toLowerCase()]) openActionModal(map[e.key.toLowerCase()], activeInspectCase.caseId);
      if (e.key === 'Escape') bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('caseOffcanvas')).hide();
    });
  }

  // ── Lightbox ──
  function setupLightbox() {
    const lb = document.getElementById('imgLightbox');
    document.getElementById('imgLightboxClose').addEventListener('click', () => lb.classList.remove('show'));
    lb.addEventListener('click', e => { if (e.target === lb) lb.classList.remove('show'); });
  }
  function openLightbox(url) {
    document.getElementById('imgLightboxImg').src = url;
    document.getElementById('imgLightbox').classList.add('show');
  }

  // ── Toast ──
  function showToast(message, type = 'success') {
    const toastEl = document.createElement('div');
    toastEl.className = `toast align-items-center border-0 text-white bg-${type === 'success' ? 'success' : 'danger'} position-fixed`;
    toastEl.style.cssText = 'bottom:24px;right:24px;z-index:99999;min-width:280px;border-radius:1rem;';
    toastEl.innerHTML = `<div class="d-flex"><div class="toast-body fw-semibold">${message}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>`;
    document.body.appendChild(toastEl);
    const t = new bootstrap.Toast(toastEl, { delay: 4000 });
    t.show();
    toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
  }

  // ── Helpers ──
  function escHtml(str) {
    return String(str||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function statusBadge(status) {
    const map = {
      'Pending Review': 'background:#fef3c7;color:#92400e;',
      'Needs Evidence': 'background:#dbeafe;color:#1e40af;',
      'Verified': 'background:#d1fae5;color:#065f46;',
      'Rejected': 'background:#fee2e2;color:#991b1b;',
      'Resolved': 'background:#ede9fe;color:#4c1d95;'
    };
    const style = map[status] || 'background:#f1f5f9;color:#475569;';
    return `<span class="status-badge" style="${style}">${escHtml(status)}</span>`;
  }
  function statusText(status) { return status || 'Unknown'; }
  function actionBadge(action) {
    const map = { approve:'success', reject:'danger', request_evidence:'info', resolve:'primary', reopen:'warning', delete:'dark', merge:'secondary' };
    return `<span class="badge bg-${map[action]||'secondary'} small">${escHtml(action||'—')}</span>`;
  }
</script>


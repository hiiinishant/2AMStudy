  #imgLightbox.show { display:flex!important; }
  .reporter-admin-section { background:linear-gradient(135deg,#fef2f2,#fff7ed);border:1px solid #fca5a5;border-radius:.75rem;padding:1rem; }
</style>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-app.js";
  import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-auth.js";
  import { getFirestore, collection, doc, getDoc, getDocs, addDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyCvJRS3UusvUrVCd2JSicBGL-uRD82GpNM",
    authDomain: "am-study-7ea87.firebaseapp.com",
    projectId: "am-study-7ea87",
    storageBucket: "am-study-7ea87.firebasestorage.app",
    messagingSenderId: "270924691236",
    appId: "1:270924691236:web:7ada12dcf50c290d0925b1"
  };

  const fbApp = initializeApp(firebaseConfig);
  const auth = getAuth(fbApp);
  const db = getFirestore(fbApp);

  // ── Globals ──
  let moderatorUid = '';
  let moderatorName = '';
  let allCases = [];
  let filteredCases = [];
  let selectedCaseIds = new Set();
  let currentPage = 1;
  const PAGE_SIZE = 20;
  let activeInspectCase = null;
  let pendingAction = null;

  // ── Auth Gate ──
  onAuthStateChanged(auth, async (user) => {
    const overlay = document.getElementById('authOverlay');
    if (!user) {
      overlay.remove();
      window.location.href = '/login?redirect=/student-safety/admin';
      return;
    }

    // Check Firestore role
    try {
      const userDoc = await getDoc(doc(db, 'users', user.uid));
      if (!userDoc.exists() || userDoc.data().role !== 'admin') {
        overlay.remove();
        document.getElementById('forbiddenCard').classList.remove('d-none');
        document.getElementById('forbiddenCard').style.display = 'flex';
        return;
      }
      // Admin confirmed
      moderatorUid = user.uid;
      moderatorName = userDoc.data().name || user.displayName || user.email || 'Admin';
      document.getElementById('adminNameDisplay').textContent = `Signed in as ${moderatorName} · ${user.email}`;
      overlay.remove();
      document.getElementById('mainDashboard').classList.remove('d-none');
      initDashboard();
    } catch (err) {
      console.error('Auth check error:', err);
      overlay.remove();
      document.getElementById('forbiddenCard').classList.remove('d-none');
      document.getElementById('forbiddenCard').style.display = 'flex';
    }
  });

  // ── Init Dashboard ──
  function initDashboard() {
    setupTabs();
    setupSearchFilters();
    setupBulkActions();
    setupSelectAll();
    setupKeyboardShortcuts();
    setupLightbox();
    document.getElementById('refreshBtn').addEventListener('click', () => loadCases());
    loadCases();
    loadAuditLogs();
  }

  // ── Load Cases ──
  async function loadCases() {
    try {
      const res = await fetch('/api/student-safety/cases');
      const data = await res.json();
      allCases = (data.cases || []).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));

      // Merge Firestore cases
      try {
        const snap = await getDocs(collection(db, 'studentSafetyCases'));
        const fsCases = [];
        snap.forEach(d => fsCases.push({ docId: d.id, ...d.data() }));
        if (fsCases.length > 0) {
          const map = new Map();
          allCases.forEach(c => map.set(c.caseId, c));
          fsCases.forEach(c => { if (c.caseId && !map.has(c.caseId)) map.set(c.caseId, c); });
          allCases = Array.from(map.values()).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
        }
      } catch (_) {}

      updateStats();
      applyFilters();
    } catch (err) {
      console.error('Load error:', err);
    }
  }

  // ── Update Stats ──
  function updateStats() {
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('stat-total').textContent = allCases.length;
    document.getElementById('stat-pending').textContent = allCases.filter(c => c.status === 'Pending Review').length;
    document.getElementById('stat-needs-evidence').textContent = allCases.filter(c => c.status === 'Needs Evidence').length;
    document.getElementById('stat-verified').textContent = allCases.filter(c => c.status === 'Verified').length;
    document.getElementById('stat-rejected').textContent = allCases.filter(c => c.status === 'Rejected').length;
    document.getElementById('stat-resolved').textContent = allCases.filter(c => c.status === 'Resolved').length;
    document.getElementById('stat-today').textContent = allCases.filter(c => c.createdAt && c.createdAt.startsWith(today)).length;
    document.getElementById('tabPendingBadge').textContent = allCases.filter(c => c.status === 'Pending Review').length;
  }

  // ── Apply Filters ──
  function applyFilters() {
    const search = document.getElementById('searchInput').value.toLowerCase().trim();
    const status = document.getElementById('filterStatus').value;
    const platform = document.getElementById('filterPlatform').value;
    const dateFrom = document.getElementById('filterDateFrom').value;
    const dateTo = document.getElementById('filterDateTo').value;

    filteredCases = allCases.filter(c => {
      if (search && !c.caseId?.toLowerCase().includes(search) && !c.fakeUsername?.toLowerCase().includes(search)) return false;
      if (status !== 'ALL' && c.status !== status) return false;
      if (platform !== 'ALL' && c.platform !== platform) return false;
      if (dateFrom && c.createdAt && c.createdAt < dateFrom) return false;
      if (dateTo && c.createdAt && c.createdAt > dateTo + 'T23:59:59') return false;
      return true;
    });

    currentPage = 1;
    selectedCaseIds.clear();
    updateBulkBar();
    renderTable();
  }

  // ── Setup Search / Filters ──
  function setupSearchFilters() {
    ['searchInput','filterStatus','filterPlatform','filterDateFrom','filterDateTo'].forEach(id => {
      document.getElementById(id).addEventListener('input', applyFilters);
      document.getElementById(id).addEventListener('change', applyFilters);
    });
  }

  // ── Render Table ──
  function renderTable() {
    const tbody = document.getElementById('casesTableBody');
    const mobileBody = document.getElementById('mobileCardBody');
    const emptyState = document.getElementById('emptyState');
    const paginationInfo = document.getElementById('paginationInfo');
    const paginationControls = document.getElementById('paginationControls');

    const totalPages = Math.ceil(filteredCases.length / PAGE_SIZE);
    const start = (currentPage - 1) * PAGE_SIZE;
    const pageItems = filteredCases.slice(start, start + PAGE_SIZE);

    if (filteredCases.length === 0) {
      tbody.innerHTML = '';
      mobileBody.innerHTML = '';
      emptyState.classList.remove('d-none');
      paginationInfo.textContent = 'No results';
      paginationControls.innerHTML = '';
      return;
    }
    emptyState.classList.add('d-none');
    paginationInfo.textContent = `Showing ${start + 1}–${Math.min(start + PAGE_SIZE, filteredCases.length)} of ${filteredCases.length}`;

    // Pagination
    paginationControls.innerHTML = '';
    for (let i = 1; i <= totalPages; i++) {
      const li = document.createElement('li');
      li.className = `page-item ${i === currentPage ? 'active' : ''}`;
      li.innerHTML = `<button class="page-link" data-page="${i}">${i}</button>`;
      li.querySelector('button').addEventListener('click', () => { currentPage = i; renderTable(); });
      paginationControls.appendChild(li);
    }

    // Desktop table
    tbody.innerHTML = '';
    pageItems.forEach(item => {
      const isChecked = selectedCaseIds.has(item.caseId);
      const tr = document.createElement('tr');
      tr.className = 'inspect-row';
      tr.innerHTML = `
        <td onclick="event.stopPropagation()"><input type="checkbox" class="form-check-input row-checkbox" data-case-id="${item.caseId}" ${isChecked ? 'checked' : ''}></td>
        <td><span class="fw-bold font-monospace small text-primary">${item.caseId}</span></td>
        <td><span class="badge bg-light text-dark border small">${item.platform || 'Other'}</span></td>
        <td>
          <div class="fw-bold text-dark small">${escHtml(item.fakeUsername || 'N/A')}</div>
          <a href="${escHtml(item.fakeProfileUrl || '#')}" target="_blank" class="text-muted" style="font-size:.72rem;max-width:140px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(item.fakeProfileUrl || '')}</a>
        </td>
        <td><span class="small text-muted">${escHtml(item.college || 'N/A')}</span></td>
        <td><span class="small text-dark font-monospace" style="font-size:.75rem;">${item.anonymous ? '🕵️ Anonymous' : escHtml(item.userId || 'Student').substring(0,20)}</span></td>
        <td><span class="small text-muted">${item.createdAt ? new Date(item.createdAt).toLocaleDateString('en-IN') : 'N/A'}</span></td>
        <td>${statusBadge(item.status)}</td>
        <td class="text-center"><span class="badge bg-light text-dark border">${item.supportCount || 0}</span></td>
        <td class="text-end" onclick="event.stopPropagation()">
          <button class="btn btn-sm btn-outline-primary rounded-pill px-3 view-btn" data-case-id="${item.caseId}">View</button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    // Mobile cards
    mobileBody.innerHTML = '';
    pageItems.forEach(item => {
      const div = document.createElement('div');
      div.className = 'admin-mobile-card';
      div.innerHTML = `
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="fw-bold font-monospace small text-primary">${item.caseId}</div>
            <div class="fw-bold text-dark">${escHtml(item.fakeUsername || 'N/A')}</div>
          </div>
          ${statusBadge(item.status)}
        </div>
        <div class="text-muted small mb-2">${escHtml(item.platform || '')} · ${escHtml(item.college || 'N/A')} · ${item.createdAt ? new Date(item.createdAt).toLocaleDateString('en-IN') : ''}</div>
        <button class="btn btn-sm btn-outline-primary rounded-pill px-3 w-100 view-btn" data-case-id="${item.caseId}">View Details</button>
      `;
      mobileBody.appendChild(div);
    });

    // Row checkbox listeners
    document.querySelectorAll('.row-checkbox').forEach(cb => {
      cb.addEventListener('change', () => {
        const id = cb.getAttribute('data-case-id');
        if (cb.checked) selectedCaseIds.add(id); else selectedCaseIds.delete(id);
        updateBulkBar();
        updateSelectAllCheckbox();
      });
    });

    // View buttons
    document.querySelectorAll('.view-btn').forEach(btn => {
      btn.addEventListener('click', () => openCaseOffcanvas(btn.getAttribute('data-case-id')));
    });
    // Row click to open
    document.querySelectorAll('.inspect-row').forEach(tr => {
      tr.addEventListener('click', () => {
        const caseId = tr.querySelector('.view-btn')?.getAttribute('data-case-id');
        if (caseId) openCaseOffcanvas(caseId);
      });
    });
  }

  // ── Open Case Offcanvas ──
  function openCaseOffcanvas(caseId) {
    const c = allCases.find(x => x.caseId === caseId);
    if (!c) return;
    activeInspectCase = c;

    document.getElementById('offcanvasTitle').textContent = `🔍 ${c.caseId}`;
    document.getElementById('offcanvasSubtitle').textContent = `${c.platform} · ${c.fakeUsername} · ${statusText(c.status)}`;

    // Evidence HTML
    let evImgHtml = '', evPdfHtml = '';
    if (Array.isArray(c.evidence) && c.evidence.length > 0) {
      c.evidence.forEach((ev, i) => {
        const url = typeof ev === 'object' ? ev.url : ev;
        const isPdf = typeof ev === 'object' ? ev.type === 'pdf' : /\.pdf|pdf/i.test(url);
        if (isPdf) {
          evPdfHtml += `<div class="col-6">
            <a href="${url}" target="_blank" class="card p-3 text-center text-decoration-none bg-light border rounded-3 h-100">
              <i class="fa-solid fa-file-pdf fs-2 text-danger mb-2"></i>
              <div class="small fw-bold text-dark">PDF #${i+1}</div>

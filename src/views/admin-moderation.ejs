  .action-btn-row .btn { border-radius:999px;font-weight:600;font-size:.82rem; }
  .inspect-row:hover { cursor:pointer;background:#f8fafc!important; }
  @media (max-width:767px) { .admin-mobile-card { border-radius:1rem;border:1px solid #e2e8f0;background:#fff;padding:1rem;margin-bottom:.75rem;box-shadow:0 2px 8px rgba(0,0,0,.06); } }
  #caseOffcanvas::-webkit-scrollbar { width:5px; }
  #caseOffcanvas::-webkit-scrollbar-thumb { background:#cbd5e1;border-radius:4px; }
  .evidence-img-thumb { cursor:zoom-in;border-radius:.75rem;overflow:hidden;transition:transform .2s,box-shadow .2s; }
  .evidence-img-thumb:hover { transform:scale(1.03);box-shadow:0 8px 24px rgba(0,0,0,.15); }

      <div class="mb-4">
        <h6 class="fw-bold text-uppercase small text-muted mb-3" style="letter-spacing:.06em;">🎭 Impersonating Account</h6>
        <div class="row g-3">
          <div class="col-6"><div class="small text-muted fw-semibold mb-1">Platform</div><span class="badge bg-light text-dark border fs-6">${escHtml(c.platform || 'N/A')}</span></div>
          <div class="col-6"><div class="small text-muted fw-semibold mb-1">Fake Username</div><div class="fw-bold text-dark">${escHtml(c.fakeUsername || 'N/A')}</div></div>
          <div class="col-12"><div class="small text-muted fw-semibold mb-1">Fake Profile URL</div><a href="${escHtml(c.fakeProfileUrl || '#')}" target="_blank" class="fw-bold text-danger text-break small">${escHtml(c.fakeProfileUrl || 'N/A')}</a></div>
          ${c.realProfileUrl ? `<div class="col-12"><div class="small text-muted fw-semibold mb-1">Real Profile URL</div><a href="${escHtml(c.realProfileUrl)}" target="_blank" class="fw-bold text-success text-break small">${escHtml(c.realProfileUrl)}</a></div>` : ''}
        </div>
      </div>
      <hr class="my-3">
      <!-- Section: Report Info -->
      <div class="mb-4">
        <h6 class="fw-bold text-uppercase small text-muted mb-3" style="letter-spacing:.06em;">📋 Report Information</h6>
        <div class="row g-3">
          <div class="col-6"><div class="small text-muted fw-semibold mb-1">Reason</div><span class="badge bg-light text-dark border">${escHtml(c.reason || 'N/A')}</span></div>
          <div class="col-6"><div class="small text-muted fw-semibold mb-1">College</div><div class="small text-dark fw-semibold">${escHtml(c.college || 'Not specified')}</div></div>
          <div class="col-6"><div class="small text-muted fw-semibold mb-1">Anonymous</div><div class="small">${c.anonymous ? '🕵️ Yes' : '👤 No'}</div></div>
          <div class="col-6"><div class="small text-muted fw-semibold mb-1">Support Count</div><span class="badge bg-primary">${c.supportCount || 0} supporters</span></div>
          <div class="col-12"><div class="small text-muted fw-semibold mb-1">Description</div><div class="p-3 bg-light rounded-3 small text-dark border">${escHtml(c.description || '—')}</div></div>
          ${c.rejectionReason ? `<div class="col-12"><div class="small text-muted fw-semibold mb-1">Rejection Reason</div><div class="alert alert-danger py-2 px-3 small rounded-3 mb-0">${escHtml(c.rejectionReason)}</div></div>` : ''}
          ${c.moderatorNote ? `<div class="col-12"><div class="small text-muted fw-semibold mb-1">Moderator Note</div><div class="alert alert-info py-2 px-3 small rounded-3 mb-0">${escHtml(c.moderatorNote)}</div></div>` : ''}

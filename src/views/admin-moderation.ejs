          evImgHtml += `<div class="col-6 col-md-4">
            <div class="evidence-img-thumb" data-url="${url}">
              <img src="${url}" class="img-fluid rounded-3 w-100" style="height:120px;object-fit:cover;" alt="Evidence ${i+1}">
              <div class="small text-center text-muted mt-1">Image #${i+1}</div>

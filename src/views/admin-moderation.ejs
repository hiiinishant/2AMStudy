<style>
  .nav-tabs .nav-link { border-bottom:3px solid transparent;color:#64748b;border-radius:.5rem .5rem 0 0; }
  .nav-tabs .nav-link.active { color:#4f46e5;border-bottom-color:#4f46e5;background:#fff;font-weight:700; }
  .nav-tabs .nav-link:hover:not(.active) { background:rgba(99,102,241,.06);color:#4f46e5; }

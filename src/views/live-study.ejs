<%- include('partials/header') %>

  <style>
    .live-page {
      background: radial-gradient(ellipse at 50% 0%, #1a0a2e 0%, #0d0d1a 55%, #020209 100%);
      min-height: 100vh;
      padding-top: 40px;
      padding-bottom: 80px;
      color: #f8fafc;
    }

    .live-glow-red {
      position: absolute;
      top: 80px;
      left: 50%;
      transform: translateX(-50%);
      width: 700px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(ellipse, rgba(220, 38, 38, 0.12) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .ls-card {
      background: rgba(15, 10, 30, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: 1.5rem;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
      position: relative;
      overflow: hidden;
    }

    .ls-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, #dc2626, #f87171, transparent);
    }

    .ls-card-neutral::before {
      background: linear-gradient(90deg, transparent, #6366f1, #38bdf8, transparent);
    }

    .live-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(220, 38, 38, 0.15);
      border: 1px solid rgba(220, 38, 38, 0.4);
      color: #f87171;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 6px 16px;
      border-radius: 999px;
    }

    .live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #ef4444;
      animation: livePulse 1.4s ease-in-out infinite;
    }

    @keyframes livePulse {

      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.4;
        transform: scale(0.7);
      }
    }

    .yt-embed-wrapper {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      border-radius: 1rem;
      overflow: hidden;
      box-shadow: 0 0 60px rgba(220, 38, 38, 0.25);
    }

    .yt-embed-wrapper iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    .btn-join-live {
      background: linear-gradient(135deg, #dc2626, #b91c1c);
      color: #fff;
      border: none;
      border-radius: 999px;
      padding: 14px 36px;
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 8px 30px rgba(220, 38, 38, 0.4);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .btn-join-live:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 40px rgba(220, 38, 38, 0.55);
      color: #fff;
    }

    .no-live-icon {
      font-size: 4rem;
      line-height: 1;
      opacity: 0.5;
    }

    .browse-past-btn {
      background: rgba(99, 102, 241, 0.15);
      border: 1px solid rgba(99, 102, 241, 0.4);
      color: #a5b4fc;
      border-radius: 999px;
      padding: 12px 32px;
      font-weight: 700;
      text-decoration: none;
      display: inline-block;
      transition: all 0.2s ease;
    }

    .browse-past-btn:hover {
      background: rgba(99, 102, 241, 0.25);
      color: #c7d2fe;
      transform: translateY(-2px);
    }

    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #6366f1;
      background: rgba(99, 102, 241, 0.1);
      border: 1px solid rgba(99, 102, 241, 0.2);
      padding: 4px 14px;
      border-radius: 999px;
      margin-bottom: 12px;
    }

    .past-card {
      background: rgba(15, 10, 30, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 1.25rem;
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
    }

    .past-card:hover {
      transform: translateY(-6px);
      border-color: rgba(99, 102, 241, 0.4);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
      color: inherit;
    }

    .past-card-thumb {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      background: #1e1b4b;
      overflow: hidden;
    }

    .past-card-thumb img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .past-card:hover .past-card-thumb img {
      transform: scale(1.05);
    }

    .past-card-play-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .past-card:hover .past-card-play-overlay {
      opacity: 1;
    }

    .past-card-play-btn {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: rgba(220, 38, 38, 0.9);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      color: #fff;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    }

    .past-card-body {
      padding: 1.1rem 1.25rem 1.25rem;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .past-card-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.78rem;
      color: #64748b;
      font-weight: 500;
    }

    .past-card-title {
      font-size: 1rem;
      font-weight: 700;
      color: #f1f5f9;
      line-height: 1.3;
      margin: 0;
    }

    .past-card-desc {
      font-size: 0.83rem;
      color: #94a3b8;
      line-height: 1.5;
      flex: 1;
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .btn-watch {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(99, 102, 241, 0.12);
      border: 1px solid rgba(99, 102, 241, 0.3);
      color: #a5b4fc;
      border-radius: 999px;
      padding: 8px 18px;
      font-size: 0.82rem;
      font-weight: 700;
      transition: all 0.2s ease;
      text-decoration: none;
      align-self: flex-start;
      margin-top: auto;
    }

    .btn-watch:hover {
      background: rgba(99, 102, 241, 0.25);
      color: #c7d2fe;
    }

    .duration-chip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: rgba(99, 102, 241, 0.12);
      border: 1px solid rgba(99, 102, 241, 0.2);
      color: #a5b4fc;
      font-size: 0.73rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 999px;
    }
  </style>

  <main class="live-page position-relative">
    <div class="live-glow-red"></div>
    <div class="container position-relative" style="max-width:1000px;z-index:1;">

      <!-- Page Header -->
      <div class="text-center mb-5">
        <div class="section-label"><i class="fa-solid fa-video"></i> 2AM Study Live</div>
        <h1 class="fw-bold text-white mb-2" style="font-size:clamp(1.8rem,4vw,2.6rem);">Live &amp; Recorded Study
          Sessions</h1>
        <p class="text-muted mb-0" style="max-width:560px;margin:0 auto;font-size:0.95rem;">Join our live study sessions
          on YouTube or watch a recorded challenge below.</p>
      </div>

      <!-- LIVE NOW or No Live -->
      <% if (liveSession) { %>
        <div class="ls-card p-4 p-md-5 mb-5">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
              <span class="live-badge mb-2 d-inline-flex"><span class="live-dot"></span> LIVE NOW</span>
              <h2 class="text-white fw-bold mb-1 mt-2" style="font-size:1.5rem;">
                <%= liveSession.title %>
              </h2>
              <% if (liveSession.description) { %>
                <p class="text-muted mb-0" style="font-size:0.9rem;max-width:580px;">
                  <%= liveSession.description %>
                </p>
                <% } %>
            </div>
            <% if (liveSession.duration) { %><span class="duration-chip"><i class="fa-regular fa-clock"></i>
                <%= liveSession.duration %>
              </span>
              <% } %>
          </div>
          <div class="yt-embed-wrapper mb-4">
            <iframe
              src="https://www.youtube.com/embed/<%= liveSession.youtubeVideoId %>?autoplay=0&rel=0&modestbranding=1"
              allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture;web-share"
              allowfullscreen title="<%= liveSession.title %>"></iframe>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-3">
            <a href="<%= liveSession.youtubeUrl %>" target="_blank" rel="noopener noreferrer" class="btn-join-live"><i
                class="fa-brands fa-youtube"></i> Join Live Study Stream</a>
            <div class="small text-muted"><i class="fa-solid fa-circle-info me-1"></i>Opens on YouTube — study along
              with us live</div>
          </div>
        </div>
        <% } else { %>
          <div class="ls-card ls-card-neutral p-5 mb-5 text-center">
            <div class="no-live-icon mb-3">🌙</div>
            <h2 class="text-white fw-bold mb-2 fs-4">No Live Study Right Now</h2>
            <p class="text-muted mb-4" style="max-width:500px;margin:0 auto;">The next study session will appear here
              when we go live. Meanwhile, continue studying with one of our recorded sessions below.</p>
            <a href="#past-sessions" class="browse-past-btn"><i class="fa-solid fa-film me-2"></i> Browse Past
              Sessions</a>
          </div>
          <% } %>

            <!-- Past Sessions -->
            <div id="past-sessions">
              <div class="text-center mb-4">
                <div class="section-label"><i class="fa-solid fa-film"></i> Recorded Sessions</div>
                <h2 class="text-white fw-bold mb-1 fs-3">Past Study Sessions</h2>
                <p class="text-muted mb-0 small">Watch any recorded session — study at your own pace.</p>
              </div>
              <% if (pastSessions.length===0) { %>
                <div class="text-center py-5 text-muted">
                  <div style="font-size:3rem;opacity:0.3;margin-bottom:12px;">📼</div>
                  <p class="small">No recorded sessions yet. Check back after our first live session!</p>
                </div>
                <% } else { %>
                  <div class="row g-4">
                    <% pastSessions.forEach(function(session){ %>
                      <div class="col-sm-6 col-lg-4">
                        <div class="past-card h-100">
                          <a href="/live-study/<%= session.id %>" class="past-card-thumb text-decoration-none">
                            <img src="<%= session.thumbnail %>" alt="<%= session.title %>" loading="lazy"
                              onerror="this.src='https://img.youtube.com/vi/<%= session.youtubeVideoId %>/hqdefault.jpg'">
                            <div class="past-card-play-overlay">
                              <div class="past-card-play-btn"><i class="fa-solid fa-play"></i></div>
                            </div>
                          </a>
                          <div class="past-card-body">
                            <div class="past-card-meta">
                              <% if (session.duration) { %><span><i class="fa-regular fa-clock me-1"></i>
                                  <%= session.duration %>
                                </span><span>•</span>
                                <% } %>
                                  <% if (session.endedAt) { %><span>
                                      <%= new
                                        Date(session.endedAt).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'})
                                        %>
                                    </span>
                                    <% } %>
                            </div>
                            <h3 class="past-card-title">
                              <a href="/live-study/<%= session.id %>" class="text-white text-decoration-none">
                                <%= session.title %>
                              </a>
                            </h3>
                            <% if (session.description) { %>
                              <p class="past-card-desc">
                                <%= session.description %>
                              </p>
                              <% } %>
                                <a href="/live-study/<%= session.id %>" class="btn-watch mt-2"><i
                                    class="fa-solid fa-play"></i> Watch Recording</a>
                          </div>
                        </div>
                      </div>
                      <% }) %>
                  </div>
                  <% } %>
            </div>

    </div>
  </main>

  <%- include('partials/footer') %>
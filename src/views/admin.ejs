    // Safety Case Moderate
    async function moderateCase(caseId, action) {
      const reason = action === 'reject' ? prompt('Rejection reason:') : 'Approved by Admin';
      if (action === 'reject' && !reason) return;

      try {
        const res = await fetch('/api/student-safety/admin/moderate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ caseId, action, note: reason, moderatorUid: 'MASTER-ADMIN', moderatorName: 'Master Admin' })
        });
        const data = await res.json();
        if (data.success) {
          showToast('Case #' + caseId + ' ' + (action === 'approve' ? 'verified' : 'rejected'));
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.message || 'Action failed.', true);
        }
      } catch(err) {
        showToast('Error connecting to server.', true);
      }
    }


    // ─── Blog Management & Image Box Helpers ─────────────────────────────────────
    
    function updateCoverPreview(inputId, previewImgId) {
      const url = document.getElementById(inputId).value.trim();
      const preview = document.getElementById(previewImgId);
      if (preview) {
        preview.src = url || '/assets/images/logo.jpg';
      }
    }

    async function uploadBlogCover(fileInput, targetUrlInputId, previewImgId) {
      if (!fileInput.files || !fileInput.files[0]) return;
      const file = fileInput.files[0];
      const formData = new FormData();
      formData.append('image', file);

      showToast('Uploading cover image...');
      try {
        const res = await fetch('/api/store/admin/blogs/upload-image', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (data.success && data.url) {
          document.getElementById(targetUrlInputId).value = data.url;
          const preview = document.getElementById(previewImgId);
          if (preview) preview.src = data.url;
          showToast('Cover image uploaded successfully!');
        } else {
          showToast(data.error || 'Failed to upload cover image.', true);
        }
      } catch(err) {
        showToast('Network error while uploading cover image.', true);
      } finally {
        fileInput.value = '';
      }
    }

    async function uploadInlineImage(fileInput, textareaId) {
      if (!fileInput.files || !fileInput.files[0]) return;
      const file = fileInput.files[0];
      const formData = new FormData();
      formData.append('image', file);

      showToast('Uploading inline image...');
      try {
        const res = await fetch('/api/store/admin/blogs/upload-image', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (data.success && data.url) {
          const caption = prompt('Enter a caption for this image (optional):', '') || 'Image description';
          const imageBoxHtml = `\n\n<figure class="blog-img-box my-4 text-center">\n  <img src="${data.url}" alt="${caption}" class="img-fluid rounded-4 shadow-sm" style="max-height: 480px; object-fit: cover;">\n  <figcaption class="text-muted small mt-2">${caption}</figcaption>\n</figure>\n\n`;
          
          insertAtCursor(textareaId, imageBoxHtml);
          showToast('Image Box inserted into content!');
        } else {
          showToast(data.error || 'Failed to upload inline image.', true);
        }
      } catch(err) {
        showToast('Network error uploading image.', true);
      } finally {
        fileInput.value = '';
      }
    }

    function insertQuickTag(textareaId, type) {
      let snippet = '';
      if (type === 'h2') snippet = '\n\n<h2>Section Title</h2>\n<p>Write your section content here...</p>\n';
      else if (type === 'h3') snippet = '\n\n<h3>Subheading Title</h3>\n<p>Details here...</p>\n';
      else if (type === 'quote') snippet = '\n\n<blockquote>"Success doesn\'t come to you, you go to it."</blockquote>\n';
      else if (type === 'tip') snippet = '\n\n<div class="pro-tip">\n  <strong>Pro-Tip:</strong> Review your notes within 24 hours to boost retention by 80%.\n</div>\n';
      else if (type === 'list') snippet = '\n\n<ul>\n  <li>Key point 1</li>\n  <li>Key point 2</li>\n  <li>Key point 3</li>\n</ul>\n';
      
      insertAtCursor(textareaId, snippet);
    }

    function insertAtCursor(textareaId, text) {
      const el = document.getElementById(textareaId);
      if (!el) return;
      const start = el.selectionStart || el.value.length;
      const end = el.selectionEnd || el.value.length;
      el.value = el.value.substring(0, start) + text + el.value.substring(end);
      el.focus();
      el.selectionStart = el.selectionEnd = start + text.length;
    }

    // Blog Actions
    async function createBlog(e) {
      e.preventDefault();
      const btn = document.getElementById('submitBlogBtn');
      const originalText = btn ? btn.innerHTML : 'Publish Article';
      if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Publishing...'; }

      const title = document.getElementById('blogTitle').value.trim();
      const category = document.getElementById('blogCategory').value.trim();
      const author = document.getElementById('blogAuthor').value.trim();
      const coverImage = document.getElementById('blogImage').value.trim();
      const excerpt = document.getElementById('blogExcerpt').value.trim();
      const content = document.getElementById('blogContent').value.trim();

      try {
        const res = await fetch('/api/store/admin/blogs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, category, author, coverImage, image: coverImage, excerpt, content, status: 'published' })
        });
        const data = await res.json();
        if (data.success) {
          showToast('Blog article published successfully!');
          setTimeout(() => window.location.reload(), 800);
        } else {
          showToast(data.error || 'Failed to publish article.', true);
          if (btn) { btn.disabled = false; btn.innerHTML = originalText; }
        }
      } catch(err) {
        showToast('Error publishing blog.', true);
        if (btn) { btn.disabled = false; btn.innerHTML = originalText; }
      }
    }

    async function openEditBlogModal(id) {
      showToast('Loading article details...');
      try {
        const res = await fetch('/api/store/admin/blogs/' + id);
        const data = await res.json();
        if (data.success && data.post) {
          const p = data.post;
          document.getElementById('editBlogId').value = p.id;
          document.getElementById('editBlogTitle').value = p.title || '';
          document.getElementById('editBlogCategory').value = p.category || 'Study Tips';
          document.getElementById('editBlogAuthor').value = p.author || '2 AM Study';
          const imgUrl = p.coverImage || p.image || '';
          document.getElementById('editBlogImage').value = imgUrl;
          const preview = document.getElementById('editBlogImagePreview');
          if (preview) preview.src = imgUrl || '/assets/images/logo.jpg';
          document.getElementById('editBlogExcerpt').value = p.excerpt || '';
          document.getElementById('editBlogContent').value = p.content || '';

          const modal = new bootstrap.Modal(document.getElementById('editBlogModal'));
          modal.show();
        } else {
          showToast(data.error || 'Failed to load article.', true);
        }
      } catch(err) {
        showToast('Error loading blog details.', true);
      }
    }

    async function updateBlog(e) {
      e.preventDefault();
      const id = document.getElementById('editBlogId').value;
      if (!id) return;

      const btn = document.getElementById('saveEditBlogBtn');
      const originalText = btn ? btn.innerHTML : 'Save Changes';
      if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...'; }

      const title = document.getElementById('editBlogTitle').value.trim();
      const category = document.getElementById('editBlogCategory').value.trim();
      const author = document.getElementById('editBlogAuthor').value.trim();
      const coverImage = document.getElementById('editBlogImage').value.trim();
      const excerpt = document.getElementById('editBlogExcerpt').value.trim();
      const content = document.getElementById('editBlogContent').value.trim();

      try {
        const res = await fetch('/api/store/admin/blogs/' + id, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, category, author, coverImage, image: coverImage, excerpt, content })
        });
        const data = await res.json();
        if (data.success) {
          showToast('Blog article updated successfully!');
          setTimeout(() => window.location.reload(), 800);
        } else {
          showToast(data.error || 'Failed to update article.', true);
          if (btn) { btn.disabled = false; btn.innerHTML = originalText; }
        }
      } catch(err) {
        showToast('Error updating blog.', true);
        if (btn) { btn.disabled = false; btn.innerHTML = originalText; }
      }
    }


        <a href="/contact" class="btn btn-light rounded-pill px-4 py-2 fw-bold text-primary">
          <i class="fa-solid fa-envelope me-2"></i> Contact Support
        </a>
        <a href="/store" class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold">
          <i class="fa-solid fa-store me-2"></i> Explore Store
        </a>
      </div>
    </div>
  </div>
</main>

<script>
  // Toggle accordion item
  function toggleFaq(el) {
    const item = el.parentElement;
    const answer = item.querySelector('.faq-answer');
    const isActive = item.classList.contains('active');

    // Close all other open items in the same section for smooth UX
    document.querySelectorAll('.faq-item.active').forEach(openItem => {
      if (openItem !== item) {
        openItem.classList.remove('active');
        openItem.querySelector('.faq-answer').style.display = 'none';
      }
    });

    if (isActive) {
      item.classList.remove('active');
      answer.style.display = 'none';
    } else {
      item.classList.add('active');
      answer.style.display = 'block';
    }
  }

  // Filter FAQs by Category
  function setFaqCategory(cat, btn) {
    document.querySelectorAll('.faq-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    document.querySelectorAll('.faq-category-section').forEach(sec => {
      if (cat === 'all' || sec.getAttribute('data-cat') === cat) {
        sec.style.display = 'block';
      } else {
        sec.style.display = 'none';
      }
    });

    document.getElementById('faqSearchInput').value = '';
    document.getElementById('noFaqResults').style.display = 'none';
  }

  // Search Filter
  function filterFaqs() {
    const query = document.getElementById('faqSearchInput').value.toLowerCase().trim();
    let visibleCount = 0;

    document.querySelectorAll('.faq-category-section').forEach(sec => {
      let sectionHasMatches = false;
      sec.querySelectorAll('.faq-item').forEach(item => {
        const text = item.textContent.toLowerCase();
        if (!query || text.includes(query)) {
          item.style.display = 'block';
          sectionHasMatches = true;
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (sectionHasMatches) {
        sec.style.display = 'block';
      } else {
        sec.style.display = 'none';
      }
    });

    const noResults = document.getElementById('noFaqResults');
    if (visibleCount === 0) {
      noResults.style.display = 'block';
    } else {
      noResults.style.display = 'none';
    }
  }
</script>


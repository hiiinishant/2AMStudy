    </div>

    <!-- Category 4: Student Safety -->
    <div class="faq-category-section" data-cat="safety">
      <div class="faq-category-header">
        <div class="faq-category-icon"><i class="fa-solid fa-shield-halved"></i></div>
        <h2 class="faq-category-title">Student Safety &amp; Identity Shield</h2>
      </div>

      <div class="faq-item">
        <div class="faq-question" onclick="toggleFaq(this)">
          <span>How does Student Identity Shield protect me against fake social media profiles?</span>

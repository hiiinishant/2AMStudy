      </div>

      <div class="faq-item">
        <div class="faq-question" onclick="toggleFaq(this)">
          <span>Is my identity and reporting information kept confidential?</span>
          <div class="faq-toggle-icon"><i class="fa-solid fa-chevron-down"></i></div>
        </div>
        <div class="faq-answer">

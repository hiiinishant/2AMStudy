<!-- Firebase Auth Handler Script -->
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-app.js";
  import {
    getAuth,
    createUserWithEmailAndPassword,
    updateProfile,
    sendEmailVerification,
    GoogleAuthProvider,
    signInWithPopup,
    reload
  } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-auth.js";
  import { getFirestore, doc, getDoc, setDoc, updateDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyCvJRS3UusvUrVCd2JSicBGL-uRD82GpNM",
    authDomain: "am-study-7ea87.firebaseapp.com",
    projectId: "am-study-7ea87",
    storageBucket: "am-study-7ea87.firebasestorage.app",
    messagingSenderId: "270924691236",
    appId: "1:270924691236:web:7ada12dcf50c290d0925b1"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);

  const errorAlert = document.getElementById('auth-error-alert');
  const errorMsg = document.getElementById('auth-error-msg');
  const successAlert = document.getElementById('auth-success-alert');
  const signupForm = document.getElementById('signupForm');
  const submitBtn = document.getElementById('signupSubmitBtn');
  const googleBtn = document.getElementById('googleSignUpBtn');

  // Password toggle
  function setupToggle(btnId, eyeId, inputId) {
    const btn = document.getElementById(btnId);
    const eye = document.getElementById(eyeId);
    const inp = document.getElementById(inputId);
    if (btn && inp) {
      btn.addEventListener('click', () => {
        const isPass = inp.getAttribute('type') === 'password';
        inp.setAttribute('type', isPass ? 'text' : 'password');
        eye.className = isPass ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
      });
    }
  }
  setupToggle('pwToggle1', 'pwEye1', 'signupPassword');
  setupToggle('pwToggle2', 'pwEye2', 'signupConfirmPassword');

  // Password Strength Meter (Fix 3: updated thresholds for 8-char min)
  const pwInput = document.getElementById('signupPassword');
  const strengthWrap = document.getElementById('strengthWrap');
  const strengthFill = document.getElementById('strengthFill');
  const strengthLabel = document.getElementById('strengthLabel');

  pwInput.addEventListener('input', () => {
    const val = pwInput.value;
    if (!val) { strengthWrap.classList.remove('visible'); return; }
    strengthWrap.classList.add('visible');
    let score = 0;
    if (val.length >= 8)  score++;   // Fix 3: was >= 6
    if (val.length >= 12) score++;   // Fix 3: was >= 10
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;
    const levels = [
      { label: 'Very Weak', color: '#ef4444', pct: '20%' },
      { label: 'Weak',      color: '#f97316', pct: '40%' },
      { label: 'Fair',      color: '#eab308', pct: '60%' },
      { label: 'Good',      color: '#22c55e', pct: '80%' },
      { label: 'Strong',    color: '#16a34a', pct: '100%' },
    ];
    const lvl = levels[Math.min(score - 1, 4)] || levels[0];
    strengthFill.style.width = lvl.pct;
    strengthFill.style.background = lvl.color;
    strengthLabel.textContent = lvl.label;
    strengthLabel.style.color = lvl.color;

    // Fix 2: Re-validate confirm password live when password changes
    const cpw = document.getElementById('signupConfirmPassword');
    if (cpw.value) {
      const mismatch = cpw.value !== val;
      markInput(cpw, mismatch);
      showErr('confirmPasswordFeedback', mismatch);
    }
  });

  // Safe redirect — default fallback is homepage ('/') when user signs up directly
  function safeRedirect(param, fallback = '/') {
    if (!param) return fallback;
    if (/^https?:\/\//i.test(param) || /^\/\//i.test(param) || !param.startsWith('/')) return fallback;
    return param;
  }

  const rawRedirect = new URLSearchParams(window.location.search).get('redirect');
  const safeRedirectUrl = safeRedirect(rawRedirect);

  if (rawRedirect && safeRedirectUrl !== '/') {
    const toLogin = document.getElementById('toLoginLink');
    if (toLogin) toLogin.href = '/login?redirect=' + encodeURIComponent(safeRedirectUrl);
  }

  const syncLocalCache = (user, collegeName = '') => {
    localStorage.setItem('isLoggedIn', 'true');
    localStorage.setItem('user_id', user.uid);
    localStorage.setItem('studentEmail', user.email || '');
    localStorage.setItem('studentName', user.displayName || user.email.split('@')[0]);
    localStorage.setItem('studentRegistered', 'true');
    if (collegeName) localStorage.setItem('studentCollege', collegeName);
  };

  const saveUserToFirestore = async (user, collegeName = '') => {
    try {
      const userRef = doc(db, "users", user.uid);
      const userSnap = await getDoc(userRef);
      if (!userSnap.exists()) {
        await setDoc(userRef, {
          uid: user.uid,
          displayName: user.displayName || user.email.split('@')[0],
          email: user.email,
          photoURL: user.photoURL || '',
          college: collegeName || '',
          role: 'student',
          emailVerified: user.emailVerified,
          trustScore: 10,
          badges: ['student_protector'],
          reportsSubmitted: 0,
          reportsSupported: 0,
          status: 'active',
          createdAt: serverTimestamp(),
          lastLoginAt: serverTimestamp()
        });
      } else {
        await updateDoc(userRef, { emailVerified: user.emailVerified, lastLoginAt: serverTimestamp() });
      }
    } catch (e) {
      console.warn("Firestore user creation warning:", e);
    }
  };

  function showErr(id, show) {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('visible', show);
  }

  function markInput(inputEl, invalid) {
    if (inputEl) inputEl.classList.toggle('is-invalid', invalid);
  }

  // â”€â”€ Fix 5: Rate limiting tracker â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  let failedAttempts = 0;
  let cooldownActive = false;
  let cooldownTimer = null;

  function startCooldown() {
    cooldownActive = true;
    submitBtn.disabled = true;
    let seconds = 30;
    submitBtn.textContent = `Too many attempts. Wait ${seconds}s...`;
    cooldownTimer = setInterval(() => {
      seconds--;
      if (seconds <= 0) {
        clearInterval(cooldownTimer);
        cooldownActive = false;
        failedAttempts = 0;
        submitBtn.disabled = false;
        submitBtn.textContent = 'âœ¨ Create Account';
      } else {
        submitBtn.textContent = `Too many attempts. Wait ${seconds}s...`;
      }
    }, 1000);
  }

  // â”€â”€ Critical Fix: Verification pending state â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  // Holds the firebase user after creation so verify/resend buttons can use it
  let pendingUser = null;

  function showVerifyPendingState(user) {
    pendingUser = user;
    // Hide signup form, divider, google button, footer so user cannot bypass
    signupForm.style.display = 'none';
    const divider = document.querySelector('.su-divider');
    if (divider) divider.style.display = 'none';
    googleBtn.style.display = 'none';
    const footerPrompt = document.querySelector('.su-footer-prompt');
    if (footerPrompt) footerPrompt.style.display = 'none';
    // Show email and pending state panel
    document.getElementById('verifyEmailDisplay').textContent = user.email;
    document.getElementById('verifyPendingState').classList.remove('d-none');
  }

  // â”€â”€ Signup Form Submit â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  signupForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    e.stopPropagation();

    if (cooldownActive) return; // Fix 5: block during cooldown

    errorAlert.classList.add('d-none');
    successAlert.classList.add('d-none');

    const nameEl    = document.getElementById('signupName');
    const emailEl   = document.getElementById('signupEmail');
    const pwEl      = document.getElementById('signupPassword');
    const cpwEl     = document.getElementById('signupConfirmPassword');
    const termsEl   = document.getElementById('termsCheck');
    const collegeEl = document.getElementById('signupCollege');

    const name      = nameEl.value.trim();
    const email     = emailEl.value.trim();
    const password  = pwEl.value;
    const confirmPw = cpwEl.value;
    const college   = collegeEl.value.trim();

    let valid = true;

    // Fix 4: Name must be at least 2 characters (not just non-empty)
    if (!name || name.length < 2) {
      markInput(nameEl, true);
      document.getElementById('nameError').textContent = name ? 'Name must be at least 2 characters.' : 'Please enter your full name.';
      showErr('nameError', true);
      valid = false;
    } else { markInput(nameEl, false); showErr('nameError', false); }

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      markInput(emailEl, true); showErr('emailError', true); valid = false;
    } else { markInput(emailEl, false); showErr('emailError', false); }

    // Fix 3: Minimum 8 characters (was 6)
    if (!password || password.length < 8) {
      markInput(pwEl, true); showErr('passwordError', true); valid = false;
    } else { markInput(pwEl, false); showErr('passwordError', false); }

    if (password !== confirmPw) {
      markInput(cpwEl, true); showErr('confirmPasswordFeedback', true); valid = false;
    } else { markInput(cpwEl, false); showErr('confirmPasswordFeedback', false); }

    if (!termsEl.checked) { showErr('termsError', true); valid = false; }
    else                  { showErr('termsError', false); }

    if (!valid) return;

    submitBtn.disabled = true;
    submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Creating Account...`;

    try {
      const userCredential = await createUserWithEmailAndPassword(auth, email, password);
      const user = userCredential.user;

      await updateProfile(user, { displayName: name });

      // Fix 7: Catch sendEmailVerification failure and tell the user
      let verificationSent = true;
      try {
        await sendEmailVerification(user);
      } catch (evErr) {
        console.warn("Email verification send warning:", evErr);
        verificationSent = false;
      }

      syncLocalCache(user, college);
      await saveUserToFirestore(user, college);

      // Critical Fix: Show verification pending state instead of instant redirect
      // User MUST verify their email before being let through
      showVerifyPendingState(user);

      // Fix 7: If verification email failed to send, warn the user with resend option
      if (!verificationSent) {
        const resendMsg = document.getElementById('resendMsg');
        resendMsg.textContent = 'âš ï¸ We couldn\'t send the verification email. Please use the "Resend" button below.';
        resendMsg.style.color = '#d97706';
      }

    } catch (err) {
      console.error("Signup error:", err);

      // Fix 5: Track failed attempts â€” lock out after 3 consecutive failures
      failedAttempts++;
      if (failedAttempts >= 3) {
        startCooldown();
        return; // finally block still runs, but cooldown manages button state
      }

      errorAlert.classList.remove('d-none');
      if (err.code === 'auth/email-already-in-use') {
        errorMsg.textContent = 'This email is already registered. Please login instead.';
      } else if (err.code === 'auth/invalid-email') {
        errorMsg.textContent = 'Please enter a valid email address.';
      } else if (err.code === 'auth/weak-password') {
        errorMsg.textContent = 'Password is too weak. Please use at least 8 characters.';
      } else {
        errorMsg.textContent = err.message || 'Failed to create account.';
      }
    } finally {
      // Only restore button if cooldown didn't take over
      if (!cooldownActive) {
        submitBtn.disabled = false;
        submitBtn.innerText = 'âœ¨ Create Account';
      }
    }
  });

  // â”€â”€ "I've Verified â€” Continue" button â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  document.getElementById('checkVerifiedBtn').addEventListener('click', async () => {
    const btn = document.getElementById('checkVerifiedBtn');
    const resendMsg = document.getElementById('resendMsg');
    btn.disabled = true;
    btn.textContent = 'Checking...';
    try {
      if (pendingUser) {
        // Reload user from Firebase to get latest emailVerified status
        await reload(pendingUser);
        if (pendingUser.emailVerified) {
          // Update Firestore to mark email as verified
          try {
            const userRef = doc(db, "users", pendingUser.uid);
            await updateDoc(userRef, { emailVerified: true });
          } catch (fsErr) { console.warn("Firestore verify update:", fsErr); }
          resendMsg.textContent = 'âœ… Email verified! Redirecting...';
          resendMsg.style.color = '#15803d';
          setTimeout(() => { window.location.href = safeRedirectUrl; }, 800);
        } else {
          resendMsg.textContent = 'âŒ Email not verified yet. Please click the link in your inbox first.';
          resendMsg.style.color = '#b91c1c';
          btn.disabled = false;
          btn.textContent = 'âœ… I\'ve Verified â€” Continue';
        }
      }
    } catch (err) {
      console.error("Verify check error:", err);
      resendMsg.textContent = 'Error checking verification status. Please try again.';
      resendMsg.style.color = '#b91c1c';
      btn.disabled = false;
      btn.textContent = 'âœ… I\'ve Verified â€” Continue';
    }
  });

  // â”€â”€ "Resend Verification Email" button â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  document.getElementById('resendVerifyBtn').addEventListener('click', async () => {
    const resendBtn = document.getElementById('resendVerifyBtn');
    const resendMsg = document.getElementById('resendMsg');
    resendBtn.disabled = true;
    resendMsg.textContent = 'Sending...';
    resendMsg.style.color = '#64748b';
    try {
      if (pendingUser) {
        await sendEmailVerification(pendingUser);
        resendMsg.textContent = 'ðŸ“¨ Verification email resent! Please check your inbox.';
        resendMsg.style.color = '#15803d';
        // Anti-spam: re-enable after 30 seconds
        setTimeout(() => { resendBtn.disabled = false; }, 30000);
      }
    } catch (err) {
      resendMsg.textContent = err.code === 'auth/too-many-requests'
        ? 'Too many requests. Please wait a moment before resending.'
        : 'Failed to resend. Please try again in a moment.';
      resendMsg.style.color = '#b91c1c';
      resendBtn.disabled = false;
    }
  });

  // â”€â”€ Fix 1 & 6: Google Sign-Up â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  // Google accounts are pre-verified by Google â€” no email verification step needed
  googleBtn.addEventListener('click', async () => {
    errorAlert.classList.add('d-none');
    const provider = new GoogleAuthProvider();
    try {
      const result = await signInWithPopup(auth, provider);
      const user = result.user;
      // Fix 1: Google accounts are always emailVerified â€” save correctly
      syncLocalCache(user);
      await saveUserToFirestore(user);
      // Fix 6: Show correct success message â€” no fake "verification email sent"
      document.getElementById('su-success-msg').textContent = 'Redirecting you to your dashboard...';
      successAlert.classList.remove('d-none');
      setTimeout(() => { window.location.href = safeRedirectUrl; }, 800);
    } catch (err) {
      console.error("Google signup error:", err);
      if (err.code !== 'auth/popup-closed-by-user') {
        errorAlert.classList.remove('d-none');
        errorMsg.textContent = err.message || 'Google Sign-Up failed.';
      }
    }
  });
</script>


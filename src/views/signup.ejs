<%- include('partials/header') %>

<style>
/* 2 AM Study - Signup Page Split-Card Design (Matches Login) */
:root {
  --su-page-bg: #f1f5f9;
  --su-card-bg: #ffffff;
  --su-text-dark: #0f172a;
  --su-text-muted: #475569;
  --su-border: #e2e8f0;
  --su-input-border: #cbd5e1;
  --su-accent-blue: #2563eb;
  --su-accent-blue-hover: #1d4ed8;
  --su-btn-dark: #0f172a;
}

body {
  background: var(--su-page-bg) !important;
  min-height: 100vh;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  color: var(--su-text-dark);
}

.su-hero-section {
  min-height: calc(100vh - 80px);
  padding: 40px 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 90% 10%, rgba(37, 99, 235, 0.07) 0%, transparent 45%),
              radial-gradient(circle at 10% 90%, rgba(99, 102, 241, 0.08) 0%, transparent 50%),
              var(--su-page-bg);
}

.su-master-card {
  max-width: 1020px;
  width: 100%;
  background: var(--su-card-bg);
  border-radius: 28px;
  box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.12), 0 0 1px 1px rgba(0, 0, 0, 0.04);
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  margin: 0 auto;
  border: 1px solid rgba(226, 232, 240, 0.8);
}

/* Left Photo Panel */
.su-photo-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 40px 36px;
  overflow: hidden;
  min-height: 580px;
}

.su-panel-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  z-index: 0;
}

.su-panel-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(15,23,42,0.10) 0%, rgba(15,23,42,0.38) 40%, rgba(15,23,42,0.90) 100%);
  z-index: 1;
}

.su-panel-content { position: relative; z-index: 2; }

.su-panel-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,0.12);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 20px;
  padding: 5px 14px;
  margin-bottom: 16px;
}

.su-panel-title {
  font-size: 1.8rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 10px;
  letter-spacing: -0.02em;
  text-shadow: 0 2px 12px rgba(0,0,0,0.3);
}

.su-panel-subtitle {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.75);
  line-height: 1.55;
  max-width: 290px;
  margin: 0 0 20px;
}

.su-feature-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }

.su-pill {
  background: rgba(255,255,255,0.1);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 0.75rem;
  color: rgba(255,255,255,0.8);
  font-weight: 500;
}

.su-dots { display: flex; align-items: center; gap: 8px; }
.su-dot { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,0.4); transition: all 0.3s ease; }
.su-dot.active { width: 26px; border-radius: 12px; background: rgba(255,255,255,0.9); }

/* Right Form Panel */
.su-form-panel {
  padding: 44px 52px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: #ffffff;
  overflow-y: auto;
}

.su-brand-header { text-align: center; margin-bottom: 22px; }

.su-brand-logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 1.4rem;
  font-weight: 800;
  letter-spacing: -0.01em;
  color: var(--su-text-dark);
  text-decoration: none;
}

.su-brand-logo img { height: 36px; width: auto; border-radius: 8px; }

.su-brand-logo span {
  background: linear-gradient(135deg, #0f172a 30%, #2563eb 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.su-form-label { font-size: 0.84rem; font-weight: 600; color: #334155; margin-bottom: 5px; display: block; }

.su-input-wrap { position: relative; margin-bottom: 4px; }

.su-input {
  width: 100%;
  padding: 11px 16px;
  background: #ffffff;
  border: 1.5px solid var(--su-input-border);
  border-radius: 8px;
  font-size: 0.9rem;
  color: var(--su-text-dark);
  transition: all 0.2s ease;
  outline: none;
}

.su-input:focus { border-color: var(--su-accent-blue); box-shadow: 0 0 0 3.5px rgba(37,99,235,0.12); }
.su-input::placeholder { color: #94a3b8; font-size: 0.87rem; }
.su-input.is-invalid { border-color: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,0.1); }

.su-password-toggle {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: #64748b;
  cursor: pointer;
  padding: 4px;
  font-size: 0.9rem;
}

.su-field-error { font-size: 0.78rem; color: #ef4444; margin-bottom: 8px; display: none; }
.su-field-error.visible { display: block; }

/* Password Strength */
.su-strength-wrap { margin-bottom: 6px; display: none; }
.su-strength-wrap.visible { display: block; }
.su-strength-bar { height: 4px; background: #e2e8f0; border-radius: 4px; overflow: hidden; margin-bottom: 3px; margin-top: 6px; }
.su-strength-fill { height: 100%; border-radius: 4px; transition: all 0.3s ease; width: 0%; }
.su-strength-label { font-size: 0.74rem; font-weight: 600; }

/* Terms */
.su-terms-wrap { display: flex; align-items: flex-start; gap: 10px; margin: 6px 0 4px; }
.su-terms-check { margin-top: 2px; width: 16px; height: 16px; cursor: pointer; accent-color: var(--su-accent-blue); flex-shrink: 0; }
.su-terms-label { font-size: 0.82rem; color: var(--su-text-muted); line-height: 1.5; }
.su-terms-label a { color: var(--su-accent-blue); text-decoration: none; font-weight: 600; }
.su-terms-label a:hover { text-decoration: underline; }

/* Buttons */
.su-btn-primary {
  width: 100%;
  background: var(--su-btn-dark);
  color: #ffffff;
  border: none;
  padding: 13px 20px;
  border-radius: 8px;
  font-size: 0.95rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 4px 12px rgba(15,23,42,0.15);
  margin-top: 6px;
}

.su-btn-primary:hover { background: var(--su-accent-blue); transform: translateY(-1px); box-shadow: 0 6px 16px rgba(37,99,235,0.25); }
.su-btn-primary:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }

.su-divider { display: flex; align-items: center; margin: 16px 0 14px; }
.su-divider-line { flex: 1; height: 1px; background: #e2e8f0; }
.su-divider-text { padding: 0 14px; font-size: 0.82rem; color: #94a3b8; font-weight: 500; }

.su-btn-google {
  width: 100%;
  background: #ffffff;
  border: 1.5px solid var(--su-input-border);
  color: #334155;
  padding: 11px 20px;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.su-btn-google:hover { background: #f8fafc; border-color: #94a3b8; }

/* Alerts */
.su-alert { border-radius: 8px; padding: 10px 14px; font-size: 0.84rem; margin-bottom: 14px; display: flex; align-items: flex-start; gap: 10px; }
.su-alert-danger { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }
.su-alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; }

.su-footer-prompt { text-align: center; margin-top: 18px; font-size: 0.86rem; color: #64748b; }
.su-footer-link { color: var(--su-accent-blue); font-weight: 700; text-decoration: none; margin-left: 4px; }
.su-footer-link:hover { text-decoration: underline; }

@media (max-width: 900px) {
  .su-master-card { grid-template-columns: 1fr; max-width: 500px; border-radius: 20px; }
  .su-photo-panel { min-height: 260px; padding: 28px 24px; }
  .su-form-panel { padding: 32px 24px; }
}

.su-name-college-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 4px;
}

@media (max-width: 480px) {
  .su-name-college-row {
    grid-template-columns: 1fr;
  }
}
</style>


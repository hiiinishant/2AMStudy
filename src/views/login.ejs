<%- include('partials/header') %>

<style>
/* 2 AM Study - Custom Split-Card Login Design */
:root {
  --auth-page-bg: #f1f5f9;
  --auth-card-bg: #ffffff;
  --auth-panel-bg: #f5f8ff;
  --auth-text-dark: #0f172a;
  --auth-text-muted: #475569;
  --auth-text-sub: #64748b;
  --auth-border: #e2e8f0;
  --auth-input-border: #cbd5e1;
  --auth-accent-blue: #2563eb;
  --auth-accent-blue-hover: #1d4ed8;
  --auth-btn-dark: #0f172a;
  --auth-btn-dark-hover: #1e293b;
}

body {
  background: var(--auth-page-bg) !important;
  min-height: 100vh;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  color: var(--auth-text-dark);
}

.auth-hero-section {
  min-height: calc(100vh - 80px);
  padding: 40px 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 10% 20%, rgba(37, 99, 235, 0.06) 0%, transparent 45%),
              radial-gradient(circle at 90% 80%, rgba(99, 102, 241, 0.08) 0%, transparent 50%),
              var(--auth-page-bg);
}

.auth-master-card {
  max-width: 990px;
  width: 100%;
  background: var(--auth-card-bg);
  border-radius: 28px;
  box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.12), 0 0 1px 1px rgba(0, 0, 0, 0.04);
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1.05fr;
  margin: 0 auto;
  border: 1px solid rgba(226, 232, 240, 0.8);
}

/* Left Photo Panel */
.auth-illustration-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  text-align: left;
  padding: 40px 36px;
  overflow: hidden;
  min-height: 520px;
}

.auth-panel-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  z-index: 0;
}

.auth-panel-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(15, 23, 42, 0.15) 0%,
    rgba(15, 23, 42, 0.35) 40%,
    rgba(15, 23, 42, 0.88) 100%
  );
  z-index: 1;
}

.auth-panel-content {
  position: relative;
  z-index: 2;
}

.auth-panel-title {
  font-size: 1.75rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 10px;
  letter-spacing: -0.02em;
  text-shadow: 0 2px 12px rgba(0,0,0,0.3);
}

.auth-panel-subtitle {
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.55;
  max-width: 300px;
  margin: 0 0 24px;
}

.auth-carousel-dots {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
}

.auth-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  transition: all 0.3s ease;
}

.auth-dot.active {
  width: 26px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.9);
}

/* Right Form Panel */
.auth-form-panel {
  padding: 52px 56px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: #ffffff;
}

.auth-brand-header {
  text-align: center;
  margin-bottom: 32px;
}

.auth-brand-logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 1.45rem;
  font-weight: 800;
  letter-spacing: -0.01em;
  color: var(--auth-text-dark);
  text-decoration: none;
}

.auth-brand-logo img {
  height: 38px;
  width: auto;
  border-radius: 8px;
}

.auth-brand-logo span {
  background: linear-gradient(135deg, #0f172a 30%, #2563eb 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.auth-form-label {
  font-size: 0.86rem;
  font-weight: 600;
  color: #334155;
  margin-bottom: 6px;
  display: block;
}

.auth-input-wrap {
  position: relative;
  margin-bottom: 18px;
}

.auth-input {
  width: 100%;
  padding: 12px 16px;
  background: #ffffff;
  border: 1.5px solid var(--auth-input-border);
  border-radius: 8px;
  font-size: 0.92rem;
  color: var(--auth-text-dark);
  transition: all 0.2s ease;
  outline: none;
}

.auth-input:focus {
  border-color: var(--auth-accent-blue);
  box-shadow: 0 0 0 3.5px rgba(37, 99, 235, 0.12);
}

.auth-input::placeholder {
  color: #94a3b8;
  font-size: 0.88rem;
}

.password-toggle-btn {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: #64748b;
  cursor: pointer;
  padding: 4px;
  font-size: 0.9rem;
}

.password-toggle-btn:hover {
  color: var(--auth-text-dark);
}

.forgot-password-link {
  font-size: 0.84rem;
  font-weight: 600;
  color: var(--auth-accent-blue);
  text-decoration: none;
  transition: color 0.2s ease;
}

.forgot-password-link:hover {
  color: var(--auth-accent-blue-hover);
  text-decoration: underline;
}

.btn-signin-primary {
  width: 100%;
  background: var(--auth-btn-dark);
  color: #ffffff;
  border: none;
  padding: 13px 20px;
  border-radius: 8px;
  font-size: 0.95rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-top: 10px;
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
}

.btn-signin-primary:hover {
  background: var(--auth-accent-blue);
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(37, 99, 235, 0.25);
}

.btn-signin-primary:disabled {
  opacity: 0.7;
  cursor: not-allowed;
  transform: none;
}

.auth-divider-wrap {
  display: flex;
  align-items: center;
  margin: 22px 0 20px;
}

.auth-divider-line {
  flex: 1;
  height: 1px;
  background: #e2e8f0;
}

.auth-divider-text {
  padding: 0 14px;
  font-size: 0.82rem;
  color: #94a3b8;
  font-weight: 500;
}

.btn-google-auth {
  width: 100%;
  background: #ffffff;
  border: 1.5px solid var(--auth-input-border);
  color: #334155;
  padding: 11px 20px;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.btn-google-auth:hover {
  background: #f8fafc;
  border-color: #94a3b8;
}

.auth-footer-prompt {
  text-align: center;
  margin-top: 26px;
  font-size: 0.86rem;
  color: #64748b;
}

.auth-signup-link {
  color: var(--auth-accent-blue);
  font-weight: 700;
  text-decoration: none;
  margin-left: 4px;
}

.auth-signup-link:hover {
  text-decoration: underline;
}

/* Alert Boxes */
.auth-alert {
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 0.85rem;
  margin-bottom: 18px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.auth-alert-danger {
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #b91c1c;
}

.auth-alert-success {
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  color: #15803d;
}

/* Responsive Breakpoints */
@media (max-width: 900px) {
  .auth-master-card {
    grid-template-columns: 1fr;
    max-width: 480px;
    border-radius: 20px;
  }
  .auth-illustration-panel {
    min-height: 280px;
    padding: 28px 24px;
  }
  .auth-panel-title {
    font-size: 1.4rem;
  }
  .auth-form-panel {
    padding: 36px 28px;
  }
}
</style>

<section class="auth-hero-section">
  <div class="auth-master-card">
    
    <!-- Left Photo Panel -->
    <div class="auth-illustration-panel">
      <!-- Full-cover hero photo -->
      <img
        src="/assets/images/login-hero.webp"
        alt="Confident 2 AM Study Student"
        class="auth-panel-photo"
        onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(135deg,#0f172a,#1e3a8a)';"
      >
      <!-- Dark gradient overlay -->
      <div class="auth-panel-overlay"></div>

      <!-- Text content at bottom -->
      <div class="auth-panel-content">
        <h2 class="auth-panel-title">2 AM Study</h2>
        <p class="auth-panel-subtitle">
          Meet Our Founder — <a href="https://hiiinishant.com" target="_blank" rel="noopener noreferrer" style="color: #ffffff; text-decoration: underline; text-underline-offset: 3px; font-weight: 700; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">Nishant Kumar</a>, driven by a vision to redefine how students learn, focus, grow, and turn ambition into achievement.
        </p>

        <div class="auth-carousel-dots">
          <span class="auth-dot"></span>
          <span class="auth-dot active"></span>
          <span class="auth-dot"></span>
          <span class="auth-dot"></span>
        </div>
      </div>
    </div>

    <!-- Right Login Form Panel -->
    <div class="auth-form-panel">
      
      <!-- Brand Logo Header -->
      <div class="auth-brand-header">
        <a href="/" class="auth-brand-logo">
          <img src="/assets/images/logo.jpg" alt="2 AM Study Logo" onerror="this.style.display='none';">
          <span>2 AM Study</span>
        </a>
      </div>

      <!-- Alert Banners -->
      <div id="auth-error-alert" class="auth-alert auth-alert-danger d-none">
        <i class="fa-solid fa-circle-exclamation text-danger"></i>
        <span id="auth-error-msg">Failed to log in. Please check your credentials.</span>
      </div>

      <!-- Bug 5 fix: Info alert shown when user navigates to /forgot-password directly -->
      <div id="auth-info-alert" class="auth-alert d-none" style="background:#eff6ff;border:1px solid #bfdbfe;color:#1d4ed8;">
        <i class="fa-solid fa-circle-info"></i>
        <span id="auth-info-msg">Enter your email address below, then click <strong>Forgot password?</strong> to receive a reset link.</span>
      </div>

      <div id="auth-success-alert" class="auth-alert auth-alert-success d-none">
        <i class="fa-solid fa-circle-check text-success"></i>
        <span id="auth-success-msg">Logged in successfully! Redirecting...</span>
      </div>

      <!-- Login Form -->
      <form id="loginForm" novalidate>
        <!-- Email Address -->
        <div class="mb-2">
          <label for="loginEmail" class="auth-form-label">Email address</label>
          <div class="auth-input-wrap">
            <input type="email" class="auth-input" id="loginEmail" placeholder="student@university.edu" required autocomplete="email">
          </div>
        </div>

        <!-- Password -->
        <div class="mb-1">

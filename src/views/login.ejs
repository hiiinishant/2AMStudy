      <!-- Google Sign-In Button -->
      <button type="button" id="googleSignInBtn" class="btn-google-auth">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z" fill="#4285F4"/>
          <path d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.26v3.15C3.25 21.3 7.31 24 12 24z" fill="#34A853"/>
          <path d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.26C.46 8.17 0 10.03 0 12s.46 3.83 1.26 5.42l4.02-3.15z" fill="#FBBC05"/>
          <path d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.25 2.7 1.26 6.58l4.02 3.15c.95-2.83 3.6-4.98 6.72-4.98z" fill="#EA4335"/>
        </svg>
        <span>Login with Google</span>
      </button>

      <!-- Footer Account Prompt -->
      <div class="auth-footer-prompt">
        <span>Are you new?</span>
        <a href="/signup" id="toSignupLink" class="auth-signup-link">Create an Account</a>
      </div>

    </div>

  </div>
</section>

<!-- Firebase Auth Handler Script -->
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-app.js";
  import { 
    getAuth, 
    signInWithEmailAndPassword, 
    GoogleAuthProvider, 
    signInWithPopup, 
    sendPasswordResetEmail,
    setPersistence,
    browserLocalPersistence,
    browserSessionPersistence,
    onAuthStateChanged
  } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-auth.js";
  import { getFirestore, doc, getDoc, setDoc, updateDoc, serverTimestamp, collection, query, where, getDocs } from "https://www.gstatic.com/firebasejs/12.12.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyCvJRS3UusvUrVCd2JSicBGL-uRD82GpNM",
    authDomain: "am-study-7ea87.firebaseapp.com",
    projectId: "am-study-7ea87",
    storageBucket: "am-study-7ea87.firebasestorage.app",
    messagingSenderId: "270924691236",
    appId: "1:270924691236:web:7ada12dcf50c290d0925b1"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);

  const errorAlert = document.getElementById('auth-error-alert');
  const errorMsg = document.getElementById('auth-error-msg');
  const successAlert = document.getElementById('auth-success-alert');
  const loginForm = document.getElementById('loginForm');
  const submitBtn = document.getElementById('loginSubmitBtn');
  const googleBtn = document.getElementById('googleSignInBtn');
  const forgotBtn = document.getElementById('forgotPasswordBtn');
  const rememberMeCheck = document.getElementById('rememberMe');
  const passwordInput = document.getElementById('loginPassword');
  const passwordToggleBtn = document.getElementById('passwordToggleBtn');
  const passwordEyeIcon = document.getElementById('passwordEyeIcon');

  // Password visibility toggle
  if (passwordToggleBtn && passwordInput) {
    passwordToggleBtn.addEventListener('click', () => {
      const isPass = passwordInput.getAttribute('type') === 'password';
      passwordInput.setAttribute('type', isPass ? 'text' : 'password');
      passwordEyeIcon.className = isPass ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
    });
  }

  // Safe redirect helper — rejects external URLs, only allows relative paths starting with /
  function safeRedirect(param, fallback = '/student-safety/my-reports') {
    if (!param) return fallback;
    try {
      if (/^https?:\/\//i.test(param) || /^\/\//i.test(param) || !param.startsWith('/')) {
        return fallback;
      }
      return param;
    } catch(e) { return fallback; }
  }

  const rawRedirect = new URLSearchParams(window.location.search).get('redirect');
  const safeRedirectUrl = safeRedirect(rawRedirect);

  // Preserve safe redirect on Sign Up link
  if (rawRedirect && safeRedirectUrl !== '/student-safety/my-reports') {
    const toSignup = document.getElementById('toSignupLink');
    if (toSignup) toSignup.href = '/signup?redirect=' + encodeURIComponent(safeRedirectUrl);
  }

  // Bug 5 fix: Show helpful info alert when user is redirected from /forgot-password URL
  const resetPrompt = new URLSearchParams(window.location.search).get('resetprompt');
  if (resetPrompt === '1') {
    const infoAlert = document.getElementById('auth-info-alert');
    if (infoAlert) infoAlert.classList.remove('d-none');
  }

  // Instant redirect if already logged in locally
  const isAlreadyLoggedIn = localStorage.getItem('isLoggedIn') === 'true' || localStorage.getItem('studentRegistered') === 'true';
  if (isAlreadyLoggedIn) {
    window.location.href = safeRedirectUrl;
  }

  // Check if already logged in via Firebase Auth source of truth
  onAuthStateChanged(auth, (user) => {
    if (user && !successAlert.classList.contains('redirecting')) {
      window.location.href = safeRedirectUrl;
    }
  });

  // Upsert user doc in Firestore
  const saveUserToFirestore = async (user) => {
    try {
      const userRef = doc(db, "users", user.uid);
      const userSnap = await getDoc(userRef);

      if (!userSnap.exists()) {
        await setDoc(userRef, {
          uid: user.uid,
          displayName: user.displayName || user.email.split('@')[0],
          email: user.email,
          photoURL: user.photoURL || '',
          college: '',
          role: 'student',
          emailVerified: user.emailVerified,
          trustScore: 10,
          badges: ['student_protector'],
          reportsSubmitted: 0,
          reportsSupported: 0,
          status: 'active',
          createdAt: serverTimestamp(),
          lastLoginAt: serverTimestamp()
        });
      } else {
        await updateDoc(userRef, {
          emailVerified: user.emailVerified,
          lastLoginAt: serverTimestamp()
        });
      }
    } catch (e) {
      console.warn("Firestore user sync warning:", e);
    }
  };

  // Sync session details to localStorage UI cache
  const syncLocalCache = (user) => {
    localStorage.setItem('isLoggedIn', 'true');
    localStorage.setItem('user_id', user.uid);
    localStorage.setItem('studentEmail', user.email || '');
    localStorage.setItem('studentName', user.displayName || user.email.split('@')[0]);
    localStorage.setItem('studentRegistered', 'true');
  };

  // Email/Password Login
  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    e.stopPropagation();

    errorAlert.classList.add('d-none');
    successAlert.classList.add('d-none');

    const email = document.getElementById('loginEmail').value.trim();
    const password = document.getElementById('loginPassword').value;

    if (!email || !password) {
      errorAlert.classList.remove('d-none');
      errorMsg.textContent = 'Please enter both your email/username and password.';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Logging in...`;

    try {
      const persistence = rememberMeCheck && rememberMeCheck.checked ? browserLocalPersistence : browserSessionPersistence;
      await setPersistence(auth, persistence);

      const userCredential = await signInWithEmailAndPassword(auth, email, password);
      const user = userCredential.user;

      syncLocalCache(user);
      await saveUserToFirestore(user);

      successAlert.classList.add('redirecting');
      document.getElementById('auth-success-msg').textContent = 'Logged in successfully! Redirecting...';
      successAlert.classList.remove('d-none');

      setTimeout(() => {
        window.location.href = safeRedirectUrl;
      }, 800);

    } catch (err) {
      console.error("Login error:", err);
      errorAlert.classList.remove('d-none');
      if (err.code === 'auth/invalid-credential' || err.code === 'auth/wrong-password' || err.code === 'auth/user-not-found') {
        errorMsg.textContent = 'Invalid email or password. Please check your credentials.';
      } else if (err.code === 'auth/too-many-requests') {
        errorMsg.textContent = 'Too many failed login attempts. Please try again later.';
      } else {
        errorMsg.textContent = err.message || 'An error occurred during login.';
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = 'Login';
    }
  });

  // Google Sign-In
  googleBtn.addEventListener('click', async () => {
    errorAlert.classList.add('d-none');
    const provider = new GoogleAuthProvider();

    try {
      const persistence = rememberMeCheck && rememberMeCheck.checked ? browserLocalPersistence : browserSessionPersistence;
      await setPersistence(auth, persistence);

      const result = await signInWithPopup(auth, provider);
      const user = result.user;

      syncLocalCache(user);
      await saveUserToFirestore(user);

      successAlert.classList.add('redirecting');
      document.getElementById('auth-success-msg').textContent = 'Logged in successfully! Redirecting...';
      successAlert.classList.remove('d-none');

      setTimeout(() => {
        window.location.href = safeRedirectUrl;
      }, 800);

    } catch (err) {
      console.error("Google auth error:", err);
      if (err.code !== 'auth/popup-closed-by-user') {
        errorAlert.classList.remove('d-none');
        errorMsg.textContent = err.message || 'Google login failed.';
      }
    }
  });

  // Forgot Password
  forgotBtn.addEventListener('click', async (e) => {
    e.preventDefault();
    errorAlert.classList.add('d-none');
    successAlert.classList.add('d-none');

    const email = document.getElementById('loginEmail').value.trim();
    if (!email) {
      errorAlert.classList.remove('d-none');
      errorMsg.textContent = 'Please enter your email address in the field above first, then click Forgot password.';
      document.getElementById('loginEmail').focus();
      return;
    }

    // Validate email format client-side before calling Firebase
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      errorAlert.classList.remove('d-none');
      errorMsg.textContent = 'Please enter a valid email address (e.g. student@university.edu).';
      document.getElementById('loginEmail').focus();
      return;
    }

    try {
      // Check Firestore first — Firebase silently succeeds for non-existent emails (privacy by design)
      // so we do our own check against the users collection before sending the reset email
      const usersRef = collection(db, 'users');
      const emailQuery = query(usersRef, where('email', '==', email));
      const emailSnap = await getDocs(emailQuery);

      if (emailSnap.empty) {
        // No account registered with this email — block the reset
        errorAlert.classList.remove('d-none');
        errorMsg.textContent = 'No account found with this email address. Please check and try again.';
        return;
      }

      // Account exists — safe to send reset email
      await sendPasswordResetEmail(auth, email);
      document.getElementById('auth-success-msg').textContent = `Password reset link sent to ${email}. Please check your inbox.`;
      successAlert.classList.remove('d-none');
    } catch (err) {
      errorAlert.classList.remove('d-none');
      if (err.code === 'auth/invalid-email') {
        errorMsg.textContent = 'Please enter a valid email address.';
      } else if (err.code === 'auth/too-many-requests') {
        errorMsg.textContent = 'Too many requests. Please wait a moment before trying again.';
      } else {
        errorMsg.textContent = err.message || 'Could not send password reset email.';
      }
    }
  });
</script>


<%- include('partials/header') %>

  <style>
    /* ── Page Layout ── */
    .pomo-page {
      background: #f8fafc;
      min-height: 100vh;
      padding-top: 40px;
      padding-bottom: 80px;
      color: #0f172a;
    }

    /* Ambient background glow */
    .pomo-ambient-glow {
      position: absolute;
      top: 60px;
      left: 50%;
      transform: translateX(-50%);
      width: 700px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(ellipse, rgba(99, 102, 241, 0.08) 0%, rgba(220, 38, 38, 0.04) 50%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    /* ── Clean Brand Card Container ── */
    .pomo-glass-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1.5rem;
      box-shadow: 0 12px 35px rgba(15, 23, 42, 0.05);
      position: relative;
      overflow: hidden;
    }

    .pomo-glass-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, #4f46e5, #dc2626, transparent);
    }

    /* ── Segmented Layout Controls ── */
    .pomo-segmented-ctrl {
      background: #f1f5f9;
      border: 1px solid #e2e8f0;
      border-radius: 999px;
      padding: 4px;
      display: inline-flex;
      gap: 4px;
    }

    .pomo-segmented-btn {
      border: none;
      background: transparent;
      color: #64748b;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 5px 13px;
      border-radius: 999px;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .pomo-segmented-btn:hover {
      color: #0f172a;
      background: rgba(0, 0, 0, 0.04);
    }

    .pomo-segmented-btn.active {
      background: #0f172a;
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.2);
    }

    /* ── Mode Switcher Pills ── */
    .pomo-mode-pill {
      font-weight: 700;
      font-size: 0.88rem;
      padding: 8px 18px;
      border-radius: 999px;
      transition: all 0.2s ease;
    }

    .pomo-mode-pill:hover {
      transform: translateY(-1px);
    }

    /* ── Main Timer Display ── */
    .pomo-ring {
      width: 260px;
      height: 260px;
      border-radius: 50%;
      background: conic-gradient(#4f46e5 0deg, #e2e8f0 0deg);
      display: grid;
      place-items: center;
      box-shadow: 0 10px 40px rgba(79, 70, 229, 0.15);
      transition: background 0.4s ease;
      margin: 0 auto;
    }

    .pomo-ring-inner {
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: #0f172a;
      display: grid;
      place-items: center;
      border: 4px solid #ffffff;
      box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.3);
    }

    .pomo-time {
      font-size: 3.6rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      color: #ffffff;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      line-height: 1;
    }

    .pomo-mode-badge {
      font-size: 0.78rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      font-weight: 700;
      margin-top: 4px;
    }

    /* Quick Preset Pills */
    .preset-pill {
      background: #f1f5f9;
      border: 1px solid #e2e8f0;
      color: #475569;
      font-size: 0.78rem;
      font-weight: 600;
      padding: 5px 14px;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .preset-pill:hover {
      background: rgba(99, 102, 241, 0.1);
      border-color: #c7d2fe;
      color: #4f46e5;
      transform: translateY(-1px);
    }

    /* ── Main Action Buttons ── */
    .pomo-action-btn {
      min-width: 125px;
      font-weight: 700;
      border-radius: 999px;
      padding: 11px 24px;
      font-size: 0.95rem;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .pomo-action-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    /* ── Stat Cards ── */
    .stat-card-modern {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 1rem;
      padding: 1rem;
      color: #0f172a;
      text-align: center;
      transition: all 0.2s ease;
    }

    .stat-card-modern:hover {
      background: #ffffff;
      border-color: rgba(99, 102, 241, 0.35);
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
      transform: translateY(-2px);
    }

    .stat-card-modern .stat-val {
      font-size: 1.6rem;
      font-weight: 800;
      line-height: 1.2;
    }

    .stat-card-modern .stat-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #64748b;
      margin-top: 4px;
      font-weight: 600;
    }

    /* ── Sound & Settings Panel ── */
    .pomo-settings-panel {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 1.25rem;
      padding: 1.25rem;
    }

    .pomo-settings-panel select,
    .pomo-settings-panel input[type=number] {
      background: #ffffff;
      color: #0f172a;
      border-color: #cbd5e1;
    }

    .pomo-settings-panel select option {
      background: #ffffff;
      color: #0f172a;
    }

    /* ── Session Log ── */
    .session-log-box {
      max-height: 190px;
      overflow-y: auto;
      padding-right: 4px;
    }

    .session-log-box::-webkit-scrollbar {
      width: 4px;
    }

    .session-log-box::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.15);
      border-radius: 4px;
    }

    .log-item {
      font-size: 0.82rem;
      padding: 0.5rem 0.8rem;
      border-radius: 0.6rem;
      margin-bottom: 6px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #ffffff;
      border: 1px solid #e2e8f0;
    }

    /* ── Fullscreen Override ── */
    #pomoTimerCard:fullscreen {
      background-color: #090d16 !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100vw !important;
      height: 100vh !important;
      padding: 2rem !important;
      border: none !important;
    }

    #pomoTimerCard:fullscreen .pomo-time {
      color: #ffffff !important;
    }

    #pomoTimerCard:fullscreen .pomo-mode-badge {
      font-size: min(2.5vw, 2.5vh) !important;
    }

    /* Fullscreen: Circular Layout */
    #pomoTimerCard:fullscreen.layout-circular .pomo-ring {
      width: min(75vw, 75vh) !important;
      height: min(75vw, 75vh) !important;
      display: grid !important;
      place-items: center !important;
      margin: 0 auto !important;
      box-shadow: 0 0 100px rgba(99, 102, 241, 0.4) !important;
    }

    #pomoTimerCard:fullscreen.layout-circular .pomo-ring-inner {
      width: calc(100% - 30px) !important;
      height: calc(100% - 30px) !important;
      border-radius: 50% !important;
      display: grid !important;
      place-items: center !important;
      background: #0f172a !important;
      border: 4px solid #ffffff !important;
    }

    #pomoTimerCard:fullscreen.layout-circular .pomo-time {
      font-size: min(15vw, 15vh) !important;
    }

    /* Fullscreen: Rectangular Layout */
    #pomoTimerCard:fullscreen.layout-rectangular .pomo-ring {
      width: min(85vw, 850px) !important;
      height: auto !important;
      display: block !important;
      background: #0f172a !important;
      padding: 3rem 2rem !important;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6) !important;
    }

    #pomoTimerCard:fullscreen.layout-rectangular .pomo-ring-inner {
      width: 100% !important;
      height: auto !important;
      background: transparent !important;
      border: none !important;
      display: block !important;
    }

    #pomoTimerCard:fullscreen.layout-rectangular .pomo-time {
      font-size: min(14vw, 14vh) !important;
    }

    /* Fullscreen: Minimal Layout */
    #pomoTimerCard:fullscreen.layout-minimal .pomo-ring {
      width: auto !important;
      height: auto !important;
      background: transparent !important;
      box-shadow: none !important;
      display: block !important;
    }

    #pomoTimerCard:fullscreen.layout-minimal .pomo-ring-inner {
      width: auto !important;
      height: auto !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      display: block !important;
    }

    #pomoTimerCard:fullscreen.layout-minimal .pomo-time {
      font-size: min(22vw, 22vh) !important;
      color: #ffffff !important;
      font-weight: 200 !important;
      letter-spacing: -0.04em !important;
      line-height: 1 !important;
    }

    #pomoTimerCard:fullscreen.layout-minimal .minimal-progress-line {
      width: min(60vw, 450px) !important;
      background: rgba(255, 255, 255, 0.15) !important;
      margin-top: 2rem !important;
    }

    #pomoTimerCard:fullscreen.layout-minimal .minimal-progress-fill {
      background: #818cf8 !important;
      box-shadow: 0 0 16px rgba(129, 140, 248, 0.8) !important;
    }

    /* Layout specific base styling */
    .layout-rectangular .pomo-ring {
      width: 100%;
      height: auto;
      border-radius: 1.25rem;
      background: #0f172a !important;
      padding: 2.5rem 1.5rem;
      display: block;
      border: 1px solid #334155;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
    }

    .layout-rectangular .pomo-ring-inner {
      width: 100%;
      height: auto;
      background: transparent;
      display: block;
      border: none;
      box-shadow: none;
    }

    .layout-rectangular .pomo-time {
      font-size: 5rem;
      line-height: 1;
      font-weight: 800;
      color: #ffffff;
    }

    .layout-rectangular .progress-bar-container {
      height: 10px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 999px;
      margin-top: 1.75rem;
      overflow: hidden;
    }

    .layout-rectangular .progress-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #4f46e5, #38bdf8);
      transition: width 0.3s ease;
      box-shadow: 0 0 12px rgba(99, 102, 241, 0.6);
    }

    .layout-minimal .pomo-ring,
    .layout-minimal .pomo-ring-inner {
      background: transparent !important;
      box-shadow: none !important;
      height: auto;
      width: auto;
      border: none;
    }

    .layout-minimal .pomo-time {
      font-size: 6.5rem;
      font-weight: 300;
      color: #0f172a;
      letter-spacing: -0.04em;
    }

    .layout-minimal .minimal-progress-line {
      height: 3px;
      width: 240px;
      background: #e2e8f0;
      margin: 1.5rem auto 0;
      position: relative;
      overflow: hidden;
      border-radius: 99px;
    }

    .layout-minimal .minimal-progress-fill {
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      background: #4f46e5;
      transition: width 0.3s ease;
    }
  </style>

  <main class="pomo-page position-relative" id="pomoPage">
    <div class="pomo-ambient-glow"></div>

    <div class="container position-relative" style="max-width: 960px; z-index: 1;">

      <!-- Header Section -->
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2 border" style="background: rgba(99, 102, 241, 0.08); border-color: rgba(99, 102, 241, 0.25) !important;">
          <i class="fa-solid fa-bolt text-danger small"></i>
          <span class="small fw-semibold" style="color: #4338ca;">Smart Pomodoro Study Engine</span>
        </div>
        <h1 class="fw-bold mb-1" style="color: #0f172a; font-size: clamp(1.6rem, 3.5vw, 2.2rem); letter-spacing: -0.02em;">
          <i class="fa-solid fa-stopwatch me-2 text-danger"></i>Online Pomodoro Focus Timer
        </h1>
        <p class="small mb-0" id="pomo-subtitle" style="color: #64748b; max-width: 540px; margin: 0 auto; font-size: 0.94rem;">
          Boost concentration, track study streaks, and conquer exam goals with rhythmic focus intervals.
        </p>
      </div>

      <!-- Live Session Notification Banner -->
      <div id="pomoBanner" class="alert text-center fw-semibold mb-4 d-none shadow-sm rounded-4" role="alert"></div>

      <!-- ── HERO TIMER STAGE ── -->
      <div class="pomo-glass-card p-4 p-md-5 mb-4 text-center">

        <!-- Top Stage Bar (Modes & Layout Controls) -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
          <!-- Mode Switcher -->
          <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary btn-sm pomo-mode-pill" id="btnModeStudy" onclick="setPomoMode('study')">
              📚 Study Mode
            </button>
            <button class="btn btn-outline-warning btn-sm pomo-mode-pill" id="btnModeBreak" onclick="setPomoMode('break')">
              ☕ Break Time
            </button>
          </div>

          <!-- Layout & Fullscreen -->
          <div class="d-flex align-items-center gap-2 ms-auto">
            <!-- Layout Switcher Tabs -->
            <div class="pomo-segmented-ctrl no-print">
              <button class="pomo-segmented-btn" id="layoutBtnCircular" onclick="setTimerLayout('circular')">⭕ Circle</button>
              <button class="pomo-segmented-btn" id="layoutBtnRectangular" onclick="setTimerLayout('rectangular')">▭ Bar</button>
              <button class="pomo-segmented-btn" id="layoutBtnMinimal" onclick="setTimerLayout('minimal')">✨ Minimal</button>
            </div>

            <!-- Fullscreen Trigger -->
            <button id="btnFullscreen" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1.5 fw-semibold" onclick="toggleFullscreen()" title="Toggle Fullscreen Focus">
              <i class="fa-solid fa-expand me-1"></i> Fullscreen
            </button>
          </div>
        </div>

        <!-- Timer Centerpiece -->
        <div id="pomoTimerCard" class="text-center my-3 layout-circular">
          <div class="pomo-ring" id="pomoRing">
            <div class="pomo-ring-inner">
              <div class="timer-content-wrapper">
                <div class="pomo-time"><span id="pomoMin">25</span>:<span id="pomoSec">00</span></div>
                <div class="pomo-mode-badge-container d-flex flex-column align-items-center gap-1">
                  <div class="pomo-mode-badge" id="pomoModeBadge" style="color:#818cf8;">STUDY</div>
                  <div id="pomoSessionBadge" class="pomo-mode-badge d-none" style="color:#38bdf8; font-weight:700;">SESSION #1</div>
                </div>

                <!-- Rectangular Progress -->
                <div class="progress-bar-container d-none" id="rectProgress">
                  <div class="progress-bar-fill" id="rectFill" style="width: 0%"></div>
                </div>

                <!-- Minimal Progress -->
                <div class="minimal-progress-line d-none" id="minProgress">
                  <div class="minimal-progress-fill" id="minFill" style="width: 0%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Interval Presets -->
        <div class="d-flex justify-content-center flex-wrap gap-2 my-3">
          <span class="preset-pill" onclick="applyPreset(15, 3)">⚡ 15m Sprint</span>
          <span class="preset-pill" onclick="applyPreset(25, 5)">🎯 25m Classic</span>
          <span class="preset-pill" onclick="applyPreset(45, 10)">🧠 45m Deep Work</span>
          <span class="preset-pill" onclick="applyPreset(60, 15)">🔥 60m Marathon</span>
        </div>

        <!-- Primary Control Action Buttons -->
        <div class="d-flex justify-content-center flex-wrap gap-3 mt-4">
          <button id="btnStart" class="btn btn-success pomo-action-btn" onclick="startPomo()">
            <i class="fa-solid fa-play"></i> Start
          </button>
          <button id="btnPause" class="btn btn-warning text-dark pomo-action-btn" onclick="pausePomo()" disabled>
            <i class="fa-solid fa-pause"></i> Pause
          </button>
          <button id="btnStop" class="btn btn-outline-danger pomo-action-btn" onclick="stopPomo()">
            <i class="fa-solid fa-rotate-right"></i> Reset
          </button>
        </div>

      </div>
    </div>
  </main>

  <!-- ─────────────── Script ─────────────── -->
  <script>
    (function () {
      // ── State ──
      let mode = 'study';   // 'study' | 'break'
      let studySec = 25 * 60;
      let breakSec = 5 * 60;
      let remaining = studySec;
      let interval = null;
      let isRunning = false;
      let alertCtx = null;
      let currentLayout = localStorage.getItem('pomoTimerLayout') || 'circular';
      let wakeLock = null;

      // ── Screen Wake Lock ──
      async function requestWakeLock() {
        if ('wakeLock' in navigator) {
          try {
            wakeLock = await navigator.wakeLock.request('screen');
          } catch (err) {
            console.error(`${err.name}, ${err.message}`);
          }
        }
      }

      function releaseWakeLock() {
        if (wakeLock !== null) {
          wakeLock.release().then(() => { wakeLock = null; });
        }
      }

      document.addEventListener('visibilitychange', async () => {
        if (wakeLock !== null && document.visibilityState === 'visible' && isRunning) {
          await requestWakeLock();
        }
      });

      // ── Layout Switcher ──
      window.setTimerLayout = function (layout) {
        currentLayout = layout;
        localStorage.setItem('pomoTimerLayout', layout);
        const card = document.getElementById('pomoTimerCard');
        if (!card) return;

        card.classList.remove('layout-circular', 'layout-rectangular', 'layout-minimal');
        card.classList.add(`layout-${layout}`);

        // Update active class on segmented buttons
        document.getElementById('layoutBtnCircular')?.classList.toggle('active', layout === 'circular');
        document.getElementById('layoutBtnRectangular')?.classList.toggle('active', layout === 'rectangular');
        document.getElementById('layoutBtnMinimal')?.classList.toggle('active', layout === 'minimal');

        // Toggle visibility of specific progress elements
        document.getElementById('rectProgress')?.classList.toggle('d-none', layout !== 'rectangular');
        document.getElementById('minProgress')?.classList.toggle('d-none', layout !== 'minimal');

        updateDisplay();
      };

      // ── Preset Applier ──
      window.applyPreset = function (studyM, breakM) {
        if (isRunning) return;
        studySec = studyM * 60;
        breakSec = breakM * 60;
        remaining = mode === 'study' ? studySec : breakSec;
        updateDisplay();
      };

      // Tracked totals (seconds)
      let totalStudySec = parseInt(localStorage.getItem('PomTotalStudy') || '0', 10);
      let totalBreakSec = parseInt(localStorage.getItem('PomTotalBreak') || '0', 10);
      let totalSessions = parseInt(localStorage.getItem('PomSessions') || '0', 10);
      let sessionStartTs = null;

      // ── Audio Context ──
      const getCtx = () => {
        if (!window._pomoAudioCtx) window._pomoAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
        return window._pomoAudioCtx;
      };

      // Sound alerts: Study Complete (Crisp Bell/Chime) & Break Complete (Deep Resonant Gong)
      function playStudyAlertSound(ctx) {
        // Crisp high-energy 4-note bell chime (880Hz -> 1046Hz -> 1318Hz -> 1760Hz)
        [[880, 0], [1046, 0.18], [1318, 0.36], [1760, 0.54]].forEach(([f, d]) => {
          const osc = ctx.createOscillator(), g = ctx.createGain();
          osc.connect(g); g.connect(ctx.destination);
          osc.type = 'sine'; osc.frequency.value = f;
          const t = ctx.currentTime + d;
          g.gain.setValueAtTime(0, t);
          g.gain.linearRampToValueAtTime(0.4, t + 0.03);
          g.gain.exponentialRampToValueAtTime(0.001, t + 1.2);
          osc.start(t); osc.stop(t + 1.3);
        });
      }

      function playBreakDeepSound(ctx) {
        // Deep rich low-frequency resonant soundwave (110Hz + 82Hz sub-bass harmonic)
        [110, 82, 164].forEach((f, i) => {
          const osc = ctx.createOscillator(), g = ctx.createGain();
          osc.connect(g); g.connect(ctx.destination);
          osc.type = 'sine'; osc.frequency.value = f;
          const t = ctx.currentTime;
          g.gain.setValueAtTime(0.5 / (i + 1), t);
          g.gain.exponentialRampToValueAtTime(0.0001, t + 3.5);
          osc.start(t); osc.stop(t + 3.6);
        });
      }

      function playAlert() {
        const ctx = getCtx();
        if (ctx.state === 'suspended') ctx.resume();

        if (mode === 'study') {
          playStudyAlertSound(ctx);
        } else {
          playBreakDeepSound(ctx);
        }

        // Play repeat after 2.5s for clear notice
        alertCtx = ctx;
        setTimeout(() => {
          if (!alertCtx) return;
          if (mode === 'study') playStudyAlertSound(ctx);
          else playBreakDeepSound(ctx);
        }, 2500);
      }

      function stopAlert() {
        alertCtx = null;
      }

      // ── Display ──
      function fmt2(n) { return String(n).padStart(2, '0'); }

      function updateDisplay() {
        const m = Math.floor(remaining / 60), s = remaining % 60;
        document.getElementById('pomoMin').textContent = fmt2(m);
        document.getElementById('pomoSec').textContent = fmt2(s);
        updateRing();
      }

      function updateRing() {
        const total = mode === 'study' ? studySec : breakSec;
        const elapsed = Math.max(0, total - remaining);
        const deg = total > 0 ? Math.min(360, (elapsed / total) * 360) : 0;
        const color = mode === 'study' ? '#4f46e5' : '#f59e0b';
        document.getElementById('pomoRing').style.background =
          `conic-gradient(${color} ${deg}deg, #e2e8f0 ${deg}deg)`;

        // Update alternative progress bars
        const pct = total > 0 ? (elapsed / total) * 100 : 0;
        const rectFill = document.getElementById('rectFill');
        const minFill = document.getElementById('minFill');
        if (rectFill) rectFill.style.width = pct + '%';
        if (minFill) minFill.style.width = pct + '%';
      }

      function setBanner(msg, type) {
        const b = document.getElementById('pomoBanner');
        if (!b) return;
        b.className = `alert alert-${type} text-center fw-semibold mb-4`;
        b.textContent = msg;
        b.classList.remove('d-none');
      }
      function hideBanner() { document.getElementById('pomoBanner')?.classList.add('d-none'); }

      // ── Mode Switcher ──
      window.setPomoMode = function (m) {
        if (isRunning) return;
        mode = m;
        remaining = m === 'study' ? studySec : breakSec;
        const badge = document.getElementById('pomoModeBadge');
        if (badge) {
          badge.textContent = m.toUpperCase();
          badge.style.color = m === 'study' ? '#818cf8' : '#fbbf24';
        }
        document.getElementById('btnModeStudy').className = `btn btn-sm pomo-mode-pill ${m === 'study' ? 'btn-primary' : 'btn-outline-primary'}`;
        document.getElementById('btnModeBreak').className = `btn btn-sm pomo-mode-pill ${m === 'break' ? 'btn-warning text-dark' : 'btn-outline-warning'}`;
        updateDisplay();
        hideBanner();
      };

      // ── Controls ──
      window.startPomo = function () {
        if (isRunning) return;
        const ctx = getCtx();
        if (ctx.state === 'suspended') ctx.resume();

        isRunning = true;
        sessionStartTs = Date.now();
        requestWakeLock();
        document.getElementById('btnStart').disabled = true;
        document.getElementById('btnPause').disabled = false;
        setBanner(`${mode === 'study' ? '📚 Study' : '☕ Break'} session started — stay focused!`, mode === 'study' ? 'primary' : 'warning');

        interval = setInterval(() => {
          if (remaining > 0) {
            remaining--;
            updateDisplay();
            accumulateLive();
          } else {
            onSessionComplete();
          }
        }, 1000);
      };

      window.pausePomo = function () {
        if (!isRunning) return;
        clearInterval(interval); interval = null;
        isRunning = false;
        releaseWakeLock();
        document.getElementById('btnStart').disabled = false;
        document.getElementById('btnPause').disabled = true;
        saveElapsed();
        setBanner('⏸ Paused — resume when you\'re ready.', 'secondary');
      };

      window.stopPomo = function () {
        stopAlert();
        if (interval) { clearInterval(interval); interval = null; }
        if (isRunning) {
          saveElapsed();
          releaseWakeLock();
        }
        isRunning = false;
        remaining = mode === 'study' ? studySec : breakSec;
        document.getElementById('btnStart').disabled = false;
        document.getElementById('btnPause').disabled = true;
        updateDisplay();
        hideBanner();
      };

      // ── Session complete ──
      function onSessionComplete() {
        clearInterval(interval); interval = null;
        isRunning = false;
        releaseWakeLock();
        document.getElementById('btnStart').disabled = false;
        document.getElementById('btnPause').disabled = true;

        const elapsed = mode === 'study' ? studySec : breakSec;
        if (mode === 'study') {
          totalStudySec += elapsed;
          totalSessions++;
          localStorage.setItem('PomSessions', totalSessions);
          localStorage.setItem('PomTotalStudy', totalStudySec);
        } else {
          totalBreakSec += elapsed;
          localStorage.setItem('PomTotalBreak', totalBreakSec);
        }
        sessionStartTs = null;

        playAlert();

        const currentMode = mode;
        const msg = currentMode === 'study'
          ? `🎉 Study session complete! Time for a break!`
          : `✅ Break done! Ready for the next focus sprint?`;
        setBanner(msg, currentMode === 'study' ? 'success' : 'info');

        const next = currentMode === 'study' ? 'break' : 'study';
        setTimeout(() => setPomoMode(next), 1200);
      }

      function accumulateLive() {
        if (!sessionStartTs) return;
        const live = Math.floor((Date.now() - sessionStartTs) / 1000);
        if (mode === 'study') {
          localStorage.setItem('PomTotalStudy', totalStudySec + live);
        }
      }

      function saveElapsed() {
        if (!sessionStartTs) return;
        const elapsed = Math.floor((Date.now() - sessionStartTs) / 1000);
        if (mode === 'study') {
          totalStudySec += elapsed;
          localStorage.setItem('PomTotalStudy', totalStudySec);
        } else {
          totalBreakSec += elapsed;
          localStorage.setItem('PomTotalBreak', totalBreakSec);
        }
        sessionStartTs = null;
      }

      // ── Fullscreen ──
      window.toggleFullscreen = function () {
        const card = document.getElementById('pomoTimerCard');
        if (!document.fullscreenElement) {
          card.requestFullscreen?.().catch(() => { });
        } else {
          document.exitFullscreen?.().catch(() => { });
        }
      };
      document.addEventListener('fullscreenchange', () => {
        const fs = !!document.fullscreenElement;
        const btn = document.getElementById('btnFullscreen');
        if (btn) {
          btn.innerHTML = `<i class="fa-solid fa-${fs ? 'compress' : 'expand'} me-1"></i>${fs ? 'Exit' : 'Fullscreen'}`;
        }
      });

      // ── Init ──
      updateDisplay();
      setPomoMode('study');
      setTimerLayout(currentLayout);
    })();
  </script>

  <%- include('partials/footer') %>